# 🚀 Ruangtunggu Web (Frontend) Environment Variables
# Salin file ini menjadi '.env' untuk konfigurasi lokal

# URL Backend API (Default port development backend adalah 3000)
PUBLIC_API_URL=http://localhost:3000

# Kunci Site Key Cloudflare Turnstile (Opsional, hanya aktif di mode PROD)
# Jika tidak diisi, widget Turnstile tidak akan dimuat.
PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
