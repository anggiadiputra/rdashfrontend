---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Atur Ulang Kata Sandi">
  <section class="auth-section section">
    <div class="container auth-container">
      <div class="card auth-card">
        
        <!-- Header -->
        <div class="auth-header text-center mb-4">
          <h2>Atur Ulang Kata Sandi</h2>
          <p class="text-secondary mt-1">Masukkan kata sandi baru Anda di bawah ini.</p>
        </div>

        <!-- Alert Box -->
        <div id="alert-box" class="alert hidden"></div>

        <!-- Reset Password Form -->
        <form id="reset-form" class="auth-form">
          <div class="form-group">
            <label class="form-label" for="password">Kata Sandi Baru</label>
            <div class="password-wrapper">
              <input type="password" id="password" class="form-control" placeholder="••••••••" required minlength="6" />
              <button type="button" class="toggle-password-btn" aria-label="Lihat kata sandi" tabindex="-1">
                <svg class="lucide lucide-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="confirm-password">Konfirmasi Kata Sandi Baru</label>
            <div class="password-wrapper">
              <input type="password" id="confirm-password" class="form-control" placeholder="••••••••" required minlength="6" />
              <button type="button" class="toggle-password-btn" aria-label="Lihat kata sandi" tabindex="-1">
                <svg class="lucide lucide-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          {import.meta.env.PROD && import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
            <div class="form-group mt-4 flex justify-center">
              <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-theme="auto" data-callback="onTurnstileSuccess"></div>
            </div>
          )}

          <button type="submit" id="submit-btn" class="btn btn-primary btn-block mt-4">
            Simpan Kata Sandi
          </button>
        </form>

        <!-- Footer Link -->
        <div class="auth-footer text-center mt-4">
          <p class="text-secondary"><a href="/login">Kembali ke Halaman Login</a></p>
        </div>

      </div>
    </div>
  </section>

  <script>
    import { apiFetch } from '../utils/api';

    const resetForm = document.getElementById('reset-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const alertBox = document.getElementById('alert-box') as HTMLDivElement;

    // Helper to get query params
    function getTokenParam() {
      if (typeof window === 'undefined') return '';
      const params = new URLSearchParams(window.location.search);
      return params.get('token') || '';
    }

    const token = getTokenParam();
    if (!token) {
      showAlert('Token tidak valid atau tidak ditemukan pada link Anda.', 'error');
      submitBtn.disabled = true;
    }

    // Turnstile Logic
    if (typeof window !== 'undefined') {
      const turnstileEl = document.querySelector('.cf-turnstile');
      if (turnstileEl && !(window as any)._turnstileSolved) {
        submitBtn.disabled = true;
      }
      (window as any).onTurnstileSuccess = function() {
        (window as any)._turnstileSolved = true;
        submitBtn.disabled = false;
      };
    }

    resetForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const password = (document.getElementById('password') as HTMLInputElement).value.trim();
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value.trim();

      if (password !== confirmPassword) {
        showAlert('Konfirmasi kata sandi tidak cocok.', 'error');
        return;
      }

      // Extract Turnstile token if it exists (in PROD)
      const turnstileInput = document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      const turnstileToken = turnstileInput ? turnstileInput.value : undefined;

      submitBtn.disabled = true;
      submitBtn.innerText = 'Menyimpan...';
      hideAlert();

      try {
        const response = await apiFetch('/api/auth/reset-password', {
          method: 'POST',
          requireAuth: false,
          body: JSON.stringify({ token, password, turnstileToken }),
        });

        showAlert(response.message || 'Kata sandi berhasil diperbarui. Mengarahkan Anda ke halaman login...', 'success');
        resetForm.reset();

        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
      } catch (err: any) {
        console.error('Reset password failed:', err);
        showAlert(err.message || 'Gagal mengatur ulang kata sandi. Silakan coba lagi.', 'error');
        
        // Reset turnstile if validation fails so user can try again
        if (typeof window !== 'undefined' && (window as any).turnstile) {
          (window as any).turnstile.reset();
          submitBtn.disabled = true; // Disable again until verified
        } else {
          submitBtn.disabled = false;
        }

        submitBtn.innerText = 'Simpan Kata Sandi';
      }
    });

    function showAlert(message: string, type: 'success' | 'error') {
      alertBox.className = `alert alert-${type}`;
      alertBox.innerText = message;
    }

    function hideAlert() {
      alertBox.className = 'alert hidden';
    }
  </script>

  <style>
    .auth-section {
      background-color: var(--bg-primary);
      min-height: calc(100vh - 73px - 100px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .auth-container {
      width: 100%;
      max-width: 480px;
      padding: 0 1.25rem;
    }

    .auth-card {
      padding: 2.25rem 1.5rem !important;
    }

    @media (min-width: 576px) {
      .auth-card {
        padding: 3rem 2.25rem !important;
      }
    }

    .btn-block {
      width: 100%;
      height: 3rem;
      font-size: 1.05rem;
    }

    .hidden {
      display: none !important;
    }
  </style>
</Layout>
