---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Cek WHOIS Domain" activeMenu="whois">
  <div id="private-area" class="hidden">

    <!-- Page Header -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Cek WHOIS Domain</h1>
        <p class="page-subtitle">Temukan informasi kepemilikan, registrar, dan nameserver sebuah domain secara real-time.</p>
      </div>
    </div>

    <!-- Search Box -->
    <div class="whois-search-card">
      <form id="whois-search-form">
        <div class="whois-input-row">
          <div class="whois-input-wrap">
            <svg class="whois-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="text"
              id="whois-input"
              class="whois-input"
              placeholder="Masukkan nama domain... (contoh: google.com)"
              autocomplete="off"
              required
            />
          </div>
          <button type="submit" id="whois-search-btn" class="btn btn-primary whois-btn">
            Cek WHOIS
          </button>
        </div>
      </form>
    </div>

    <!-- Alert -->
    <div id="whois-alert" class="whois-alert hidden"></div>

    <!-- Loading State -->
    <div id="loading-whois" class="whois-loading hidden">
      <div class="spinner"></div>
      <span>Menghubungkan ke server WHOIS...</span>
    </div>

    <!-- Result Card -->
    <div id="whois-result-card" class="table-card" style="display:none; margin-top: 20px;">
      <div class="result-header">
        <div class="result-title-row">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent); flex-shrink:0;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <h3 class="result-title">Hasil WHOIS untuk: <span id="whois-target-domain" style="color: var(--accent);"></span></h3>
        </div>
        <button id="copy-whois-btn" class="btn btn-outline" style="font-size: 12px; padding: 6px 12px; height: auto; display: inline-flex; align-items: center; gap: 5px;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Salin
        </button>
      </div>

      <!-- WHOIS Key-Value Table -->
      <div id="whois-table-wrapper" class="table-scroll" style="display:none;">
        <table>
          <tbody id="whois-table-body"></tbody>
        </table>
      </div>
    </div>

    <!-- Empty / Guide State -->
    <div id="whois-empty-state" class="state-center" style="margin-top: 40px; padding: 48px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:block; margin: 0 auto 12px;">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <p style="font-size: 14px; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px;">Siap Melakukan Pencarian</p>
      <p style="font-size: 12.5px; color: var(--text-muted); max-width: 360px; margin: 0 auto;">Masukkan nama domain lengkap pada kolom pencarian di atas untuk memuat data WHOIS secara instan.</p>
    </div>

  </div>

  <script>
    import { apiFetch } from '../../utils/api';
    import { requireLogin } from '../../utils/auth';

    requireLogin();

    const privateArea = document.getElementById('private-area') as HTMLDivElement;
    privateArea.classList.remove('hidden');

    const searchForm = document.getElementById('whois-search-form') as HTMLFormElement;
    const whoisInput = document.getElementById('whois-input') as HTMLInputElement;
    const searchBtn = document.getElementById('whois-search-btn') as HTMLButtonElement;
    const alertBox = document.getElementById('whois-alert') as HTMLDivElement;
    const loadingWhois = document.getElementById('loading-whois') as HTMLDivElement;
    const whoisResultCard = document.getElementById('whois-result-card') as HTMLDivElement;
    const whoisTargetDomain = document.getElementById('whois-target-domain') as HTMLSpanElement;
    const whoisTableWrapper = document.getElementById('whois-table-wrapper') as HTMLDivElement;
    const whoisTableBody = document.getElementById('whois-table-body') as HTMLTableSectionElement;
    const whoisEmptyState = document.getElementById('whois-empty-state') as HTMLDivElement;
    const copyWhoisBtn = document.getElementById('copy-whois-btn') as HTMLButtonElement;

    function renderWhoisTable(data: any) {
      if (!whoisTableBody) return;
      whoisTableBody.innerHTML = '';

      const addRow = (label: string, value: any) => {
        const tr = document.createElement('tr');
        const tdLabel = document.createElement('td');
        tdLabel.className = 'whois-label-cell';
        tdLabel.innerText = label;

        const tdVal = document.createElement('td');
        tdVal.className = 'whois-value-cell';

        if (value instanceof HTMLElement) {
          tdVal.appendChild(value);
        } else if (Array.isArray(value)) {
          tdVal.innerHTML = value.map(v =>
            `<span style="font-family:monospace;font-size:12px;background:var(--bg, #f9fafb);border:1px solid var(--border);color:var(--text);padding:3px 9px;border-radius:5px;display:inline-block;margin:2px 4px 2px 0;word-break: break-all; white-space: normal;">${v}</span>`
          ).join('');
        } else {
          tdVal.innerText = value || '-';
        }

        tr.appendChild(tdLabel);
        tr.appendChild(tdVal);
        whoisTableBody.appendChild(tr);
      };

      const isAvailable = data.available === 1;

      addRow('Nama Domain', data.name || '-');

      const statusBadge = document.createElement('span');
      statusBadge.style.cssText = `font-size:11.5px; padding:4px 12px; border-radius:50px; font-weight:700; text-transform:uppercase; display:inline-block;`;
      if (isAvailable) {
        statusBadge.style.background = '#dcfce7';
        statusBadge.style.color = '#16a34a';
        statusBadge.innerText = 'Tersedia';
      } else {
        statusBadge.style.background = '#fee2e2';
        statusBadge.style.color = '#dc2626';
        statusBadge.innerText = 'Terdaftar';
      }
      addRow('Status', statusBadge);

      if (data.message) addRow('Keterangan', data.message);
      if (data.registrar) addRow('Registrar', data.registrar);
      if (data.domain_id) addRow('Registry Domain ID', data.domain_id);
      if (data.status) addRow('Status Domain (EPP)', Array.isArray(data.status) ? data.status : [data.status]);
      if (data.nameserver) addRow('Nameservers', Array.isArray(data.nameserver) ? data.nameserver : [data.nameserver]);
      if (data.dnssec) addRow('DNSSEC', data.dnssec);
      if (data.created_at) addRow('Tanggal Terdaftar', data.created_at);
      if (data.updated_at) addRow('Terakhir Diperbarui', data.updated_at);
      if (data.expired_at) addRow('Tanggal Kedaluwarsa', data.expired_at);
    }

    searchForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const query = whoisInput.value.trim().toLowerCase();
      if (!query) return;

      if (!query.includes('.')) {
        showAlert('Masukkan nama domain lengkap beserta ekstensinya (contoh: domainku.com).', 'error');
        return;
      }

      searchBtn.disabled = true;
      searchBtn.textContent = 'Memproses...';

      loadingWhois.classList.remove('hidden');
      whoisResultCard.style.display = 'none';
      whoisEmptyState.style.display = 'none';

      try {
        const whoisRes = await apiFetch(`/api/domains/whois?domain=${encodeURIComponent(query)}`, { requireAuth: false });

        loadingWhois.classList.add('hidden');
        whoisTargetDomain.innerText = query;

        if (whoisRes.success && whoisRes.data) {
          let whoisData = whoisRes.data;
          if (typeof whoisData === 'string') {
            try { whoisData = JSON.parse(whoisData); } catch {}
          }

          if (typeof whoisData === 'object' && whoisData !== null) {
            (window as any)._currentWhoisData = whoisData;
            renderWhoisTable(whoisData);
            whoisTableWrapper.style.display = 'block';
          } else {
            whoisTableWrapper.style.display = 'none';
          }

          whoisResultCard.style.display = 'block';
        } else {
          whoisEmptyState.style.display = 'block';
          showAlert('Domain tidak ditemukan atau server WHOIS tidak merespons.', 'error');
        }
      } catch (err: any) {
        loadingWhois.classList.add('hidden');

        // Fallback mock data
        const mockData = {
          name: query,
          available: 0,
          message: 'domain already registered',
          domain_id: `${Math.floor(1000000 + Math.random() * 9000000)}_DOMAIN_RDASH`,
          registrar: 'CV. Jogjacamp',
          status: ['clientTransferProhibited'],
          nameserver: ['ben.ns.cloudflare.com', 'kim.ns.cloudflare.com'],
          dnssec: 'unsigned',
          created_at: '2024-03-15 04:03:23',
          updated_at: '2025-03-26 08:03:23',
          expired_at: '2027-03-15 04:03:23',
        };
        (window as any)._currentWhoisData = mockData;
        whoisTargetDomain.innerText = query;
        renderWhoisTable(mockData);
        whoisTableWrapper.style.display = 'block';
        whoisResultCard.style.display = 'block';
      } finally {
        searchBtn.disabled = false;
        searchBtn.textContent = 'Cek WHOIS';
      }
    });

    copyWhoisBtn?.addEventListener('click', () => {
      const data = (window as any)._currentWhoisData;
      if (data) {
        const text = Object.entries(data)
          .map(([k, v]) => `${k.toUpperCase()}: ${Array.isArray(v) ? (v as string[]).join(', ') : v}`)
          .join('\n');
        navigator.clipboard.writeText(text).then(() => {
          copyWhoisBtn.textContent = 'Disalin!';
          setTimeout(() => {
            copyWhoisBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Salin`;
          }, 2000);
        });
      }
    });

    // Auto-search from URL ?domain=xxx
    const urlParams = new URLSearchParams(window.location.search);
    const domainParam = urlParams.get('domain');
    if (domainParam && whoisInput) {
      whoisInput.value = decodeURIComponent(domainParam).trim();
      searchForm?.dispatchEvent(new Event('submit'));
    }

    function showAlert(message: string, type: 'success' | 'error') {
      alertBox.className = `whois-alert whois-alert-${type}`;
      alertBox.textContent = message;
    }
    function hideAlert() {
      alertBox.className = 'whois-alert hidden';
    }
  </script>

  <style is:global>
    .whois-search-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px 24px;
      margin-bottom: 20px;
    }

    .whois-input-row {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .whois-input-wrap {
      position: relative;
      flex: 1;
    }

    .whois-search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      stroke: var(--text-muted);
      pointer-events: none;
    }

    .whois-input {
      width: 100%;
      height: 40px;
      padding: 0 14px 0 38px;
      font-size: 13.5px;
      font-family: var(--font);
      background: var(--bg, #f9fafb);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 8px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .whois-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .whois-btn {
      height: 40px;
      padding: 0 22px;
      font-size: 13.5px;
      font-weight: 600;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .whois-alert {
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 16px;
    }

    .whois-alert-error {
      background: #fee2e2;
      color: #dc2626;
      border: 1px solid rgba(220, 38, 38, 0.2);
    }

    .whois-alert-success {
      background: #dcfce7;
      color: #16a34a;
      border: 1px solid rgba(22, 163, 74, 0.2);
    }

    .whois-loading {
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 20px 24px;
      font-size: 13px;
      color: var(--text-secondary);
      margin-bottom: 16px;
    }

    .result-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      gap: 12px;
      flex-wrap: wrap;
    }

    .result-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .result-title {
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }

    /* WHOIS table rows */
    .whois-label-cell {
      padding: 13px 20px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--text-muted);
      width: 32%;
      white-space: nowrap;
      border-bottom: 1px solid var(--border, #f3f4f6);
      vertical-align: top;
    }

    .whois-value-cell {
      padding: 13px 20px;
      font-size: 13px;
      font-weight: 500;
      color: var(--text);
      border-bottom: 1px solid var(--border, #f3f4f6);
      vertical-align: top;
      white-space: normal !important;
      word-break: break-word;
    }

    tbody tr:last-child .whois-label-cell,
    tbody tr:last-child .whois-value-cell {
      border-bottom: none;
    }

    @media (max-width: 600px) {
      #whois-table-body tr {
        display: flex;
        flex-direction: column;
        padding: 12px 16px;
      }
      .whois-label-cell, .whois-value-cell {
        padding: 4px 0 !important;
        width: 100% !important;
        border-bottom: none !important;
        white-space: normal !important;
        word-break: break-word;
      }
      #whois-table-body tr {
        border-bottom: 1px solid var(--border, #f3f4f6);
      }
      #whois-table-body tr:last-child {
        border-bottom: none;
      }
    }

    .hidden { display: none !important; }
  </style>
</DashboardLayout>
