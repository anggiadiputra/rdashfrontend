---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lupa Kata Sandi">
  <section class="auth-section section">
    <div class="container auth-container">
      <div class="card auth-card">
        
        <!-- Header -->
        <div class="auth-header text-center mb-4">
          <h2>Lupa Kata Sandi</h2>
          <p class="text-secondary mt-1">Masukkan alamat email Anda untuk menerima tautan atur ulang kata sandi.</p>
        </div>

        <!-- Alert Notification Box -->
        <div id="alert-box" class="alert hidden"></div>

        <!-- Forgot Password Form -->
        <form id="forgot-form" class="auth-form">
          <div class="form-group">
            <label class="form-label" for="email">Alamat Email</label>
            <input type="email" id="email" class="form-control" placeholder="nama@email.com" required autocomplete="email" />
          </div>

          {import.meta.env.PROD && import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
            <div class="form-group mt-4 flex justify-center">
              <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-theme="auto" data-callback="onTurnstileSuccess"></div>
            </div>
          )}

          <button type="submit" id="submit-btn" class="btn btn-primary btn-block mt-4">
            Kirim Tautan Atur Ulang
          </button>
        </form>

        <!-- Footer Link -->
        <div class="auth-footer text-center mt-4">
          <p class="text-secondary"><a href="/login">Kembali ke Halaman Login</a></p>
        </div>

      </div>
    </div>
  </section>

  <script>
    import { apiFetch } from '../utils/api';

    const forgotForm = document.getElementById('forgot-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const alertBox = document.getElementById('alert-box') as HTMLDivElement;

    // Turnstile Logic
    if (typeof window !== 'undefined') {
      const turnstileEl = document.querySelector('.cf-turnstile');
      if (turnstileEl && !(window as any)._turnstileSolved) {
        submitBtn.disabled = true;
      }
      (window as any).onTurnstileSuccess = function() {
        (window as any)._turnstileSolved = true;
        submitBtn.disabled = false;
      };
    }

    forgotForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = (document.getElementById('email') as HTMLInputElement).value.replace(/\s+/g, '');

      // Extract Turnstile token if it exists (in PROD)
      const turnstileInput = document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
      const turnstileToken = turnstileInput ? turnstileInput.value : undefined;

      submitBtn.disabled = true;
      submitBtn.innerText = 'Mengirim...';
      hideAlert();

      try {
        const response = await apiFetch('/api/auth/forgot-password', {
          method: 'POST',
          requireAuth: false,
          body: JSON.stringify({ email, turnstileToken }),
        });

        showAlert(response.message || 'Tautan atur ulang kata sandi telah dikirimkan ke email Anda.', 'success');
        forgotForm.reset();
      } catch (err: any) {
        console.error('Forgot password failed:', err);
        showAlert(err.message || 'Gagal mengirim permintaan. Silakan coba lagi.', 'error');
        
        // Reset turnstile if validation fails so user can try again
        if (typeof window !== 'undefined' && (window as any).turnstile) {
          (window as any).turnstile.reset();
          submitBtn.disabled = true; // Disable again until verified
        } else {
          submitBtn.disabled = false;
        }

        submitBtn.innerText = 'Kirim Tautan Atur Ulang';
      }
    });

    function showAlert(message: string, type: 'success' | 'error') {
      alertBox.className = `alert alert-${type}`;
      alertBox.innerText = message;
    }

    function hideAlert() {
      alertBox.className = 'alert hidden';
    }
  </script>

  <style>
    .auth-section {
      background-color: #070913;
      background: linear-gradient(180deg, #070913 0%, #0a0c16 100%);
      min-height: calc(100vh - 73px - 100px);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .auth-container {
      width: 100%;
      max-width: 480px;
      padding: 0 1.25rem;
      position: relative;
      z-index: 10;
    }

    .auth-card {
      padding: 2.25rem 1.5rem !important;
      background: rgba(255, 255, 255, 0.02) !important;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.25) !important;
    }

    [data-theme="light"] .auth-card {
      background: rgba(255, 255, 255, 0.7) !important;
      border: 1px solid var(--border-color) !important;
      box-shadow: var(--shadow-lg) !important;
    }

    @media (min-width: 576px) {
      .auth-card {
        padding: 3rem 2.25rem !important;
      }
    }

    .btn-block {
      width: 100%;
      height: 3rem;
      font-size: 1.05rem;
    }

    .hidden {
      display: none !important;
    }
  </style>
</Layout>
