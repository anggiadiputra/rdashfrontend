---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Daftar Harga Domain">
  <div class="container" style="padding: 40px 1.5rem; min-height: 70vh;">
    
    <!-- Header -->
    <div style="margin-bottom: 28px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px;">
      <h1 class="page-title" style="font-size: 24px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 10px;">
        <svg class="lucide lucide-tag" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        Daftar Harga Ekstensi Domain
      </h1>
      <p class="page-subtitle" style="font-size: 14px; color: var(--text-secondary); margin-top: 6px;">
        Lihat harga pendaftaran, perpanjangan, dan transfer domain secara realtime langsung dari registrar.
      </p>
    </div>

    <!-- Filters Row -->
    <div id="filters-row" class="card" style="padding: 20px !important; border-radius: 12px; margin-bottom: 24px; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color); background: var(--bg-secondary);">
      <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: space-between;">
        
        <!-- Live Search -->
        <div style="position: relative; display: flex; align-items: center; width: 320px; max-width: 100%;">
          <svg class="lucide lucide-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 15px; height: 15px; position: absolute; left: 12px; color: var(--text-secondary); pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="tld-search-input" class="form-control-compact" placeholder="Cari ekstensi (misal: .id, .com)..." style="padding-left: 36px; height: 38px; font-size: 12.5px; border-radius: 8px; width: 100%; border: 1px solid var(--border-color); background: var(--bg-primary);" />
        </div>

        <!-- Category Filter Pills -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap;" id="category-pills-container">
          <button class="pill active" data-category="all">Semua</button>
          <button class="pill" data-category="popular">Populer</button>
          <button class="pill" data-category="id">Indonesian (.ID)</button>
          <button class="pill" data-category="promo">Sedang Promo 🔥</button>
        </div>

      </div>
    </div>

    <!-- Pricing Tabs -->
    <div style="display: flex; gap: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 2px;">
      <button class="tab-link active" data-tab-type="register">Harga Pendaftaran</button>
      <button class="tab-link" data-tab-type="renew">Harga Perpanjangan</button>
      <button class="tab-link" data-tab-type="transfer">Harga Transfer & Fitur</button>
      <button class="tab-link" data-tab-type="whois">Proteksi WHOIS</button>
    </div>

    <!-- Global WHOIS Price Card (shown only on WHOIS tab) -->
    <div id="whois-global-container" class="hidden" style="margin-bottom: 24px;">
      <div class="card" style="padding: 24px !important; border-radius: 12px; border: 1px solid var(--border-color); background: var(--bg-secondary); max-width: 480px; box-shadow: var(--shadow-sm);">
        <h3 style="font-size: 15px; font-weight: 700; margin: 0 0 8px; display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-shield" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: var(--accent-primary);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Biaya Proteksi WHOIS (WHOIS Privacy)
        </h3>
        <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 20px; line-height: 1.5;">
          Proteksi WHOIS Privacy menyembunyikan data kepemilikan domain Anda (Nama, Email, Telepon) dari publik untuk menghindari spam.
        </p>
        
        <div style="background: var(--bg-primary); border: 1px solid var(--border-color); padding: 16px; border-radius: 10px; display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 500; color: var(--text-secondary);">Harga Proteksi WHOIS</span>
            <span id="customer-whois-price" style="font-size: 18px; font-weight: 800; color: var(--accent-primary);">Rp 15.000 / tahun</span>
          </div>
          <div style="border-top: 1px dashed var(--border-color); padding-top: 8px; font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
            <svg class="lucide lucide-info" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--warning);"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span>Khusus domain Indonesia (.ID) gratis / Rp0 tanpa biaya tambahan.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Table Wrapper -->
    <div id="main-table-card" class="table-card" style="border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); border: 1px solid var(--border-color); background: var(--bg-primary);">
      
      <!-- Loading view -->
      <div id="prices-loading" class="state-center" style="padding: 60px 0;">
        <div class="spinner"></div>
        <p style="margin-top: 12px; font-weight: 500;">Memuat harga realtime...</p>
      </div>

      <!-- Empty/No result view -->
      <div id="prices-empty" class="state-center hidden" style="padding: 60px 0;">
        <svg class="lucide lucide-minus-circle" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted);"><circle cx="12" cy="12" r="10"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
        <p style="margin-top: 12px; color: var(--text-secondary);">Tidak ada ekstensi yang cocok dengan filter pencarian.</p>
      </div>

      <!-- Price Table -->
      <div id="prices-table-wrap" class="table-scroll hidden">
        <table class="table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background: var(--bg-secondary); border-bottom: 1px solid var(--border-color);">
              <th style="padding: 14px 20px; font-size: 11px; font-weight: 600; text-align: left; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Ekstensi (TLD)</th>
              <th id="dynamic-header-1" style="padding: 14px 20px; font-size: 11px; font-weight: 600; text-align: right; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Harga 1 Tahun</th>
              <th id="dynamic-header-2" style="padding: 14px 20px; font-size: 11px; font-weight: 600; text-align: right; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Harga 2 Tahun</th>
              <th id="dynamic-header-3" style="padding: 14px 20px; font-size: 11px; font-weight: 600; text-align: right; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px;">Harga 5 Tahun</th>
              <th id="dynamic-header-4" style="padding: 14px 20px; font-size: 11px; font-weight: 600; text-align: right; color: var(--text-secondary); width: 120px;"></th>
            </tr>
          </thead>
          <tbody id="prices-tbody">
            <!-- Dynamic rows -->
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div id="pagination-container" class="pagination-bar hidden">
        <span class="text-secondary" id="pagination-info" style="font-size:12px;">Halaman 1 dari 1 (Total: 0)</span>
        <div style="display:flex;gap:8px;">
          <button id="prev-page-btn" class="btn-pagination" disabled>Sebelumnya</button>
          <button id="next-page-btn" class="btn-pagination" disabled>Berikutnya</button>
        </div>
      </div>

    </div>

  </div>

  <!-- Multi-year Details Modal -->
  <div id="details-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-clipboard-list" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 14h6"/><path d="M9 18h6"/><path d="M9 10h6"/></svg>
          <h3 style="font-size: 16px; font-weight: 700; margin: 0;">Detail Harga Lengkap: <span id="modal-tld-display" style="color: var(--accent-primary); font-family: monospace;"></span></h3>
        </div>
        <button id="close-modal-btn" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%;">×</button>
      </div>

      <!-- Pricing Comparison Grid -->
      <div class="pricing-comparison-grid" style="margin-bottom: 16px;">
        
        <!-- Registration Column -->
        <div style="background: var(--bg-secondary); padding: 16px; border-radius: 10px; border: 1px solid var(--border-color);">
          <h4 style="font-size: 13.5px; font-weight: 700; margin: 0 0 12px; color: var(--accent-primary); border-bottom: 1px dashed var(--border-color); padding-bottom: 6px;">Pendaftaran (Register)</h4>
          <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <th style="padding: 6px 0; text-align: left; font-size: 10px; color: var(--text-muted);">Tahun</th>
                <th style="padding: 6px 0; text-align: right; font-size: 10px; color: var(--text-muted);">Harga Aktif</th>
              </tr>
            </thead>
            <tbody id="modal-register-body"></tbody>
          </table>
        </div>

        <!-- Renewal Column -->
        <div style="background: var(--bg-secondary); padding: 16px; border-radius: 10px; border: 1px solid var(--border-color);">
          <h4 style="font-size: 13.5px; font-weight: 700; margin: 0 0 12px; color: var(--success); border-bottom: 1px dashed var(--border-color); padding-bottom: 6px;">Perpanjangan (Renewal)</h4>
          <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <th style="padding: 6px 0; text-align: left; font-size: 10px; color: var(--text-muted);">Tahun</th>
                <th style="padding: 6px 0; text-align: right; font-size: 10px; color: var(--text-muted);">Harga Aktif</th>
              </tr>
            </thead>
            <tbody id="modal-renewal-body"></tbody>
          </table>
        </div>

      </div>

      <!-- Footer Info -->
      <div style="background: rgba(136, 80, 255, 0.03); border: 1px dashed rgba(136, 80, 255, 0.15); border-radius: 8px; padding: 12px; font-size: 11.5px; line-height: 1.4; color: var(--text-secondary);">
        <p><strong>Informasi Tambahan:</strong></p>
        <ul style="margin-left: 16px; margin-top: 4px; display: flex; flex-direction: column; gap: 2px;">
          <li>Transfer Domain: <span id="modal-transfer-price" style="font-weight: 600; color: var(--text-primary);"></span> (Termasuk penambahan masa aktif 1 tahun)</li>
          <li>WHOIS Privacy Protection: <span id="modal-whois-price" style="font-weight: 600; color: var(--text-primary);"></span></li>
          <li id="modal-indonesia-warning" class="hidden" style="color: var(--warning); font-weight: 500;">⚠️ Domain Indonesia (.ID) memerlukan persyaratan verifikasi dokumen (KTP/SK).</li>
        </ul>
      </div>

    </div>
  </div>
</Layout>

<script>
  import { apiFetch } from '../utils/api';

  const loadingView = document.getElementById('prices-loading') as HTMLDivElement;
  const emptyView = document.getElementById('prices-empty') as HTMLDivElement;
  const tableWrap = document.getElementById('prices-table-wrap') as HTMLDivElement;
  const pricesTbody = document.getElementById('prices-tbody') as HTMLTableSectionElement;
  
  const searchInput = document.getElementById('tld-search-input') as HTMLInputElement;
  const dynamicHeader1 = document.getElementById('dynamic-header-1') as HTMLTableCellElement;
  const dynamicHeader2 = document.getElementById('dynamic-header-2') as HTMLTableCellElement;
  const dynamicHeader3 = document.getElementById('dynamic-header-3') as HTMLTableCellElement;

  // Modal elements
  const detailsModal = document.getElementById('details-modal') as HTMLDivElement;
  const modalTldDisplay = document.getElementById('modal-tld-display') as HTMLSpanElement;
  const modalRegisterBody = document.getElementById('modal-register-body') as HTMLTableSectionElement;
  const modalRenewalBody = document.getElementById('modal-renewal-body') as HTMLTableSectionElement;
  const modalTransferPrice = document.getElementById('modal-transfer-price') as HTMLSpanElement;
  const modalWhoisPrice = document.getElementById('modal-whois-price') as HTMLSpanElement;
  const modalIndoWarning = document.getElementById('modal-indonesia-warning') as HTMLLIElement;
  const closeModalBtn = document.getElementById('close-modal-btn') as HTMLButtonElement;

  let allPrices: any[] = [];
  let currentTab = 'register'; // 'register', 'renew', 'transfer'
  let currentCategory = 'all'; // 'all', 'popular', 'id', 'promo'
  let searchQuery = '';
  let currentPage = 1;
  const limitPerPage = 15;
  let filteredPrices: any[] = [];

  const paginationContainer = document.getElementById('pagination-container') as HTMLDivElement;
  const paginationInfo = document.getElementById('pagination-info') as HTMLSpanElement;
  const prevPageBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
  const nextPageBtn = document.getElementById('next-page-btn') as HTMLButtonElement;

  function formatCurrency(amount: number): string {
    return 'Rp' + amount.toLocaleString('id-ID', { minimumFractionDigits: 0, maximumFractionDigits: 0 }).replace(/,/g, '.');
  }

  // Load Realtime Prices
  async function loadRealtimePrices() {
    loadingView.classList.remove('hidden');
    tableWrap.classList.add('hidden');
    emptyView.classList.add('hidden');

    try {
      const res = await apiFetch('/api/domains/prices', { requireAuth: false });
      if (res.success && Array.isArray(res.data) && res.data.length > 0) {
        allPrices = res.data;
      } else {
        throw new Error("No data returned");
      }
    } catch (e) {
      console.warn("Failed fetching realtime prices, using fallback data:", e);
      loadFallbackPrices();
    } finally {
      loadingView.classList.add('hidden');
      renderTable();
    }
  }

  function loadFallbackPrices() {
    allPrices = [
      {
        extension: '.com',
        registerPrice: 145000,
        renewPrice: 165000,
        regularRegisterPrice: 0,
        regularRenewPrice: 0,
        transferPrice: 145000,
        whoisPrice: 15000,
        promo: false,
        registrationByYear: { "1": 145000, "2": 290000, "3": 435000, "5": 725000 },
        renewalByYear: { "1": 165000, "2": 330000, "3": 495000, "5": 825000 }
      },
      {
        extension: '.net',
        registerPrice: 165000,
        renewPrice: 185000,
        regularRegisterPrice: 0,
        regularRenewPrice: 0,
        transferPrice: 165000,
        whoisPrice: 15000,
        promo: false,
        registrationByYear: { "1": 165000, "2": 330000 },
        renewalByYear: { "1": 185000, "2": 370000 }
      },
      {
        extension: '.id',
        registerPrice: 200000,
        renewPrice: 220000,
        regularRegisterPrice: 250000,
        regularRenewPrice: 0,
        transferPrice: 200000,
        whoisPrice: 0,
        promo: true,
        registrationByYear: { "1": 200000, "2": 420000, "3": 640000, "5": 1080000 },
        renewalByYear: { "1": 220000, "2": 440000, "3": 660000, "5": 1100000 },
        regularRegistrationByYear: { "1": 250000, "2": 470000, "3": 690000, "5": 1130000 }
      },
      {
        extension: '.my.id',
        registerPrice: 9500,
        renewPrice: 15000,
        regularRegisterPrice: 15000,
        regularRenewPrice: 0,
        transferPrice: 15000,
        whoisPrice: 0,
        promo: true,
        registrationByYear: { "1": 9500, "2": 24500, "5": 69500 },
        renewalByYear: { "1": 15000, "2": 30000, "5": 75000 },
        regularRegistrationByYear: { "1": 15000, "2": 30000, "5": 75000 }
      },
      {
        extension: '.web.id',
        registerPrice: 50000,
        renewPrice: 60000,
        regularRegisterPrice: 0,
        regularRenewPrice: 0,
        transferPrice: 50000,
        whoisPrice: 0,
        promo: false,
        registrationByYear: { "1": 50000, "2": 100000 },
        renewalByYear: { "1": 60000, "2": 120000 }
      },
      {
        extension: '.xyz',
        registerPrice: 38000,
        renewPrice: 185000,
        regularRegisterPrice: 185000,
        regularRenewPrice: 0,
        transferPrice: 185000,
        whoisPrice: 15000,
        promo: true,
        registrationByYear: { "1": 38000, "2": 223000 },
        renewalByYear: { "1": 185000, "2": 370000 },
        regularRegistrationByYear: { "1": 185000, "2": 370000 }
      }
    ];
  }

  // Categories helper
  function checkCategory(item: any, category: string): boolean {
    const ext = item.extension.toLowerCase();
    if (category === 'all') return true;
    if (category === 'promo') return !!item.promo;
    if (category === 'id') {
      return ext.endsWith('.id') || ext.includes('.id.');
    }
    if (category === 'popular') {
      const populars = ['.com', '.net', '.org', '.id', '.co.id', '.info', '.xyz'];
      return populars.includes(ext);
    }
    return true;
  }

  function renderTable() {
    pricesTbody.innerHTML = '';

    const filtersRow = document.getElementById('filters-row') as HTMLDivElement;
    const mainTableCard = document.getElementById('main-table-card') as HTMLDivElement;
    const whoisGlobalContainer = document.getElementById('whois-global-container') as HTMLDivElement;

    if (currentTab === 'whois') {
      if (whoisGlobalContainer) {
        whoisGlobalContainer.classList.remove('hidden');
        const comItem = allPrices.find(p => p.extension === '.com');
        const globalWhoisPrice = comItem ? comItem.whoisPrice : 15000;
        const priceEl = document.getElementById('customer-whois-price');
        if (priceEl) {
          priceEl.textContent = formatCurrency(globalWhoisPrice) + ' / tahun';
        }
      }
      if (filtersRow) filtersRow.classList.remove('hidden');
      if (mainTableCard) mainTableCard.classList.remove('hidden');
    } else {
      if (filtersRow) filtersRow.classList.remove('hidden');
      if (mainTableCard) mainTableCard.classList.remove('hidden');
      if (whoisGlobalContainer) whoisGlobalContainer.classList.add('hidden');
    }

    // Filter list
    filteredPrices = allPrices.filter(item => {
      // 1. Search Query
      const matchSearch = item.extension.toLowerCase().includes(searchQuery.toLowerCase());
      // 2. Category
      const matchCategory = checkCategory(item, currentCategory);
      return matchSearch && matchCategory;
    });

    if (filteredPrices.length === 0) {
      tableWrap.classList.add('hidden');
      emptyView.classList.remove('hidden');
      paginationContainer.classList.add('hidden');
      return;
    }

    emptyView.classList.add('hidden');
    tableWrap.classList.remove('hidden');

    // Update Headers based on Active Tab
    if (currentTab === 'register') {
      dynamicHeader1.innerText = 'Daftar 1 Tahun';
      dynamicHeader2.innerText = 'Daftar 2 Tahun';
      dynamicHeader3.innerText = 'Daftar 5 Tahun';
    } else if (currentTab === 'renew') {
      dynamicHeader1.innerText = 'Perpanjang 1 Thn';
      dynamicHeader2.innerText = 'Perpanjang 2 Thn';
      dynamicHeader3.innerText = 'Perpanjang 5 Thn';
    } else if (currentTab === 'transfer') {
      dynamicHeader1.innerText = 'Biaya Transfer';
      dynamicHeader2.innerText = 'Jenis Mata Uang';
      dynamicHeader3.innerText = '';
    } else if (currentTab === 'whois') {
      dynamicHeader1.innerText = 'Status WHOIS';
      dynamicHeader2.innerText = 'Biaya Proteksi';
      dynamicHeader3.innerText = '';
    }

    const totalItems = filteredPrices.length;
    const totalPages = Math.ceil(totalItems / limitPerPage);
    if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

    const startIdx = (currentPage - 1) * limitPerPage;
    const endIdx = startIdx + limitPerPage;
    const pageItems = filteredPrices.slice(startIdx, endIdx);

    pageItems.forEach(item => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--border-color)';
      
      // Build TLD Column with Promo Badge if active
      let tldHtml = `<span class="domain-name" style="font-family: monospace; font-size:14.5px; font-weight: 700; color: var(--accent-primary);">${item.extension}</span>`;
      if (item.promo) {
        tldHtml += `<span class="badge" style="background-color: var(--error-bg); color: var(--error); border: 1px solid rgba(220,38,38,0.15); margin-left: 6px; font-size:9.5px; padding: 2px 6px; font-weight: 700; border-radius: 4px;">PROMO</span>`;
      }

      let col1Html = '';
      let col2Html = '';
      let col3Html = '';

      if (currentTab === 'register') {
        const p1 = item.registrationByYear['1'] || item.registerPrice || 0;
        const p2 = item.registrationByYear['2'] || 0;
        const p5 = item.registrationByYear['5'] || 0;

        const regP1 = item.regularRegistrationByYear?.['1'] || item.regularRegisterPrice || 0;
        const isPromoActiveP1 = item.promo && regP1 > 0 && p1 < regP1;

        col1Html = isPromoActiveP1 
          ? `<span style="text-decoration: line-through; color: var(--text-muted); font-size:11px; margin-right: 6px;">${formatCurrency(regP1)}</span><span style="font-weight: 700; color: var(--error);">${formatCurrency(p1)}</span>`
          : `<span style="font-weight: 700; color: var(--text-primary);">${formatCurrency(p1)}</span>`;

        col2Html = p2 > 0 ? `<span style="font-weight: 500;">${formatCurrency(p2)}</span>` : '<span style="color: var(--text-muted); font-size:12px;">-</span>';
        col3Html = p5 > 0 ? `<span style="font-weight: 500;">${formatCurrency(p5)}</span>` : '<span style="color: var(--text-muted); font-size:12px;">-</span>';
      } else if (currentTab === 'renew') {
        const p1 = item.renewalByYear['1'] || item.renewPrice || 0;
        const p2 = item.renewalByYear['2'] || 0;
        const p5 = item.renewalByYear['5'] || 0;

        col1Html = `<span style="font-weight: 700; color: var(--text-primary);">${formatCurrency(p1)}</span>`;
        col2Html = p2 > 0 ? `<span style="font-weight: 500;">${formatCurrency(p2)}</span>` : '<span style="color: var(--text-muted); font-size:12px;">-</span>';
        col3Html = p5 > 0 ? `<span style="font-weight: 500;">${formatCurrency(p5)}</span>` : '<span style="color: var(--text-muted); font-size:12px;">-</span>';
      } else if (currentTab === 'transfer') {
        const tf = item.transferPrice || 0;
        col1Html = `<span style="font-weight: 700; color: var(--text-primary);">${formatCurrency(tf)}</span>`;
        col2Html = `<span style="text-transform: uppercase; font-weight:600; font-size:12px; color: var(--text-secondary);">${item.currency || 'IDR'}</span>`;
        col3Html = '<span style="color: var(--text-muted); font-size:12px;">-</span>';
      } else if (currentTab === 'whois') {
        const isId = item.extension.toLowerCase().endsWith('.id') || item.extension.toLowerCase().includes('.id.');
        col1Html = isId 
          ? `<span style="color: var(--text-secondary); font-weight: 500;">Tidak Didukung / Gratis</span>`
          : `<span style="color: var(--success); font-weight: 600;">Didukung (Global)</span>`;
        col2Html = item.whoisPrice > 0 
          ? `<span style="font-weight: 700; color: var(--text-primary);">${formatCurrency(item.whoisPrice)}</span>`
          : `<span style="color: var(--success); font-weight: 600;">GRATIS</span>`;
        col3Html = '<span style="color: var(--text-muted); font-size:12px;">-</span>';
      }

      tr.innerHTML = `
        <td style="padding: 16px 20px; vertical-align: middle;">${tldHtml}</td>
        <td style="padding: 16px 20px; text-align: right; vertical-align: middle;">${col1Html}</td>
        <td style="padding: 16px 20px; text-align: right; vertical-align: middle;">${col2Html}</td>
        <td style="padding: 16px 20px; text-align: right; vertical-align: middle;">${col3Html}</td>
        <td style="padding: 16px 20px; text-align: right; vertical-align: middle;">
          <span class="detail-link btn-details-action" data-tld="${item.extension}" style="cursor: pointer; color: var(--accent-primary); font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; transition: background 0.2s;">
            Detail &rarr;
          </span>
        </td>
      `;

      pricesTbody.appendChild(tr);
    });

    // Update pagination controls
    if (prevPageBtn) prevPageBtn.disabled = currentPage === 1;
    if (nextPageBtn) nextPageBtn.disabled = currentPage >= totalPages;

    const startNum = startIdx + 1;
    const endNum = Math.min(startIdx + pageItems.length, totalItems);
    if (paginationInfo) {
      paginationInfo.textContent = `Halaman ${currentPage} (Menampilkan ${startNum}-${endNum} dari ${totalItems} ekstensi)`;
    }
    paginationContainer.classList.remove('hidden');

    // Add listeners to Detail Links
    document.querySelectorAll('.btn-details-action').forEach(btn => {
      btn.addEventListener('click', (e) => {
        let target = e.target as HTMLElement;
        // Make sure we get the element with data-tld
        if (!target.dataset.tld) {
          target = target.closest('.btn-details-action') as HTMLElement;
        }
        const tld = target.dataset.tld;
        const item = allPrices.find(p => p.extension === tld);
        if (item) openDetailsModal(item);
      });
    });
  }

  // Modal handling
  function openDetailsModal(item: any) {
    modalTldDisplay.innerText = item.extension;
    modalRegisterBody.innerHTML = '';
    modalRenewalBody.innerHTML = '';

    // Render Registration Table
    const yearsReg = Object.keys(item.registrationByYear || {}).sort((a, b) => parseInt(a) - parseInt(b));
    if (yearsReg.length > 0) {
      yearsReg.forEach(yr => {
        const price = item.registrationByYear[yr];
        const regPrice = item.regularRegistrationByYear?.[yr] || 0;
        const isPromoActive = item.promo && regPrice > 0 && price < regPrice;

        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--border-color)';
        
        const priceHtml = isPromoActive
          ? `<span style="text-decoration: line-through; color: var(--text-muted); font-size: 11px; margin-right: 6px;">${formatCurrency(regPrice)}</span><span style="color: var(--error); font-weight: 700;">${formatCurrency(price)}</span>`
          : `<span style="color: var(--text-primary); font-weight: 600;">${formatCurrency(price)}</span>`;

        tr.innerHTML = `
          <td style="padding: 8px 0; font-weight: 500;">${yr} Tahun</td>
          <td style="padding: 8px 0; text-align: right;">${priceHtml}</td>
        `;
        modalRegisterBody.appendChild(tr);
      });
    } else {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td colspan="2" style="padding: 8px 0; text-align: center; color: var(--text-muted);">Harga tidak tersedia</td>`;
      modalRegisterBody.appendChild(tr);
    }

    // Render Renewal Table
    const yearsRen = Object.keys(item.renewalByYear || {}).sort((a, b) => parseInt(a) - parseInt(b));
    if (yearsRen.length > 0) {
      yearsRen.forEach(yr => {
        const price = item.renewalByYear[yr];
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid var(--border-color)';
        tr.innerHTML = `
          <td style="padding: 8px 0; font-weight: 500;">${yr} Tahun</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: var(--text-primary);">${formatCurrency(price)}</td>
        `;
        modalRenewalBody.appendChild(tr);
      });
    } else {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td colspan="2" style="padding: 8px 0; text-align: center; color: var(--text-muted);">Harga tidak tersedia</td>`;
      modalRenewalBody.appendChild(tr);
    }

    // Populate extra metadata
    modalTransferPrice.innerText = formatCurrency(item.transferPrice || 0);
    modalWhoisPrice.innerText = item.whoisPrice > 0 ? formatCurrency(item.whoisPrice) : 'GRATIS / FREE';

    // Indonesian verification label
    const isId = item.extension.toLowerCase().endsWith('.id') || item.extension.toLowerCase().includes('.id.');
    if (isId) {
      modalIndoWarning.classList.remove('hidden');
    } else {
      modalIndoWarning.classList.add('hidden');
    }

    detailsModal.classList.remove('hidden');
  }

  // Close modal
  closeModalBtn.addEventListener('click', () => detailsModal.classList.add('hidden'));
  detailsModal.addEventListener('click', (e) => {
    if (e.target === detailsModal) detailsModal.classList.add('hidden');
  });

  // Category selection handler
  document.querySelectorAll('#category-pills-container .pill').forEach(pill => {
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('#category-pills-container .pill').forEach(p => p.classList.remove('active'));
      const target = e.target as HTMLButtonElement;
      target.classList.add('active');
      currentCategory = target.dataset.category || 'all';
      currentPage = 1;
      renderTable();
    });
  });

  // Tab switching handler
  document.querySelectorAll('[data-tab-type]').forEach(tab => {
    tab.addEventListener('click', (e) => {
      document.querySelectorAll('[data-tab-type]').forEach(t => t.classList.remove('active'));
      const target = e.target as HTMLButtonElement;
      target.classList.add('active');
      currentTab = target.dataset.tabType || 'register';
      currentPage = 1;
      renderTable();
    });
  });

  // Live Search handler
  searchInput.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    currentPage = 1;
    renderTable();
  });

  // Pagination buttons
  prevPageBtn?.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderTable();
    }
  });

  nextPageBtn?.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredPrices.length / limitPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderTable();
    }
  });

  // Trigger loading on page load
  loadRealtimePrices();
</script>

