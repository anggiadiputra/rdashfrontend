---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Pengaturan Sistem" activeMenu="settings">
  <div style="padding: 10px 0; min-height: 70vh; max-width: 800px;">
    
    <!-- Page Header -->
    <div style="margin-bottom: 28px; border-bottom: 1px solid var(--border); padding-bottom: 16px;">
      <h1 class="page-title" style="font-size: 24px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 10px;">
        <svg class="lucide lucide-settings" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent);"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Pengaturan Sistem
      </h1>
      <p class="page-subtitle" style="font-size: 14px; color: var(--text-secondary); margin-top: 6px;">
        Konfigurasi branding, upload logo, aturan pajak, dan metode pembayaran aktif.
      </p>
    </div>

    <!-- Alert Box -->
    <div id="settings-alert-box" class="alert hidden"></div>

    <form id="settings-form" class="card" style="padding: 28px !important; border-radius: 12px; background: var(--surface); border: 1px solid var(--border); box-shadow: var(--shadow-md); display: flex; flex-direction: column; gap: 24px;">
      
      <!-- Section 1: Branding -->
      <div>
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 14px; color: var(--text); border-bottom: 1px dashed var(--border); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-tag" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          Identitas & Branding
        </h3>
        
        <div class="form-group">
          <label class="form-label">Nama Aplikasi / Brand</label>
          <input type="text" id="app_name" class="form-control" placeholder="Contoh: Ruangtunggu" required />
          <span style="font-size: 11.5px; color: var(--text-muted); display: block; margin-top: 4px;">Nama ini akan memengaruhi title di halaman web dan footer portal Anda.</span>
        </div>

        <div class="form-group">
          <label class="form-label">Upload Logo Aplikasi</label>
          <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
            <div id="logo-preview-container" style="width: 140px; height: 60px; border: 1px dashed var(--border); border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--bg); overflow: hidden;">
              <span id="logo-preview-placeholder" style="font-size: 11px; color: var(--text-muted);">Belum ada logo</span>
              <img id="logo-preview-img" class="hidden" style="max-height: 48px; max-width: 90%; object-fit: contain;" alt="Logo Preview" />
            </div>
            <div style="flex: 1; min-width: 200px;">
              <input type="file" id="logo_file" accept="image/png, image/jpeg, image/jpg, image/svg+xml" style="display: none;" />
              <button type="button" id="upload-trigger-btn" class="btn btn-outline" style="height: 38px; font-size: 12.5px;">Pilih Gambar</button>
              <span style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 6px;">Format yang didukung: PNG, JPEG, SVG. Ukuran maks: 2MB.</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Pajak -->
      <div>
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 14px; color: var(--text); border-bottom: 1px dashed var(--border); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-percent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
          Perhitungan Pajak (PPN)
        </h3>

        <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg); padding: 14px 18px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 16px;">
          <div>
            <strong style="font-size: 13.5px; display: block; color: var(--text);">Aktifkan PPN / Pajak</strong>
            <span style="font-size: 11.5px; color: var(--text-secondary);">Tampilkan baris pajak PPN saat checkout dan kalkulasikan ke total bayar.</span>
          </div>
          <label class="toggle">
            <input type="checkbox" id="tax_enabled" />
            <span class="toggle-slider"></span>
          </label>
        </div>

        <div class="form-group" id="tax-rate-group">
          <label class="form-label">Besaran Pajak (%)</label>
          <div style="position: relative; display: flex; align-items: center; max-width: 200px;">
            <input type="number" id="tax_rate" class="form-control" min="0" max="100" step="0.1" value="11" />
            <span style="position: absolute; right: 14px; font-size: 14px; font-weight: 600; color: var(--text-muted);">%</span>
          </div>
        </div>
      </div>

      <!-- Section 3: Payment Gateways -->
      <div>
        <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 14px; color: var(--text); border-bottom: 1px dashed var(--border); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-credit-card" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          Metode Pembayaran (Payment Gateway)
        </h3>

        <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.4;">
          Pilih metode pembayaran mana saja yang ingin Anda tampilkan ke customer pada halaman transaksi.
        </p>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <!-- QRIS -->
          <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
              <div style="background: var(--accent-light); padding: 8px; border-radius: 6px; color: var(--accent); display: flex;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
              </div>
              <div>
                <strong style="font-size: 13px; color: var(--text);">Gerbang QRIS (E-Wallet)</strong>
                <span style="font-size: 11px; color: var(--text-muted); display: block;">Mendukung QR Code GoPay, OVO, Dana, LinkAja</span>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="payment_gateway_qris" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- VA / Bank -->
          <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
              <div style="background: var(--accent-light); padding: 8px; border-radius: 6px; color: var(--accent); display: flex;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><path d="m12 2-9 5h18z"/></svg>
              </div>
              <div>
                <strong style="font-size: 13px; color: var(--text);">Virtual Account (Transfer Bank)</strong>
                <span style="font-size: 11px; color: var(--text-muted); display: block;">Mendukung Virtual Account bank-bank nasional utama</span>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="payment_gateway_bank" />
              <span class="toggle-slider"></span>
            </label>
          </div>

          <!-- CC -->
          <div style="display: flex; align-items: center; justify-content: space-between; background: var(--bg); padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border);">
            <div style="display: flex; align-items: center; gap: 10px;">
              <div style="background: var(--accent-light); padding: 8px; border-radius: 6px; color: var(--accent); display: flex;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              </div>
              <div>
                <strong style="font-size: 13px; color: var(--text);">Kartu Kredit (Visa/Mastercard)</strong>
                <span style="font-size: 11px; color: var(--text-muted); display: block;">Mendukung pembayaran langsung kartu kredit/debit</span>
              </div>
            </div>
            <label class="toggle">
              <input type="checkbox" id="payment_gateway_cc" />
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- Action Button -->
      <div style="margin-top: 10px; border-top: 1px solid var(--border); padding-top: 20px; display: flex; justify-content: flex-end;">
        <button type="submit" id="save-btn" class="btn btn-primary" style="height: 44px; padding: 0 32px; font-size: 13.5px;">
          Simpan Pengaturan
        </button>
      </div>

    </form>
  </div>
</AdminLayout>

<script>
  import { apiFetch, getApiUrl } from '../../utils/api';

  const alertBox = document.getElementById('settings-alert-box') as HTMLDivElement;
  const form = document.getElementById('settings-form') as HTMLFormElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  // Form inputs
  const appNameInput = document.getElementById('app_name') as HTMLInputElement;
  const taxEnabledInput = document.getElementById('tax_enabled') as HTMLInputElement;
  const taxRateInput = document.getElementById('tax_rate') as HTMLInputElement;
  const taxRateGroup = document.getElementById('tax-rate-group') as HTMLDivElement;

  const gwQrisInput = document.getElementById('payment_gateway_qris') as HTMLInputElement;
  const gwBankInput = document.getElementById('payment_gateway_bank') as HTMLInputElement;
  const gwCcInput = document.getElementById('payment_gateway_cc') as HTMLInputElement;

  // Logo file upload elements
  const logoFileInput = document.getElementById('logo_file') as HTMLInputElement;
  const uploadTriggerBtn = document.getElementById('upload-trigger-btn') as HTMLButtonElement;
  const logoPreviewPlaceholder = document.getElementById('logo-preview-placeholder') as HTMLSpanElement;
  const logoPreviewImg = document.getElementById('logo-preview-img') as HTMLImageElement;

  let logoBase64 = '';

  function showAlert(msg: string, type: 'success' | 'error') {
    if (!alertBox) return;
    alertBox.className = `alert alert-${type}`;
    alertBox.textContent = msg;
    alertBox.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function hideAlert() {
    alertBox?.classList.add('hidden');
  }

  // Handle Tax Toggle Visibility
  taxEnabledInput?.addEventListener('change', () => {
    if (taxEnabledInput.checked) {
      taxRateInput.disabled = false;
      taxRateGroup.style.opacity = '1';
    } else {
      taxRateInput.disabled = true;
      taxRateGroup.style.opacity = '0.5';
    }
  });

  // Logo upload handling
  uploadTriggerBtn?.addEventListener('click', () => {
    logoFileInput?.click();
  });

  logoFileInput?.addEventListener('change', () => {
    const file = logoFileInput.files?.[0];
    if (!file) return;

    if (file.size > 2 * 1024 * 1024) {
      showAlert('Ukuran file logo terlalu besar. Maksimum 2MB.', 'error');
      logoFileInput.value = '';
      return;
    }

    const reader = new FileReader();
    reader.onload = () => {
      logoBase64 = reader.result as string;
      if (logoPreviewImg && logoPreviewPlaceholder) {
        logoPreviewImg.src = logoBase64;
        logoPreviewImg.classList.remove('hidden');
        logoPreviewPlaceholder.classList.add('hidden');
      }
    };
    reader.readAsDataURL(file);
  });

  // Load Current Settings
  async function loadSettings() {
    try {
      const response = await apiFetch('/api/settings', { requireAuth: false });
      if (response.success && response.data) {
        const settings = response.data;
        
        if (appNameInput) appNameInput.value = settings.app_name || '';
        
        if (taxEnabledInput) {
          taxEnabledInput.checked = settings.tax_enabled !== false;
          if (taxRateInput) {
            taxRateInput.value = settings.tax_rate !== undefined ? String(settings.tax_rate) : '11';
            taxRateInput.disabled = !taxEnabledInput.checked;
            if (taxRateGroup) {
              taxRateGroup.style.opacity = taxEnabledInput.checked ? '1' : '0.5';
            }
          }
        }

        if (gwQrisInput) gwQrisInput.checked = settings.payment_gateway_qris !== false;
        if (gwBankInput) gwBankInput.checked = settings.payment_gateway_bank !== false;
        if (gwCcInput) gwCcInput.checked = settings.payment_gateway_cc !== false;

        if (settings.app_logo && logoPreviewImg && logoPreviewPlaceholder) {
          const apiBaseUrl = getApiUrl();
          logoPreviewImg.src = `${apiBaseUrl}${settings.app_logo}`;
          logoPreviewImg.classList.remove('hidden');
          logoPreviewPlaceholder.classList.add('hidden');
        }
      }
    } catch (err: any) {
      showAlert('Gagal memuat pengaturan sistem: ' + (err.message || err), 'error');
    }
  }

  // Handle Submit Form
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();
    
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Menyimpan...';
    }

    const payload: Record<string, any> = {
      app_name: appNameInput.value.trim(),
      tax_enabled: taxEnabledInput.checked,
      tax_rate: parseFloat(taxRateInput.value) || 0,
      payment_gateway_qris: gwQrisInput.checked,
      payment_gateway_bank: gwBankInput.checked,
      payment_gateway_cc: gwCcInput.checked,
    };

    if (logoBase64) {
      payload.logo_base64 = logoBase64;
    }

    try {
      const response = await apiFetch('/api/settings/admin', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (response.success) {
        showAlert('Pengaturan sistem berhasil disimpan.', 'success');
        // Clear base64 cached variable
        logoBase64 = '';
        // Reload to update dynamic header/footer branding logo instantly!
        setTimeout(() => {
          window.location.reload();
        }, 1500);
      }
    } catch (err: any) {
      showAlert('Gagal menyimpan pengaturan: ' + (err.message || err), 'error');
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Simpan Pengaturan';
      }
    }
  });

  // Init
  loadSettings();
</script>
