      }

      let buttonHtml = '';
      if (isAvailable) {
        const targetUrl = `/checkout?domain=${encodeURIComponent(domain)}${isPremium ? '&is_premium=true' : ''}`;
        buttonHtml = `
          <a href="${targetUrl}" style="color: #ffffff !important;" class="flex sm:inline-flex w-full sm:w-auto items-center justify-center px-5 py-2 text-[14px] font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-full transition-colors active:scale-95 min-w-[100px] h-9">
            Daftarkan
          </a>
        `;
      } else {
        buttonHtml = `
          <a href="/whois?domain=${encodeURIComponent(domain)}" style="color: #d1d5db !important;" class="flex sm:inline-flex w-full sm:w-auto items-center justify-center px-5 py-2 text-[14px] font-semibold text-gray-300 bg-transparent border border-gray-600 hover:border-gray-400 hover:text-white rounded-full transition-colors active:scale-95 min-w-[100px] h-9" target="_blank">
            WHOIS
          </a>
        `;
      }

      card.innerHTML = `
        <div class="flex flex-col sm:flex-row sm:items-center justify-between w-full gap-3 sm:gap-5">
          
          <!-- Mobile Top / Desktop Left: Domain, Badges, (Price & Status on Mobile) -->
