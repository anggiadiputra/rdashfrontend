    function showMockResults(name: string, query: string) {
      resultsContainer.innerHTML = '';
      const mockTLDs = [
        { tld: '.com', available: true },
        { tld: '.net', available: false },
        { tld: '.id', available: true },
        { tld: '.co.id', available: true },
      ];

      const sortedMock = [...mockTLDs].sort((a, b) => {
        const aIsExact = (name + a.tld).toLowerCase() === query.toLowerCase();
        const bIsExact = (name + b.tld).toLowerCase() === query.toLowerCase();
        if (aIsExact && !bIsExact) return -1;
        if (!aIsExact && bIsExact) return 1;
        return 0;
      });

      sortedMock.forEach((item) => {
        const domain = name + item.tld;
        const isExactMatch = domain.toLowerCase() === query.toLowerCase();
        renderHomepageResultRow({ domain, status: item.available ? 'available' : 'registered' }, isExactMatch);
      });
    }

    // Results live filtering handler
    resultsFilterInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const rows = resultsContainer.querySelectorAll('[data-domain-row]');
      rows.forEach(row => {
        const dom = (row as HTMLElement).dataset.domainRow || '';
        if (dom.includes(val)) {
          (row as HTMLElement).style.display = 'flex';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });

    // ── Stats counter animation ──
    const animateCounter = (el: HTMLElement, target: number, duration = 1200) => {
      let start = 0;
      const step = (timestamp: number) => {
        if (!start) start = timestamp;
        const progress = Math.min((timestamp - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target).toString();
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toString();
      };
      requestAnimationFrame(step);
    };

    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const nums = entry.target.querySelectorAll('[data-target]');
          nums.forEach(num => {
            const target = parseInt((num as HTMLElement).dataset.target || '0');
            animateCounter(num as HTMLElement, target);
          });
          statsObserver.disconnect();
        }
      });
    }, { threshold: 0.3 });

    const statsSection = document.querySelector('.stats-section');
    if (statsSection) statsObserver.observe(statsSection);

    // ── Fill extension prices from API cache ──
    const fillExtPrices = () => {
      const extPriceEls = document.querySelectorAll('.ext-price[data-ext]');
      extPriceEls.forEach(el => {
        const ext = (el as HTMLElement).dataset.ext;
        const priceEntry = pricesCache.find((p: any) => p.extension === ext);
        if (priceEntry) {
          const price = priceEntry.registerPrice || priceEntry.price || 0;
          if (price) {
            const formatted = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(price);
            el.textContent = formatted;
          }
        }
      });
    };

    // Try to fill prices after extensions are loaded
    setTimeout(() => {
      if (pricesCache.length > 0) fillExtPrices();
    }, 1500);

    // ── Extension cards click to search ──
    const extCards = document.querySelectorAll('.ext-card[data-ext]');
    extCards.forEach(card => {
      card.addEventListener('click', () => {
        const ext = (card as HTMLElement).dataset.ext || '';
        // Scroll to hero and focus search input
        domainInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          if (domainInput) {
            domainInput.focus();
            domainInput.placeholder = `Ketik nama domain Anda untuk ${ext}...`;
          }
        }, 600);
      });
    });

    // ── CTA Search button scroll ──
    document.getElementById('cta-search-btn')?.addEventListener('click', (e) => {
      e.preventDefault();
      domainInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => domainInput?.focus(), 700);
    });

  </script>

