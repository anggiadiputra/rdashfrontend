---
import Layout from '../layouts/Layout.astro';
import AetherFlowHero from '../components/ui/aether-flow-hero.tsx';
---

<Layout title="Cari & Daftarkan Domain Anda" transparentNav={true}>
  <!-- 1. Hero Search Section with Interactive Canvas Background -->
  <section class="hero-section text-center relative overflow-hidden">
    <!-- Interactive Canvas Background Container -->
    <div class="absolute inset-0 z-0 pointer-events-auto w-full h-full hidden md:block">
      <AetherFlowHero client:only="react" backgroundOnly={true} />
    </div>

    <div class="container hero-container relative z-10">
      <span class="hero-badge">Pencari Domain Tercepat</span>
      <h1 class="hero-title">Temukan Nama Domain Impian Anda Sekarang</h1>
      <p class="hero-subtitle">
        Cari ketersediaan ekstensi domain internasional dan lokal dengan integrasi langsung, aman, dan harga transparan.
      </p>

      <!-- Search Input Container -->
      <form id="search-form" class="search-box card">
        <div class="search-input-wrapper">
          <input
            type="text"
            id="domain-input"
            class="form-control search-input"
            placeholder="Ketikkan nama domain pilihan Anda (misal: bisnissaya)..."
            required
            autocomplete="off"
            autofocus
          />
          <button type="submit" id="search-btn" class="btn btn-primary btn-search">
            Cari Ketersediaan
          </button>
        </div>
      </form>

      <!-- Results Showcase Grid (Dynamically updated by JS) -->
      <div id="search-results-section" class="search-results-section hidden mt-4 text-left mb-16">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 mb-4 border-b border-white/10">
          <h3 class="results-heading" style="font-size: 15px; font-weight: 700; margin: 0; color: #ffffff;">Hasil Pencarian: <span id="target-query" class="text-accent" style="font-family: monospace;"></span></h3>
          
          <!-- Live Search Filter for Results -->
          <div style="position: relative; display: flex; align-items: center; width: 200px; max-width: 100%;" class="w-full sm:w-[200px]">
            <svg class="lucide lucide-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px; position: absolute; left: 10px; color: #9ca3af; pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="homepage-results-filter" class="form-control-compact" placeholder="Saring ekstensi..." style="padding-left: 28px; height: 30px; font-size: 11.5px; width: 100%; border-radius: 6px; background: rgba(31, 41, 55, 0.8); border: 1px solid rgba(75, 85, 99, 0.5); color: #ffffff;" />
          </div>
        </div>

        <div id="results-container" class="scroll-styled" style="display: flex; flex-direction: column; gap: 6px; max-height: 380px; overflow-y: auto; padding-right: 4px;">
          <!-- Dynamic cards go here -->
        </div>
      </div>
    </div>
  </section>


  <!-- 2. Stats / Trust Bar -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-number" data-target="50">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">Ekstensi Domain</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-prefix">Rp</span><span class="stat-number" data-target="15">0</span><span class="stat-suffix">rb</span>
          <span class="stat-label">Harga Mulai Dari</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number" data-target="99">0</span><span class="stat-suffix">.9%</span>
          <span class="stat-label">Uptime Terjamin</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number" data-target="24">0</span><span class="stat-suffix">/7</span>
          <span class="stat-label">Akses Self-Service</span>
        </div>
      </div>
      <div class="trust-badges">
        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          SSL Secured
        </span>
        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Harga Realtime
        </span>

        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
          WHOIS Lookup Gratis
        </span>
      </div>
    </div>
  </section>

  <!-- 3. Features Section (Dark Glassmorphic) -->
  <section class="dark-features-section" style="content-visibility: auto; contain-intrinsic-size: auto 500px;">
    <div class="container">
      <div class="section-header-dark text-center">
        <span class="section-eyebrow">Kenapa Ruangtunggux?</span>
        <h2 class="section-title-dark">Semua yang Anda Butuhkan,<br/><span class="gradient-text">dalam Satu Platform</span></h2>
        <p class="section-subtitle-dark">Dirancang untuk individu dan bisnis yang serius membangun identitas digital mereka.</p>
      </div>

      <div class="dark-features-grid">
        <!-- Feature 1 -->
        <div class="dark-feature-card">
          <div class="dark-feature-num">01</div>
          <div class="dark-feature-icon icon-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <h3 class="dark-feature-title">Portal Mandiri Self-Service</h3>
          <p class="dark-feature-desc">Ubah Nameserver, aktifkan Registrar Lock, dan kelola WHOIS secara mandiri kapan saja tanpa perlu bantuan admin.</p>
          <div class="dark-feature-tags">
            <span class="feat-tag">Nameserver</span>
            <span class="feat-tag">WHOIS</span>
            <span class="feat-tag">DNS Lock</span>
          </div>
        </div>
        <!-- Feature 2 -->
        <div class="dark-feature-card featured-card">
          <div class="featured-glow"></div>
          <div class="dark-feature-num">02</div>
          <div class="dark-feature-icon icon-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 9.7a1 1 0 0 1-.68 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 .76-.97l8-2a1 1 0 0 1 .48 0l8 2A1 1 0 0 1 20 6z"/></svg>
          </div>
          <h3 class="dark-feature-title">Keamanan Berlapis</h3>
          <p class="dark-feature-desc">Sistem autentikasi berlapis wajib OTP via email dan perlindungan bot Cloudflare Turnstile untuk menangkal segala upaya peretasan.</p>
          <div class="dark-feature-tags">
            <span class="feat-tag">OTP Email</span>
            <span class="feat-tag">Turnstile</span>
            <span class="feat-tag">2FA</span>
          </div>
        </div>
        <!-- Feature 3 -->
        <div class="dark-feature-card">
          <div class="dark-feature-num">03</div>
          <div class="dark-feature-icon icon-orange">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="dark-feature-title">Performa Ultra Cepat</h3>
          <p class="dark-feature-desc">Dibangun dengan Astro v5 + TypeScript untuk performa terbaik. Pencarian domain real-time langsung dari registrar tanpa cache usang.</p>
          <div class="dark-feature-tags">
            <span class="feat-tag">Astro v5</span>
            <span class="feat-tag">Real-time API</span>
            <span class="feat-tag">TypeScript</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. How It Works -->
  <section class="how-it-works-section" style="content-visibility: auto; contain-intrinsic-size: auto 400px;">
    <div class="container">
      <div class="section-header-dark text-center">
        <span class="section-eyebrow">Mudah & Cepat</span>
        <h2 class="section-title-dark">Daftar Domain dalam<br/><span class="gradient-text">3 Langkah Mudah</span></h2>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <div class="step-connector"></div>
          <div class="step-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <h4 class="step-title">Cari Domain</h4>
          <p class="step-desc">Ketik nama domain impian Anda dan kami akan cek ketersediaan puluhan ekstensi secara bersamaan.</p>
        </div>
        <div class="step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-connector"></div>
          <div class="step-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h4 class="step-title">Pilih & Bandingkan Harga</h4>
          <p class="step-desc">Lihat harga registrasi, renewal, dan transfer secara transparan. Pilih ekstensi yang paling sesuai budget.</p>
        </div>
        <div class="step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <div class="step-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h4 class="step-title">Daftarkan Sekarang</h4>
          <p class="step-desc">Buat akun, lakukan checkout, dan domain Anda aktif dalam hitungan menit. Mudah dan aman.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Domain Extensions Showcase -->
  <section class="extensions-section" style="content-visibility: auto; contain-intrinsic-size: auto 600px;">
    <div class="container">
      <div class="section-header-dark text-center">
        <span class="section-eyebrow">Pilihan Ekstensi</span>
        <h2 class="section-title-dark">Domain Populer dengan<br/><span class="gradient-text">Harga Kompetitif</span></h2>
        <p class="section-subtitle-dark">Klik ekstensi untuk langsung mencari ketersediaan domain Anda.</p>
      </div>
      <div class="extensions-grid" id="extensions-showcase">
        <div class="ext-card" data-ext=".com">
          <span class="ext-name">.com</span>
          <span class="ext-desc">Global Standard</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".com">Cek Harga</span>
        </div>
        <div class="ext-card ext-featured" data-ext=".id">
          <div class="ext-badge">🇮🇩 Lokal</div>
          <span class="ext-name">.id</span>
          <span class="ext-desc">Indonesia Official</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".id">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".co.id">
          <span class="ext-name">.co.id</span>
          <span class="ext-desc">Bisnis Indonesia</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".co.id">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".net">
          <span class="ext-name">.net</span>
          <span class="ext-desc">Network & Tech</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".net">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".org">
          <span class="ext-name">.org</span>
          <span class="ext-desc">Organisasi</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".org">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".web.id">
          <span class="ext-name">.web.id</span>
          <span class="ext-desc">Web Indonesia</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".web.id">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".my.id">
          <span class="ext-name">.my.id</span>
          <span class="ext-desc">Personal ID</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".my.id">Cek Harga</span>
        </div>
        <div class="ext-card" data-ext=".xyz">
          <span class="ext-name">.xyz</span>
          <span class="ext-desc">Next-Gen Web</span>
          <span class="ext-price-label">Mulai dari</span>
          <span class="ext-price" data-ext=".xyz">Cek Harga</span>
        </div>
      </div>
      <div class="text-center" style="margin-top: 2rem;">
        <a href="/prices" class="btn-see-all">
          Lihat Semua Ekstensi & Harga
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. CTA Section -->
  <section class="cta-section" style="content-visibility: auto; contain-intrinsic-size: auto 300px;">
    <div class="cta-glow-1"></div>
    <div class="cta-glow-2"></div>
    <div class="container cta-content">
      <div class="cta-badge">🚀 Mulai Gratis, Tanpa Kartu Kredit</div>
      <h2 class="cta-title">Amankan Nama Domain Anda<br/>Sebelum Diambil Orang Lain</h2>
      <p class="cta-subtitle">Ribuan nama domain didaftarkan setiap hari. Jangan tunggu sampai nama impian Anda tidak tersedia lagi.</p>
      <div class="cta-actions">
        <a href="#domain-input" class="cta-btn-primary" id="cta-search-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Cari Domain Sekarang
        </a>
        <a href="/prices" class="cta-btn-secondary">
          Lihat Daftar Harga
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
      <div class="cta-trust">
        <span>✓ Tanpa biaya setup</span>
        <span>✓ Harga transparan</span>
        <span>✓ Aktivasi dalam menit</span>
        <span>✓ Support self-service 24/7</span>
      </div>
    </div>
  </section>

  <!-- Client-side script to handle API Integration -->
  <script>
    import { apiFetch } from '../utils/api';

    const searchForm = document.getElementById('search-form') as HTMLFormElement;
    const domainInput = document.getElementById('domain-input') as HTMLInputElement;
    const searchBtn = document.getElementById('search-btn') as HTMLButtonElement;
    const resultsSection = document.getElementById('search-results-section') as HTMLDivElement;
    const targetQuery = document.getElementById('target-query') as HTMLSpanElement;
    const resultsContainer = document.getElementById('results-container') as HTMLDivElement;
    const resultsFilterInput = document.getElementById('homepage-results-filter') as HTMLInputElement;

    let pricesCache: any[] = [];
    let extensionsCache: string[] = ['.com', '.net', '.org', '.id', '.co.id', '.web.id', '.my.id', '.xyz'];
    
    async function loadExtensions() {
      try {
        const res = await apiFetch('/api/domains/prices', { requireAuth: false });
        if (res.success && Array.isArray(res.data) && res.data.length > 0) {
          pricesCache = res.data;
          extensionsCache = res.data.map((p: any) => p.extension);
        }
      } catch (err) {
        console.warn('Failed to load extensions for homepage search:', err);
      }
    }
    loadExtensions();


    // 2. Handle domain check submit
    searchForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (resultsFilterInput) {
        resultsFilterInput.value = '';
      }

      const query = domainInput.value.trim().toLowerCase();
      if (!query) return;

      const cleanName = query.split('.')[0];
      if (cleanName.length < 3) {
        alert('Nama domain minimal terdiri dari 3 karakter.');
        return;
      }
      
      // Update UI state to loading
      searchBtn.disabled = true;
      searchBtn.innerText = 'Mengecek...';
      resultsSection.classList.add('hidden');
      
      try {
        // Show loading skeleton rows
        targetQuery.innerText = cleanName;
        resultsContainer.innerHTML = '';
        resultsSection.classList.remove('hidden');

        extensionsCache.forEach(ext => {
          const skeletonDiv = document.createElement('div');
          skeletonDiv.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-3 sm:p-4 border border-gray-700/20 rounded-xl bg-gray-800/30 gap-3 w-full';
          skeletonDiv.innerHTML = `
            <div style="display:flex; flex-direction:column; gap:8px; width:100%;">
              <div style="height:14px; border-radius:4px; background:rgba(75, 85, 99, 0.5); width:140px; animation: pulse 1.5s ease-in-out infinite;"></div>
              <div style="height:12px; border-radius:4px; background:rgba(75, 85, 99, 0.3); width:90px; animation: pulse 1.5s ease-in-out infinite;"></div>
            </div>
            <div style="height:32px; border-radius:8px; background:rgba(75, 85, 99, 0.5); animation: pulse 1.5s ease-in-out infinite;" class="w-full sm:w-[80px] self-stretch sm:self-center"></div>
          `;
          resultsContainer.appendChild(skeletonDiv);
        });

        // Query all extensions
        const tlds = extensionsCache.join(',');
        const response = await apiFetch(`/api/domains/availability?domainName=${encodeURIComponent(cleanName)}&extensions=${encodeURIComponent(tlds)}`, { requireAuth: false });
        
        resultsContainer.innerHTML = '';

        if (response.success && response.data && response.data.length > 0) {
          // Sort results: if item.domain equals query (e.g. potongqurban.com), put it first
          const sortedData = [...response.data].sort((a, b) => {
            const aIsExact = a.domain.toLowerCase() === query.toLowerCase();
            const bIsExact = b.domain.toLowerCase() === query.toLowerCase();
            if (aIsExact && !bIsExact) return -1;
            if (!aIsExact && bIsExact) return 1;
            return 0;
          });

          sortedData.forEach((item: any) => {
            const isExactMatch = item.domain.toLowerCase() === query.toLowerCase();
            renderHomepageResultRow(item, isExactMatch);
          });
        } else {
          showMockResults(cleanName, query);
        }
      } catch (error) {
        console.error('Failed to perform real domain search, using mock fallback:', error);
        showMockResults(cleanName, query);
      } finally {
        searchBtn.disabled = false;
        searchBtn.innerText = 'Cari Ketersediaan';
      }
    });

    function renderHomepageResultRow(item: any, isExactMatch: boolean = false) {
      const domain = item.domain;
      const isAvailable = item.status === 'available';
      const isPremium = !!item.is_premium;

      const card = document.createElement('div');
      card.setAttribute('data-domain-row', domain.toLowerCase());
      // Clean minimalist row styling
      let rowClasses = 'animate-fade-in-up flex flex-col sm:flex-row sm:items-center justify-between py-4 sm:py-5 px-3 sm:px-5 border-b border-gray-800/60 last:border-0 transition-colors w-full gap-3 sm:gap-5';
      
      if (isExactMatch) {
        // Subtle highlight for exact match
        rowClasses += ' bg-blue-900/10 hover:bg-blue-900/20';
      } else {
        rowClasses += ' hover:bg-gray-800/30';
      }
      card.className = rowClasses;

      // Clean split of domain name & extension for styling
      const dotIndex = domain.indexOf('.');
      const domainNamePart = dotIndex !== -1 ? domain.substring(0, dotIndex) : domain;
      const domainExtPart = dotIndex !== -1 ? domain.substring(dotIndex) : '';

      const pricingObj = pricesCache.find(p => p.extension === domainExtPart);
      const registerPrice1yr = pricingObj?.registerPrice || 0;
      const regularPrice1yr = pricingObj?.regularRegisterPrice || 0;
      const isPromo = !!(pricingObj?.promo);

      let priceHtml = '';
      if (isPremium && item.premium_price > 0) {
        priceHtml = `<span class="text-amber-400 font-semibold text-[14px] sm:text-[16px]">Rp ${item.premium_price.toLocaleString('id-ID')}</span>`;
      } else if (registerPrice1yr > 0) {
        if (isPromo && regularPrice1yr > 0 && registerPrice1yr < regularPrice1yr) {
          priceHtml = `<div class="flex items-center gap-1.5"><span class="line-through text-gray-500 text-[12px]">Rp ${regularPrice1yr.toLocaleString('id-ID')}</span><span class="text-emerald-400 font-semibold text-[14px] sm:text-[16px]">Rp ${registerPrice1yr.toLocaleString('id-ID')}</span></div>`;
        } else {
          priceHtml = `<span class="text-white/90 font-semibold text-[14px] sm:text-[16px]">Rp ${registerPrice1yr.toLocaleString('id-ID')}</span>`;
        }
      }

      let badgesHtml = '';
      if (isPremium) {
        badgesHtml += `<span class="text-[10px] font-bold text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded uppercase tracking-wider">Premium</span>`;
      } else if (isPromo && regularPrice1yr > 0 && registerPrice1yr < regularPrice1yr) {
        badgesHtml += `<span class="text-[10px] font-bold text-emerald-400 border border-emerald-500/30 px-2 py-0.5 rounded uppercase tracking-wider">Promo</span>`;
      }
      if (isExactMatch) {
        badgesHtml += `<span class="text-[10px] font-bold text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded uppercase tracking-wider">Pilihan Anda</span>`;
      }

      let statusHtml = '';
      if (isAvailable) {
        statusHtml = `
          <div class="flex items-center gap-1.5 text-emerald-400 text-[13px] font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"></span>
            Tersedia
          </div>
        `;
      } else {
        statusHtml = `
          <div class="flex items-center gap-1.5 text-gray-400 text-[13px] font-medium">
