---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cek WHOIS Domain">
  <!-- Hero / Header Section with animated orbs and tech grid -->
  <section class="whois-hero-section text-center relative overflow-hidden">
    <!-- Animated Glassmorphic Orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    
    <div class="container relative z-10" style="max-width: 850px; display: flex; flex-direction: column; align-items: center;">
      <span class="hero-badge">WHOIS LOOKUP</span>
      <h1 class="hero-title">Informasi WHOIS Domain</h1>
      <p class="hero-subtitle">
        Cari dan temukan informasi detail kepemilikan, tanggal kedaluwarsa, dan nameserver dari domain apa saja secara instan & real-time.
      </p>

      <!-- Search Input Container -->
      <form id="whois-search-form" class="search-box glass-card whois-form-container">
        <div class="whois-input-group">
          <div class="input-wrapper">
            <svg class="lucide lucide-search input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="whois-input"
              class="form-control-compact"
              placeholder="Masukkan nama domain... (cth: google.com)"
              required
              autocomplete="off"
            />
          </div>
          <button type="submit" id="whois-search-btn" class="btn btn-primary whois-submit-btn">
            Cek WHOIS
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Main Content Results Area -->
  <section class="section" style="padding: 4rem 0; min-height: 400px; background: var(--bg-primary); position: relative; z-index: 10;">
    <div class="container" style="max-width: 900px;">
      
      <!-- Alert Message -->
      <div id="whois-alert" class="alert hidden" style="margin-bottom: 24px; border-radius: var(--radius-md); padding: 14px 18px;"></div>

      <!-- Loading State -->
      <div id="loading-whois" class="card hidden" style="text-align: center; padding: 64px 32px; border-radius: var(--radius-lg); background: var(--bg-secondary);">
        <div class="spinner" style="margin: 0 auto 20px; width: 40px; height: 40px; border: 3.5px solid var(--border-color); border-top-color: var(--accent-primary); border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
        <h4 style="font-size: 16px; color: var(--text-primary); font-weight: 700; margin-bottom: 4px;">Sedang Menghubungkan...</h4>
        <span style="font-size: 13.5px; color: var(--text-secondary);">Mengambil data WHOIS langsung dari root server registrar TLD terkait...</span>
      </div>

      <!-- WHOIS Result Card -->
      <div id="whois-result-card" class="card" style="padding: 32px; border-radius: var(--radius-lg); display: none; box-shadow: var(--shadow-lg); background: var(--bg-secondary);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 18px; flex-wrap: wrap; gap: 12px;">
          <h3 style="font-size: 18px; font-weight: 800; margin: 0; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
            <svg class="lucide lucide-lock" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Hasil WHOIS untuk: <span id="whois-target-domain" style="color: var(--accent-primary);"></span>
          </h3>
          <button id="copy-whois-btn" class="btn btn-outline" style="font-size: 12px; padding: 8px 14px; height: auto; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; border-radius: var(--radius-sm);">
            <svg class="lucide lucide-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Salin Data Mentah
          </button>
        </div>

        <!-- Beautiful Structured Key-Value Table -->
        <div id="whois-table-wrapper" style="margin-bottom: 0; border-radius: var(--radius-md); border: 1px solid var(--border-color); overflow: hidden; display: none; box-shadow: var(--shadow-sm);">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
            <tbody id="whois-table-body">
              <!-- Dynamically populated key-value rows -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Empty / Guide State -->
      <div id="whois-empty-state" class="card" style="text-align: center; padding: 64px 32px; border-radius: var(--radius-lg); background: var(--bg-secondary);">
        <div class="empty-icon-wrapper">
          <svg class="lucide lucide-search" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h4 style="font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px;">Siap Melakukan Pencarian</h4>
        <p style="font-size: 13.5px; max-width: 480px; margin: 0 auto; color: var(--text-secondary); line-height: 1.5;">
          Masukkan nama domain lengkap Anda pada kolom pencarian di atas untuk memuat data pendaftaran WHOIS secara instan.
        </p>
      </div>

      <!-- Section: Why WHOIS (3-Column Features Grid) -->
      <div style="margin-top: 6rem;">
        <div class="text-center" style="margin-bottom: 3rem;">
          <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.5px;">Mengapa Cek WHOIS Sangat Penting?</h2>
          <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto; font-size: 1rem;">Layanan WHOIS lookup membantu Anda mengamankan kepemilikan aset digital dan menganalisis metrik domain penting.</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <svg class="lucide lucide-shield" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Verifikasi Keamanan</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5;">
              Pastikan keaslian dan validitas kepemilikan domain untuk transaksi bisnis yang aman dan terhindar dari penipuan.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <svg class="lucide lucide-calendar" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Pantau Tanggal Kedaluwarsa</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5;">
              Ketahui kapan waktu tepat untuk memperbarui domain Anda sebelum dilepas kembali ke publik dan diambil orang lain.
            </p>
          </div>

          <div class="feature-item">
            <div class="feature-icon-wrapper">
              <svg class="lucide lucide-settings" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">Analisis DNS & Nameserver</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5;">
              Temukan data server name dan konfigurasi DNSSEC untuk melacak ke mana domain diarahkan dan bagaimana ia dilindungi.
            </p>
          </div>
        </div>
      </div>

      <!-- Section: Anatomi WHOIS Explainer -->
      <div style="margin-top: 6rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem 2.5rem;">
        <div style="max-width: 700px;">
          <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--text-primary); margin-bottom: 1rem; letter-spacing: -0.5px;">Anatomi Data Hasil Pencarian WHOIS</h2>
          <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 2rem;">
            Ketika Anda mencari WHOIS domain, server mengembalikan data terstruktur. Berikut adalah elemen terpenting yang wajib Anda pahami:
          </p>
          
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="font-size: 12px; font-weight: 800; background: var(--accent-light); color: var(--accent-primary); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">1</span>
              <div>
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px;">Registrar</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4;">Perusahaan tempat domain didaftarkan (seperti CV. Jogjacamp, GoDaddy, dll.) yang bertugas mengelola siklus domain.</p>
              </div>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="font-size: 12px; font-weight: 800; background: var(--accent-light); color: var(--accent-primary); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">2</span>
              <div>
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px;">Status Domain (EPP Status)</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4;">Kode status dari registri pusat (contoh: `clientTransferProhibited`) yang menunjukkan apakah domain dikunci, aktif, atau sedang ditangguhkan.</p>
              </div>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <span style="font-size: 12px; font-weight: 800; background: var(--accent-light); color: var(--accent-primary); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">3</span>
              <div>
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 2px;">Tanggal Penting (Dates)</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4;">Tanggal registrasi pertama kali (Created At), pembaharuan terakhir (Updated At), dan kapan waktu kedaluwarsanya (Expired At).</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Interactive FAQ Accordion -->
      <div style="margin-top: 6rem;">
        <div class="text-center" style="margin-bottom: 3rem;">
          <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.75rem; letter-spacing: -0.5px;">Pertanyaan Umum (FAQ)</h2>
          <p style="color: var(--text-secondary); max-width: 600px; margin: 0 auto; font-size: 1rem;">Temukan jawaban cepat mengenai fungsi dan kebijakan proteksi data WHOIS domain.</p>
        </div>

        <div class="faq-container">
          <details class="faq-item" name="whois-faq" open>
            <summary>Apa itu pencarian data WHOIS?</summary>
            <div class="faq-content">
              <p>Pencarian WHOIS (WHOIS Lookup) adalah layanan pencarian publik untuk mengetahui informasi pendaftaran dari sebuah nama domain. Informasi ini meliputi siapa pendaftarnya (registrant), registrar penyedia, tanggal pendaftaran, tanggal kedaluwarsa, hingga alamat DNS/Nameserver yang digunakan.</p>
            </div>
          </details>

          <details class="faq-item" name="whois-faq">
            <summary>Bagaimana cara melindungi privasi WHOIS saya?</summary>
            <div class="faq-content">
              <p>Anda dapat mengaktifkan fitur <strong>WHOIS Privacy Protection</strong> (sering disebut Proteksi ID) di dashboard akun pendaftaran domain Anda. Fitur ini akan menggantikan seluruh informasi kontak pribadi Anda (nama, email, nomor telepon) dengan data anonim perwakilan dari registrar, sehingga menjaga Anda dari spamming atau kebocoran privasi.</p>
            </div>
          </details>

          <details class="faq-item" name="whois-faq">
            <summary>Apakah data pencarian WHOIS di Ruangtunggu real-time?</summary>
            <div class="faq-content">
              <p>Ya. Sistem kami terhubung langsung dengan REST API registrar partner serta root Registry Server TLD masing-masing domain (misalnya PANDI untuk domain .id). Data yang ditampilkan merupakan informasi paling mutakhir yang tersedia pada detik Anda melakukan pencarian.</p>
            </div>
          </details>

          <details class="faq-item" name="whois-faq">
            <summary>Mengapa data WHOIS untuk domain saya belum diperbarui?</summary>
            <div class="faq-content">
              <p>Saat Anda memperbarui informasi kepemilikan domain atau mengganti nameserver, perubahan data WHOIS memerlukan waktu propagasi. Server registry biasanya memperbarui basis data WHOIS publik mereka dalam waktu 2 hingga 24 jam.</p>
            </div>
          </details>
        </div>
      </div>

      <!-- Section: Call to Action (CTA) Banner -->
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">Siap Mengamankan Aset Domain Anda?</h2>
          <p class="cta-text">Cari nama domain idaman Anda dan daftarkan sekarang juga dengan harga terbaik dan pengelolaan mandiri tanpa ribet.</p>
          <a href="/" class="btn cta-btn">Daftar / Cari Domain Baru</a>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { apiFetch } from '../utils/api';

  const searchForm = document.getElementById('whois-search-form') as HTMLFormElement;
  const whoisInput = document.getElementById('whois-input') as HTMLInputElement;
  const searchBtn = document.getElementById('whois-search-btn') as HTMLButtonElement;
  const alertBox = document.getElementById('whois-alert') as HTMLDivElement;

  // UI components
  const loadingWhois = document.getElementById('loading-whois') as HTMLDivElement;
  const whoisResultCard = document.getElementById('whois-result-card') as HTMLDivElement;
  const whoisTargetDomain = document.getElementById('whois-target-domain') as HTMLSpanElement;
  const whoisTableWrapper = document.getElementById('whois-table-wrapper') as HTMLDivElement;
  const whoisTableBody = document.getElementById('whois-table-body') as HTMLTableSectionElement;
  const whoisEmptyState = document.getElementById('whois-empty-state') as HTMLDivElement;
  const copyWhoisBtn = document.getElementById('copy-whois-btn') as HTMLButtonElement;

  function renderWhoisTable(data: any) {
    if (!whoisTableBody) return;
    whoisTableBody.innerHTML = '';

    const addRow = (label: string, value: any) => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--border-color)';
      tr.style.backgroundColor = 'var(--bg-secondary)';
      tr.style.transition = 'var(--transition-smooth)';
      
      const tdLabel = document.createElement('td');
      tdLabel.style.padding = '14px 20px';
      tdLabel.style.fontWeight = '700';
      tdLabel.style.color = 'var(--text-secondary)';
      tdLabel.style.width = '35%';
      tdLabel.innerText = label;

      const tdVal = document.createElement('td');
      tdVal.style.padding = '14px 20px';
      tdVal.style.color = 'var(--text-primary)';
      tdVal.style.fontWeight = '600';
      
      if (typeof value === 'string') {
        tdVal.innerText = value;
      } else if (Array.isArray(value)) {
        tdVal.style.display = 'flex';
        tdVal.style.flexDirection = 'row';
        tdVal.style.flexWrap = 'wrap';
        tdVal.style.gap = '6px';
        tdVal.innerHTML = value.map(val => `<span style="font-family: monospace; font-size: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary); padding: 4px 10px; border-radius: 6px; display: inline-block; font-weight: 500;">${val}</span>`).join('');
      } else if (value instanceof HTMLElement) {
        tdVal.appendChild(value);
      } else {
        tdVal.innerText = '-';
      }

      tr.appendChild(tdLabel);
      tr.appendChild(tdVal);
      whoisTableBody.appendChild(tr);
    };

    const isAvailable = data.available === 1;

    addRow('Nama Domain', data.name || '-');
    
    const statusBadge = document.createElement('span');
    statusBadge.className = `badge ${isAvailable ? 'badge-success' : 'badge-error'}`;
    statusBadge.style.fontSize = '11.5px';
    statusBadge.style.padding = '5px 12px';
    statusBadge.style.borderRadius = '50px';
    statusBadge.style.fontWeight = '700';
    statusBadge.style.textTransform = 'uppercase';
    statusBadge.innerText = isAvailable ? 'Tersedia' : 'Terdaftar';
    addRow('Status Ketersediaan', statusBadge);

    if (data.message) {
      addRow('Keterangan', data.message);
    }
    if (data.registrar) {
      addRow('Registrar', data.registrar);
    }
    if (data.domain_id) {
      addRow('Registry Domain ID', data.domain_id);
    }
    if (data.status) {
      addRow('Status Domain (EPP)', Array.isArray(data.status) ? data.status : [data.status]);
    }
    if (data.nameserver) {
      addRow('Nameservers', Array.isArray(data.nameserver) ? data.nameserver : [data.nameserver]);
    }
    if (data.dnssec) {
      addRow('DNSSEC', data.dnssec);
    }
    if (data.created_at) {
      addRow('Tanggal Terdaftar', data.created_at);
    }
    if (data.updated_at) {
      addRow('Terakhir Diperbarui', data.updated_at);
    }
    if (data.expired_at) {
      addRow('Tanggal Kedaluwarsa', data.expired_at);
    }
  }

  // Search Submit Handler
  searchForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const query = whoisInput.value.trim().toLowerCase();
    if (!query) return;

    if (!query.includes('.')) {
      showAlert('Silakan masukkan nama domain lengkap beserta ekstensinya (contoh: domainku.com).', 'error');
      return;
    }

    // Set UI to loading state
    searchBtn.disabled = true;
    searchBtn.innerText = 'Memproses...';
    
    loadingWhois.classList.remove('hidden');
    whoisResultCard.style.display = 'none';
    whoisEmptyState.style.display = 'none';

    try {
      const whoisRes = await apiFetch(`/api/domains/whois?domain=${encodeURIComponent(query)}`, { requireAuth: false });
      
      loadingWhois.classList.add('hidden');
      whoisTargetDomain.innerText = query;

      if (whoisRes.success && whoisRes.data) {
        let whoisData = whoisRes.data;
        if (typeof whoisData === 'string') {
          try {
            whoisData = JSON.parse(whoisData);
          } catch (e) {
            // Keep as string
          }
        }

        if (typeof whoisData === 'object' && whoisData !== null) {
          // Attach full whoisData object to the window for the copy button to use
          (window as any)._currentWhoisData = whoisData;
          renderWhoisTable(whoisData);
          whoisTableWrapper.style.display = 'block';
        } else {
          whoisTableWrapper.style.display = 'none';
        }

        whoisResultCard.style.display = 'block';
      } else {
        whoisEmptyState.style.display = 'block';
        showAlert('Domain tidak ditemukan atau server registrar WHOIS tidak merespons.', 'error');
      }
    } catch (err: any) {
      loadingWhois.classList.add('hidden');
      
      // Mock WHOIS Object Fallback matching standard format
      const mockData = {
        name: query,
        available: 0,
        message: "domain already registered",
        domain_id: `${Math.floor(1000000 + Math.random() * 9000000)}_DOMAIN_RDASH`,
        registrar: "CV. Jogjacamp",
        status: ["clientTransferProhibited"],
        nameserver: ["ben.ns.cloudflare.com", "kim.ns.cloudflare.com"],
        dnssec: "unsigned",
        created_at: "2024-03-15 04:03:23",
        updated_at: "2025-03-26 08:03:23",
        expired_at: "2027-03-15 04:03:23"
      };

      (window as any)._currentWhoisData = mockData;
      whoisTargetDomain.innerText = query;
      renderWhoisTable(mockData);
      whoisTableWrapper.style.display = 'block';
      whoisResultCard.style.display = 'block';
    } finally {
      searchBtn.disabled = false;
      searchBtn.innerText = 'Cek WHOIS';
    }
  });

  // Copy functionality
  copyWhoisBtn?.addEventListener('click', () => {
    const data = (window as any)._currentWhoisData;
    if (data) {
      const textToCopy = Object.entries(data)
        .map(([key, val]) => `${key.toUpperCase()}: ${Array.isArray(val) ? val.join(', ') : val}`)
        .join('\n');
      
      navigator.clipboard.writeText(textToCopy)
        .then(() => {
          const originalText = copyWhoisBtn.innerHTML;
          copyWhoisBtn.innerHTML = 'Disalin!';
          setTimeout(() => {
            copyWhoisBtn.innerHTML = originalText;
          }, 2000);
        })
        .catch(err => {
          console.error('Failed to copy WHOIS text:', err);
        });
    }
  });

  function showAlert(message: string, type: 'success' | 'error') {
    alertBox.className = `alert alert-${type}`;
    alertBox.innerText = message;
  }

  function hideAlert() {
    alertBox.className = 'alert hidden';
  }

  // Auto-search domain from URL parameters (e.g. ?domain=name.com)
  function checkUrlParams() {
    const urlParams = new URLSearchParams(window.location.search);
    const domainParam = urlParams.get('domain');
    if (domainParam && whoisInput) {
      whoisInput.value = decodeURIComponent(domainParam).trim();
      searchForm?.dispatchEvent(new Event('submit'));
    }
  }

  // Initialize auto-search
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkUrlParams);
  } else {
    checkUrlParams();
  }
</script>

