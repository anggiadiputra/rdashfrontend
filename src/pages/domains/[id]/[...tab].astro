  function formatCurrency(amount: number): string {
    return 'Rp' + amount.toLocaleString('id-ID', { minimumFractionDigits: 0, maximumFractionDigits: 0 }).replace(/,/g, '.');
  }

  function updateSummaryTable() {
    const domainDesc = document.getElementById('renew-domain-summary-desc');
    const domainPrice = document.getElementById('renew-domain-summary-price');
    const whoisRow = document.getElementById('renew-whois-summary-row');
    const whoisPrice = document.getElementById('renew-whois-summary-price');
    const totalPriceEl = document.getElementById('renew-total-price');

    if (domainDesc) {
      domainDesc.innerText = `Renew ${domainNameStr} for ${selectedRenewalYears} Year(s)`;
    }
    
    // Look up exact multi-year price if exists, otherwise fallback to flat multiplication
    let calculatedRenewal = renewalUnitPrice * selectedRenewalYears;
    if (renewalPriceObj && renewalPriceObj[String(selectedRenewalYears)]) {
      calculatedRenewal = parseFloat(renewalPriceObj[String(selectedRenewalYears)]);
    }

    if (domainPrice) {
      domainPrice.innerText = formatCurrency(calculatedRenewal);
    }

    let calculatedWhois = 0;
    if (isWhoisProtectionSelected) {
      calculatedWhois = whoisUnitPrice * selectedRenewalYears;
      if (whoisPrice) {
        whoisPrice.innerText = formatCurrency(calculatedWhois);
      }
      whoisRow?.classList.remove('hidden');
    } else {
      whoisRow?.classList.add('hidden');
    }

    const total = calculatedRenewal + calculatedWhois;
    if (totalPriceEl) {
      totalPriceEl.innerText = formatCurrency(total);
    }
  }

  function renderPeriodCards() {
    const container = document.getElementById('period-options-container');
    if (!container) return;

    container.innerHTML = '';
    
    for (let yr = 1; yr <= 10; yr++) {
      const card = document.createElement('div');
      card.className = `period-card ${yr === selectedRenewalYears ? 'active' : ''}`;
      card.dataset.years = String(yr);
      
      // Look up exact multi-year price if exists, otherwise fallback to flat multiplication
      let calculatedPrice = renewalUnitPrice * yr;
      if (renewalPriceObj && renewalPriceObj[String(yr)]) {
        calculatedPrice = parseFloat(renewalPriceObj[String(yr)]);
      }
      const formattedPrice = formatCurrency(calculatedPrice);

      card.innerHTML = `
        <span class="period-card-years">${yr} Year(s)</span>
        <span class="period-card-price">${formattedPrice}</span>
      `;
      
      card.addEventListener('click', () => {
        selectedRenewalYears = yr;
        
        document.querySelectorAll('.period-card').forEach(el => el.classList.remove('active'));
        card.classList.add('active');
        
        updateSummaryTable();
      });

      container.appendChild(card);
    }
  }

