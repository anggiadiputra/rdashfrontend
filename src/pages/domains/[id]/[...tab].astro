  eppGenBtn?.addEventListener('click', () => {
    const lower = 'abcdefghijklmnopqrstuvwxyz';
    const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const numbers = '0123456789';
    const symbols = '@#$!%*';
    const all = lower + upper + numbers + symbols;

    // Pick 1 of each required type to guarantee 100% compliance
    let randStr = '';
    randStr += lower.charAt(Math.floor(Math.random() * lower.length));
    randStr += upper.charAt(Math.floor(Math.random() * upper.length));
    randStr += numbers.charAt(Math.floor(Math.random() * numbers.length));
    randStr += symbols.charAt(Math.floor(Math.random() * symbols.length));

    // Fill the remaining 6 characters from the entire set
    for (let i = 0; i < 6; i++) {
      randStr += all.charAt(Math.floor(Math.random() * all.length));
    }

    // Shuffle the characters properly using Fisher-Yates algorithm
    const arr = randStr.split('');
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = arr[i];
      arr[i] = arr[j];
      arr[j] = temp;
    }
    const finalCode = arr.join('');

    eppInput.value = finalCode;
  });

  eppSaveBtn?.addEventListener('click', async () => {
    const nextCode = eppInput.value.trim();
    
    // Frontend validation
    if (nextCode.length < 8) {
      showAlert('Auth code harus minimal 8 karakter.', 'error');
      return;
    }
    if (!/[A-Za-z]/.test(nextCode) || !/[0-9]/.test(nextCode) || !/[^A-Za-z0-9]/.test(nextCode)) {
      showAlert('Auth code harus mengandung minimal 1 huruf, 1 angka, dan 1 simbol (seperti !, @, #, $, -, _).', 'error');
      return;
    }

    eppSaveBtn.disabled = true;
    eppCancelBtn.disabled = true;
    eppGenBtn.disabled = true;
    eppInput.disabled = true;
    hideAlert();

    try {
      const res = await apiFetch(`/api/domains/${domainId}/auth-code`, {
