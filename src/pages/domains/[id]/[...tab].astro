  contactEditForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!domainId) return;

    const contactId = (document.getElementById('contact-edit-id') as HTMLInputElement).value;
    const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
    const organization = (document.getElementById('contact-org') as HTMLInputElement).value.trim();
    const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
    const voice = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
    const street_1 = (document.getElementById('contact-street') as HTMLInputElement).value.trim();
    const city = (document.getElementById('contact-city') as HTMLInputElement).value.trim();
    const state = (document.getElementById('contact-state') as HTMLInputElement).value.trim();
    const postal_code = (document.getElementById('contact-zip') as HTMLInputElement).value.trim();
    const country_code = (document.getElementById('contact-country') as HTMLInputElement).value.trim().toUpperCase();

    const payload = {
      name,
      organization,
      email,
      voice,
      street_1,
      city,
      state,
      postal_code,
      country_code,
      label: 'Default',
    };

    try {
      const saveBtn = document.getElementById('contact-edit-save-btn') as HTMLButtonElement | null;
      if (saveBtn) saveBtn.disabled = true;
      contactEditDialog?.close();

      const res = await apiFetch(`/api/domains/${domainId}/contacts/${contactId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.success) {
        showModernNotification('Berhasil', 'Informasi kontak domain berhasil diperbarui.', 'success');
        loadDomainDetails();
      } else {
        showModernNotification('Gagal', getFriendlyErrorMessage(res.message || 'Error'), 'error');
      }
    } catch (err: any) {
      showModernNotification('Gagal', getFriendlyErrorMessage(err.message || 'Error'), 'error');
    } finally {
      const saveBtn = document.getElementById('contact-edit-save-btn') as HTMLButtonElement | null;
      if (saveBtn) saveBtn.disabled = false;
    }
  });

  const notifCloseBtn = document.getElementById('notification-close-btn');
  notifCloseBtn?.addEventListener('click', () => {
    const notifDialog = document.getElementById('notification-dialog') as HTMLDialogElement | null;
    notifDialog?.close();
  });

  // Fallback for light-dismiss (clicking the backdrop closes the modal)
  const notificationDialog = document.getElementById('notification-dialog') as HTMLDialogElement | null;
  const dialogs = [suspendDialog, unsuspendDialog, contactEditDialog, notificationDialog];
  dialogs.forEach(dialog => {
    if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isDialogContent) {
          dialog.close();
        }
      });
    }
  });

  // Trigger details loading on mount
  loadDomainDetails();
</script>

