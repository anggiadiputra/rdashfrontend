    if (!btn) return;

    const role = btn.dataset.role;
    const contactId = btn.dataset.contactId;
    if (!role || !contactId) return;

    if (!lastLoadedDomain) return;

    let contactObj: any = null;
    if (role === 'registrant') contactObj = lastLoadedDomain.registrant_contact;
    else if (role === 'admin') contactObj = lastLoadedDomain.admin_contact;
    else if (role === 'tech') contactObj = lastLoadedDomain.tech_contact;
    else if (role === 'billing') contactObj = lastLoadedDomain.billing_contact;

    if (!contactObj) return;

    const roleNames: Record<string, string> = {
      registrant: 'Registrant',
      admin: 'Admin',
      tech: 'Technical',
      billing: 'Billing',
    };

    const roleNameName = document.getElementById('contact-edit-role-name');
    const roleInput = document.getElementById('contact-edit-role') as HTMLInputElement;
    const idInput = document.getElementById('contact-edit-id') as HTMLInputElement;

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const orgInput = document.getElementById('contact-org') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const phoneInput = document.getElementById('contact-phone') as HTMLInputElement;
    const streetInput = document.getElementById('contact-street') as HTMLInputElement;
    const cityInput = document.getElementById('contact-city') as HTMLInputElement;
    const stateInput = document.getElementById('contact-state') as HTMLInputElement;
    const zipInput = document.getElementById('contact-zip') as HTMLInputElement;
    const countryInput = document.getElementById('contact-country') as HTMLInputElement;

    if (roleNameName) roleNameName.innerText = roleNames[role] || role;
    if (roleInput) roleInput.value = role;
    if (idInput) idInput.value = contactId;

    if (nameInput) nameInput.value = contactObj.name || '';
    if (orgInput) orgInput.value = contactObj.organization || '';
    if (emailInput) emailInput.value = contactObj.email || '';
    if (phoneInput) phoneInput.value = contactObj.voice || '';
    if (streetInput) streetInput.value = contactObj.street_1 || '';
    if (cityInput) cityInput.value = contactObj.city || '';
    if (stateInput) stateInput.value = contactObj.state || '';
    if (zipInput) zipInput.value = contactObj.postal_code || '';
    if (countryInput) countryInput.value = contactObj.country_code || contactObj.country || '';

