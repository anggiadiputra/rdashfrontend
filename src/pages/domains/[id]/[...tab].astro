      if (apiSuccess) {
        showForwardingAlert('Domain forwarding berhasil disimpan.', 'success');
        loadForwardingDetails();
      } else {
        const newId = 'mock-fwd-' + Date.now();
        activeForwards.push({
          id: newId,
          from: fromVal,
