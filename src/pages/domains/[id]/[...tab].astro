    renewBtn.disabled = true;
    renewBtn.innerText = 'Loading...';

    try {
      const priceRes = await apiFetch(`/api/domains/prices?extension=${domainExtension}`);
      
      let matchedPrice: any = null;
      if (priceRes && Array.isArray(priceRes)) {
        matchedPrice = priceRes.find((p: any) => p.extension === domainExtension);
      } else if (priceRes && Array.isArray(priceRes.data)) {
        matchedPrice = priceRes.data.find((p: any) => p.extension === domainExtension);
      }

      if (matchedPrice) {
        renewalPriceObj = matchedPrice.renewalByYear || {};
        renewalUnitPrice = renewalPriceObj["1"] !== undefined ? parseFloat(renewalPriceObj["1"]) : (matchedPrice.renewPrice !== undefined ? parseFloat(matchedPrice.renewPrice) : 199000);
        whoisUnitPrice = (matchedPrice.whoisPrice !== undefined && parseFloat(matchedPrice.whoisPrice) > 0)
          ? parseFloat(matchedPrice.whoisPrice)
          : (domainExtension.toLowerCase().endsWith('.id') ? 0 : 15000);
      }
      
      selectedRenewalYears = 1;
      isWhoisProtectionSelected = false;
      
      const isIndonesianTld = domainExtension.toLowerCase().endsWith('.id');
      const whoisSection = document.getElementById('renew-whois-toggle-section');
