  let currentDnssecLoadId = 0;

  async function loadDnssecRecords() {
    if (!domainId) return;
    const loadId = ++currentDnssecLoadId;

    dnssecLoading.classList.remove('hidden');
    dnssecTableWrapper.classList.add('hidden');
    dnssecEmpty.classList.add('hidden');

    try {
      const response = await apiFetch(`/api/domains/${domainId}/dnssec`);
      if (loadId !== currentDnssecLoadId) return;
      dnssecLoading.classList.add('hidden');

      let records = [];
      if (response.success && Array.isArray(response.data)) {
        records = response.data;
      } else if (Array.isArray(response)) {
        records = response;
      }

      if (records.length > 0) {
        dnssecListBody.innerHTML = '';
        dnssecTableWrapper.classList.remove('hidden');

        records.forEach((item: any) => {
          const tr = document.createElement('tr');
          tr.style.borderBottom = '1px solid var(--border-color)';
          tr.innerHTML = `
            <td data-label="Key Tag" style="padding: 10px 12px; font-weight: 500;">${item.key_tag || ''}</td>
            <td data-label="Algoritma" style="padding: 10px 12px;">${item.algorithm || ''}</td>
            <td data-label="Tipe Digest" style="padding: 10px 12px;">${item.digest_type || ''}</td>
            <td data-label="Digest" style="padding: 10px 12px; max-width: 250px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${item.digest || ''}">${item.digest || ''}</td>
            <td data-label="Aksi" style="padding: 10px 12px; text-align: right;">
              <button class="btn-delete-dnssec text-error" data-id="${item.id}" style="background:none; border:none; color:var(--error); cursor:pointer; font-weight:600; font-size:12px;">Hapus</button>
            </td>
          `;
          dnssecListBody.appendChild(tr);
        });

        document.querySelectorAll('.btn-delete-dnssec').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const target = e.target as HTMLButtonElement;
            const dsId = target.getAttribute('data-id') || '';
            if (confirm('Apakah Anda yakin ingin menghapus record DNSSEC ini?')) {
              try {
                target.disabled = true;
                target.innerText = 'Menghapus...';
                showDnssecAlert('', 'hide');
                await apiFetch(`/api/domains/${domainId}/dnssec/${dsId}`, {
                  method: 'DELETE'
                });
                showDnssecAlert('Record DNSSEC berhasil dihapus.', 'success');
                loadDnssecRecords();
              } catch (err: any) {
                showDnssecAlert(err.message || 'Gagal menghapus record DNSSEC.', 'error');
                target.disabled = false;
                target.innerText = 'Hapus';
              }
            }
          });
        });
      } else {
        dnssecEmpty.classList.remove('hidden');
      }
    } catch (err: any) {
      dnssecLoading.classList.add('hidden');
      showMockDnssec();
    }
  }

