  unsuspendDialogForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!domainId) return;

    try {
      if (domainSuspendBtn) domainSuspendBtn.disabled = true;
      unsuspendDialog?.close();
      const res = await apiFetch(`/api/domains/${domainId}/suspended`, {
        method: 'DELETE',
