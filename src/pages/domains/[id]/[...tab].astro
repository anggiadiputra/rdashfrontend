---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Kelola Domain" activeMenu="domains">
  <div id="private-area" class="hidden">
    
    <!-- Header Card -->
    <div class="card mb-4" style="padding: 24px; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: 0 1px 2px rgba(0,0,0,0.02); display: flex; align-items: center; gap: 16px;">
      <a href="/dashboard" class="back-link" style="color: var(--text-secondary); text-decoration: none; display: flex; align-items: center;">
        <svg class="lucide lucide-arrow-left" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      </a>
      <div>
        <h1 id="domain-name" style="font-size: 22px; font-weight: 700; margin: 0 0 8px 0; line-height: 1.2;">Memuat...</h1>
        <div style="display: flex; align-items: center; gap: 12px;">
          <span id="domain-status-badge" class="badge">Memuat...</span>
          <span id="domain-expiry-header" style="font-size: 13px; color: var(--text-secondary); font-weight: 500;"></span>
        </div>
      </div>
      <button id="domain-suspend-btn" class="hidden"></button>
    </div>

    <!-- Notification Alerts -->
    <div id="alert-box" class="alert hidden" style="margin-bottom: 20px;"></div>

    <div id="main-portal-content">
    <!-- Tabs & Panels Card -->
    <div class="card" style="padding: 0; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: 0 1px 2px rgba(0,0,0,0.02); overflow: hidden;">
      <div class="tabs-container" style="border-bottom: 1px solid var(--border-color); padding: 12px 16px; margin-bottom: 0; display: flex; gap: 8px; flex-wrap: wrap; background: #fff;">
        <button class="tab-btn-pill tab-btn active" data-tab="overview">
          <svg class="lucide lucide-globe" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Overview
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="dns">
          <svg class="lucide lucide-network" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8"/><path d="M12 17v4"/><path d="M20.4 10.9c.4.8.6 1.7.6 2.6 0 3.3-2.7 6-6 6-1.7 0-3.2-.7-4.2-1.8"/><path d="M3.6 10.9c-.4.8-.6 1.7-.6 2.6 0 3.3 2.7 6 6 6 1.7 0 3.2-.7 4.2-1.8"/><path d="M12 4a6 6 0 0 1 6 6c0 .8-.2 1.6-.5 2.3"/><path d="M12 4a6 6 0 0 0-6 6c0 .8.2 1.6.5 2.3"/></svg>
          DNS Management
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="nameservers">
          <svg class="lucide lucide-server" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
          Nameserver
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="hosts">
          <svg class="lucide lucide-git-fork" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
          Child Nameserver
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="forwarding">
          <svg class="lucide lucide-arrow-right" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 6 7-6 7"/><path d="M3 12h18"/></svg>
          Forwarding
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="dnssec">
          <svg class="lucide lucide-shield" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          DNSSEC
        </button>
        <button class="tab-btn-pill tab-btn" data-tab="whois">
          <svg class="lucide lucide-info" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          Whois
        </button>
      </div>
      <div class="tab-panels" style="padding: 24px;">

      <!-- ==================== TAB: OVERVIEW ==================== -->
      <div class="tab-panel" id="panel-overview">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; font-size: 13px;">
          
          <!-- Left Col -->
          <div>
            <h3 style="font-size: 15px; font-weight: 600; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 16px; margin-top: 0;">Domain Information</h3>
            <table style="width: 100%; border-collapse: collapse;">
              <tbody>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px; width: 40%;">Registration Date</td>
                  <td style="padding: 12px 0; font-size: 13.5px; color: #1e293b;" id="overview-reg-date">-</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Expiration Date</td>
                  <td style="padding: 12px 0; font-size: 13.5px; color: #1e293b;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <span id="domain-expiry">-</span>
                      <form id="renew-form" style="display:inline-flex; align-items:center; margin:0;">
                        <button type="submit" id="renew-submit-btn" class="btn-renew">
                          Renew
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Theft Protection</td>
                  <td style="padding: 12px 0;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <span id="lock-badge" class="badge badge-success" style="font-size: 11px;">Locked</span>
                      <label class="toggle" title="Toggle Theft Protection" style="margin: 0;">
                        <input type="checkbox" id="lock-toggle-chk" />
                        <span class="toggle-slider"></span>
                      </label>
                    </div>
                  </td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Registrar Lock</td>
                  <td style="padding: 12px 0;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <span id="lock-text-status" class="badge badge-success" style="font-size: 11px;">Locked</span>
                      <label class="toggle" title="Toggle Registrar Lock" style="margin: 0;">
                        <input type="checkbox" id="lock-toggle-btn" />
                        <span id="registrar-lock-track" class="toggle-slider"></span>
                      </label>
                    </div>
                  </td>
                </tr>
                <tr id="row-verification" style="border-bottom: 1px solid #f1f5f9; display: none;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Verification</td>
                  <td style="padding: 12px 0;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <span id="overview-verification" class="badge badge-inactive" style="font-size: 11px;">-</span>
                      <button id="verification-upload-btn" class="btn-outline-sm hidden" style="padding: 2px 10px; font-size: 11px;">Upload Document</button>
                      <button id="verification-resend-btn" class="btn-outline-sm hidden" style="padding: 2px 10px; font-size: 11px; display: inline-flex; align-items: center; gap: 4px;">
                        <svg class="lucide lucide-send" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        Resend Email
                      </button>
                    </div>
                  </td>
                </tr>
                <tr id="row-whois-protection" style="border-bottom: 1px solid #f1f5f9; display: none;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Whois Protection</td>
                  <td style="padding: 12px 0;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                      <span id="whois-text-status" class="badge badge-inactive" style="font-size: 11px;">Inactive</span>
                      
                      <!-- Buy WHOIS button (with Shopping Cart icon) -->
                      <button id="whois-buy-action-btn" class="btn btn-outline hidden" style="padding: 4px 12px; font-size: 11.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; border-color: #cbd5e1; background: transparent; cursor: pointer; border-radius: 4px; color: #334155; height: 26px; line-height: 1;">
                        <svg class="lucide lucide-shopping-cart" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span id="whois-buy-price-label">Buy Rp15.000</span>
                      </button>
                      
                      <!-- Toggle Switch container -->
                      <div id="whois-toggle-container" class="hidden">
                        <label class="toggle" title="Toggle Whois Protection" style="margin: 0;">
                          <input type="checkbox" id="whois-toggle-chk" />
                          <span class="toggle-slider"></span>
                        </label>
                      </div>
                    </div>
                  </td>
                </tr>
                 <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Auth Code</td>
                  <td style="padding: 12px 0;">
                    <!-- Read Mode Container -->
                    <div id="epp-read-container" style="display: flex; align-items: center; gap: 8px;">
                      <span id="epp-code-masked" style="font-family: monospace; font-size: 13.5px; color: #475569; letter-spacing: 1px; margin-right: 4px;">••••••••••</span>
                      <span id="epp-code-text" style="font-family: monospace; font-size: 13px; display:none; color: #1e293b; letter-spacing: 0.5px; margin-right: 4px;"></span>
                      <button id="epp-btn" class="btn-icon" title="Tampilkan Auth Code">
                        <svg class="lucide lucide-eye" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      </button>
                      <button id="epp-copy-btn" class="btn-icon" title="Salin">
                        <svg class="lucide lucide-copy" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      </button>
                      <button id="epp-edit-btn" class="btn-icon" title="Ubah Auth Code">
                        <svg class="lucide lucide-edit" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"/></svg>
                      </button>
                    </div>

                    <!-- Edit/Update Form Container (hidden by default) -->
                    <div id="epp-edit-container" class="hidden" style="display: flex; align-items: center; gap: 8px;">
                      <input type="text" id="epp-input" style="font-family: monospace; font-size: 12.5px; border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 8px; color: #1e293b; width: 140px; height: 26px; outline: none;" placeholder="EPP-x9A1b2" />
                      
                      <!-- Generate random secure code button -->
                      <button id="epp-gen-btn" class="btn-icon" title="Generate Secure EPP Code" style="color: var(--accent-primary, #2563eb);">
                        <svg class="lucide lucide-zap" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                      </button>

                      <!-- Save button -->
                      <button id="epp-save-btn" class="btn-icon" title="Simpan" style="color: #10b981;">
                        <svg class="lucide lucide-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      </button>

                      <!-- Cancel button -->
                      <button id="epp-cancel-btn" class="btn-icon" title="Batal" style="color: #ef4444;">
                        <svg class="lucide lucide-x" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      </button>
                    </div>
                  </td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 12px 0; font-weight: 500; color: #64748b; font-size: 13.5px;">Auto Activation</td>
                  <td style="padding: 12px 0;"><span id="overview-auto-activation" class="badge badge-success" style="font-size: 11px;">On</span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Right Col -->
          <div>
            <h3 style="font-size: 15px; font-weight: 600; color: #0f172a; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 16px; margin-top: 0;">Contact Information</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
              <!-- Registrant -->
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <span style="font-weight: 600; color: #0f172a; font-size: 13.5px;">Registrant</span>
                  <button class="btn-outline-sm contact-edit-btn" data-role="registrant" style="padding: 2px 8px; font-size: 11px;">Edit</button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b; width: 35%;">Name</td>
                    <td id="contact-registrant-name" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Company</td>
                    <td id="contact-registrant-company" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Email</td>
                    <td id="contact-registrant-email" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Phone</td>
                    <td id="contact-registrant-phone" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                </table>
              </div>
              <!-- Admin -->
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <span style="font-weight: 600; color: #0f172a; font-size: 13.5px;">Admin</span>
                  <button class="btn-outline-sm contact-edit-btn" data-role="admin" style="padding: 2px 8px; font-size: 11px;">Edit</button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b; width: 35%;">Name</td>
                    <td id="contact-admin-name" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Company</td>
                    <td id="contact-admin-company" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Email</td>
                    <td id="contact-admin-email" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Phone</td>
                    <td id="contact-admin-phone" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                </table>
              </div>
              <!-- Technical -->
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <span style="font-weight: 600; color: #0f172a; font-size: 13.5px;">Technical</span>
                  <button class="btn-outline-sm contact-edit-btn" data-role="tech" style="padding: 2px 8px; font-size: 11px;">Edit</button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b; width: 35%;">Name</td>
                    <td id="contact-tech-name" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Company</td>
                    <td id="contact-tech-company" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Email</td>
                    <td id="contact-tech-email" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Phone</td>
                    <td id="contact-tech-phone" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                </table>
              </div>
              <!-- Billing -->
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                  <span style="font-weight: 600; color: #0f172a; font-size: 13.5px;">Billing</span>
                  <button class="btn-outline-sm contact-edit-btn" data-role="billing" style="padding: 2px 8px; font-size: 11px;">Edit</button>
                </div>
                <table style="width: 100%; border-collapse: collapse; font-size: 12.5px;">
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b; width: 35%;">Name</td>
                    <td id="contact-billing-name" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Company</td>
                    <td id="contact-billing-company" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Email</td>
                    <td id="contact-billing-email" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                  <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 8px 0; font-weight: 500; color: #64748b;">Phone</td>
                    <td id="contact-billing-phone" style="padding: 8px 0; color: #1e293b;">-</td>
                  </tr>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== TAB: NAMESERVERS ==================== -->
      <div class="tab-panel hidden" id="panel-nameservers">
        <h3 class="mb-4" style="font-size:16px; font-weight:700; margin-top:0;">Nameserver Configuration</h3>
        
        <div style="background: #f9fafb; border-radius: 8px; padding: 20px;">
          <h4 style="font-size: 14px; font-weight: 600; margin: 0 0 12px 0;">Current Nameservers</h4>
          
          <div id="ns-readonly-view">
            <div id="ns1-display" class="hidden" style="background: #fff; border: 1px solid #e5e7eb; padding: 10px 12px; border-radius: 4px; font-family: monospace; font-size: 13px; margin-bottom: 8px;"></div>
