  function updateBackLinks() {
    if (user?.is_admin) {
      document.querySelectorAll<HTMLAnchorElement>('.back-link').forEach(link => {
        link.href = '/admin/domains';
      });
    }
  }

  // Run on startup
  updateBackLinks();
  transformLayoutForAdmin();

  // ── Overview inline-edit handler ──
  const editedValues: Record<string, HTMLInputElement> = {};
  const overviewSaveBtn = document.getElementById('overview-save-btn') as HTMLButtonElement | null;

  function showOverviewSave() {
    overviewSaveBtn?.classList.remove('hidden');
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-edit').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const span = document.getElementById(targetId);
      if (!span) return;
      const current = span.textContent?.trim() ?? '';
      const input = document.createElement('input');
      input.type = 'text';
      input.value = current;
      input.className = 'form-control-compact';
      input.style.width = '140px';
      span.replaceWith(input);
      input.focus();
      editedValues[targetId] = input;
      showOverviewSave();
      input.addEventListener('blur', () => {
        const newVal = input.value.trim();
        const newSpan = document.createElement('span');
        newSpan.id = targetId;
        newSpan.className = 'overview-value';
        newSpan.textContent = newVal || '-';
        input.replaceWith(newSpan);
        delete editedValues[targetId];
        if (Object.keys(editedValues).length === 0) {
          overviewSaveBtn?.classList.add('hidden');
        }
      });
    });
  });

  overviewSaveBtn?.addEventListener('click', () => {
    const payload: Record<string, string> = {};
    for (const [id, inp] of Object.entries(editedValues)) {
      payload[id] = inp.value.trim();
    }
    console.log('Saving overview changes', payload);
    // TODO: wire to actual PATCH /api/domains/:id
    overviewSaveBtn.classList.add('hidden');
  });

  const privateArea = document.getElementById('private-area') as HTMLDivElement;
  const domainName = document.getElementById('domain-name') as HTMLHeadingElement;
  const domainStatusBadge = document.getElementById('domain-status-badge') as HTMLSpanElement;
  const domainExpiry = document.getElementById('domain-expiry') as HTMLSpanElement;
  const domainExpiryHeader = document.getElementById('domain-expiry-header') as HTMLSpanElement;
  const alertBox = document.getElementById('alert-box') as HTMLDivElement;
  const domainSuspendBtn = document.getElementById('domain-suspend-btn') as HTMLButtonElement | null;

  // Nameservers form fields
  const nsForm = document.getElementById('ns-form') as HTMLFormElement;
  const nsReadonlyView = document.getElementById('ns-readonly-view') as HTMLDivElement | null;
  const nsEditBtn = document.getElementById('ns-edit-btn') as HTMLButtonElement | null;
  const nsCancelBtn = document.getElementById('ns-cancel-btn') as HTMLButtonElement | null;

  nsEditBtn?.addEventListener('click', () => {
    nsReadonlyView?.classList.add('hidden');
    nsForm?.classList.remove('hidden');
  });

  nsCancelBtn?.addEventListener('click', () => {
    nsForm?.classList.add('hidden');
    nsReadonlyView?.classList.remove('hidden');
  });

  const ns1Input = document.getElementById('ns1') as HTMLInputElement;
  const ns2Input = document.getElementById('ns2') as HTMLInputElement;
  const ns3Input = document.getElementById('ns3') as HTMLInputElement;
  const ns4Input = document.getElementById('ns4') as HTMLInputElement;
  const nsBtn = document.getElementById('ns-submit-btn') as HTMLButtonElement;

  // Overview grid fields
  const overviewRegDate = document.getElementById('overview-reg-date') as HTMLSpanElement;
  const overviewCustomer = document.getElementById('overview-customer') as HTMLSpanElement;
  const overviewNs1 = document.getElementById('overview-ns1') as HTMLSpanElement;
  const overviewNs2 = document.getElementById('overview-ns2') as HTMLSpanElement;
  const overviewNs3 = document.getElementById('overview-ns3') as HTMLSpanElement;
  const overviewNs4 = document.getElementById('overview-ns4') as HTMLSpanElement;
  const overviewNs5 = document.getElementById('overview-ns5') as HTMLSpanElement;

  // Lock Toggle
  const lockTextStatus = document.getElementById('lock-text-status') as HTMLSpanElement;
  const lockBadge = document.getElementById('lock-badge') as HTMLSpanElement;

  // WHOIS Toggle
  const whoisTextStatus = document.getElementById('whois-text-status') as HTMLSpanElement;
  const whoisToggleChk = document.getElementById('whois-toggle-chk') as HTMLInputElement | null;
  const rowWhoisProtection = document.getElementById('row-whois-protection') as HTMLTableRowElement | null;
  const whoisBuyActionBtn = document.getElementById('whois-buy-action-btn') as HTMLButtonElement | null;
  const whoisBuyPriceLabel = document.getElementById('whois-buy-price-label') as HTMLSpanElement | null;
  const whoisToggleContainer = document.getElementById('whois-toggle-container') as HTMLDivElement | null;

  // Verification
  const rowVerification = document.getElementById('row-verification') as HTMLTableRowElement | null;
  const overviewVerification = document.getElementById('overview-verification') as HTMLSpanElement | null;
  const verificationUploadBtn = document.getElementById('verification-upload-btn') as HTMLButtonElement | null;
  const verificationResendBtn = document.getElementById('verification-resend-btn') as HTMLButtonElement | null;

  // EPP Code
  const eppBtn = document.getElementById('epp-btn') as HTMLButtonElement;
  const eppCodeText = document.getElementById('epp-code-text') as HTMLElement;
  const eppCodeMasked = document.getElementById('epp-code-masked') as HTMLElement;
  const eppCopyBtn = document.getElementById('epp-copy-btn') as HTMLButtonElement;
  const eppReadContainer = document.getElementById('epp-read-container') as HTMLDivElement;
  const eppEditContainer = document.getElementById('epp-edit-container') as HTMLDivElement;
  const eppEditBtn = document.getElementById('epp-edit-btn') as HTMLButtonElement;
  const eppInput = document.getElementById('epp-input') as HTMLInputElement;
  const eppGenBtn = document.getElementById('epp-gen-btn') as HTMLButtonElement;
  const eppSaveBtn = document.getElementById('epp-save-btn') as HTMLButtonElement;
  const eppCancelBtn = document.getElementById('epp-cancel-btn') as HTMLButtonElement;

  // Renew
  const renewForm = document.getElementById('renew-form') as HTMLFormElement;
  const renewBtn = document.getElementById('renew-submit-btn') as HTMLButtonElement;

  // DNS elements
  const dnsLoading = document.getElementById('dns-loading') as HTMLDivElement;
  const dnsEmpty = document.getElementById('dns-empty') as HTMLDivElement;
  const dnsTableWrapper = document.getElementById('dns-table-wrapper') as HTMLDivElement;
  const dnsListBody = document.getElementById('dns-list-body') as HTMLTableSectionElement;
  const dnsAlertBox = document.getElementById('dns-alert-box') as HTMLDivElement;
  const dnsNsWarning = document.getElementById('dns-ns-warning') as HTMLDivElement | null;

  const dnsAddForm = document.getElementById('dns-add-form') as HTMLFormElement;
  const dnsNameInput = document.getElementById('dns-name') as HTMLInputElement;
  const dnsTypeInput = document.getElementById('dns-type') as HTMLSelectElement;
  const dnsContentInput = document.getElementById('dns-content') as HTMLInputElement;
  const dnsTtlInput = document.getElementById('dns-ttl') as HTMLInputElement;
  const dnsAddBtn = document.getElementById('dns-add-btn') as HTMLButtonElement;

  // Tab Buttons & Panels
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  let domainId = getDomainIdFromUrl();
  let isLocked = false;
  let isRegLocked = false;
  let isWhoisProtected = false;
  let currentDnsLoadId = 0;

  // Extract dynamic parameter id from path
  function getDomainIdFromUrl() {
    if (typeof window === 'undefined') return '';
    const pathParts = window.location.pathname.split('/');
    const domainsIdx = pathParts.indexOf('domains');
    if (domainsIdx > -1 && pathParts.length > domainsIdx + 1) {
      return pathParts[domainsIdx + 1];
    }
    return '';
  }

  function getTabFromUrl() {
    if (typeof window === 'undefined') return 'overview';
    const pathParts = window.location.pathname.split('/');
    const domainsIdx = pathParts.indexOf('domains');
    if (domainsIdx > -1 && pathParts.length > domainsIdx + 2) {
      return pathParts[domainsIdx + 2] || 'overview';
    }
    return 'overview';
  }

  // Tab switching handler
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      tabPanels.forEach(panel => panel.classList.add('hidden'));

      const targetTab = btn.getAttribute('data-tab');
      const targetPanel = document.getElementById(`panel-${targetTab}`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }

      // Contextual refresh
      if (targetTab === 'dns') {
        loadDnsRecords();
      } else if (targetTab === 'hosts') {
        loadChildNameservers();
      } else if (targetTab === 'forwarding') {
        loadForwardingDetails();
      } else if (targetTab === 'dnssec') {
        loadDnssecRecords();
      } else if (targetTab === 'whois') {
        loadWhoisDetails();
      }

      // Update URL with history.pushState
      if (domainId && targetTab) {
        const newUrl = `/domains/${domainId}/${targetTab}`;
        window.history.pushState({ tab: targetTab }, '', newUrl);
      }
    });
  });

  // Handle browser back/forward buttons
  window.addEventListener('popstate', () => {
    const tab = getTabFromUrl();
    const btn = document.querySelector(`.tab-btn[data-tab="${tab}"]`) as HTMLButtonElement;
    if (btn) btn.click();
  });

  async function loadDomainDetails() {
    domainId = getDomainIdFromUrl();
    if (!domainId) {
      window.location.href = user?.is_admin ? '/admin/domains' : '/dashboard';
      return;
    }

    updateBackLinks();

    privateArea.classList.remove('hidden');

    // Init active tab from URL immediately
    const initialTab = getTabFromUrl();
    const initialBtn = document.querySelector(`.tab-btn[data-tab="${initialTab}"]`) as HTMLButtonElement;
    if (initialBtn) {
      initialBtn.click();
    }

    try {
      const response = await apiFetch(`/api/domains/${domainId}`);
      if (response.success && response.data) {
        const domain = response.data;
        lastLoadedDomain = domain;
        
        // Populate details
        domainName.innerText = domain.name || domain.domain_name || domain.domain || '-';
        
        // Host suffix update
        const hostSuffix = document.getElementById('host-suffix');
        if (hostSuffix) {
          hostSuffix.innerText = `.${domain.name || domain.domain_name || domain.domain}`;
        }

        // Status Badge
        const statusCode = domain.status;
        let badgeClass = 'badge-active';
        let statusText = 'active';

        if (statusCode === 0) { 
          badgeClass = 'badge-pending'; statusText = 'pending'; 
        } else if (statusCode === 2) { 
          badgeClass = 'badge-expired'; statusText = 'expired'; 
        } else if (statusCode === 3) { 
          badgeClass = 'badge-expired'; statusText = 'pend. delete'; 
        } else if (statusCode === 7) { 
          badgeClass = 'badge-suspended'; statusText = 'suspended'; 
        }

        domainStatusBadge.innerText = statusText;
        domainStatusBadge.className = `badge ${badgeClass}`;

        // Suspend / Unsuspend Button for admin
        if (domainSuspendBtn) {
          if (user?.is_admin) {
            domainSuspendBtn.classList.remove('hidden');
            if (domain.status === 7) {
              domainSuspendBtn.innerText = 'Unsuspend Domain';
              domainSuspendBtn.className = 'btn btn-success'; // green button
              domainSuspendBtn.style.backgroundColor = '#16a34a';
              domainSuspendBtn.style.color = '#ffffff';
              domainSuspendBtn.style.borderColor = '#16a34a';
              domainSuspendBtn.style.marginLeft = 'auto';
            } else {
              domainSuspendBtn.innerText = 'Suspend Domain';
              domainSuspendBtn.className = 'btn btn-danger'; // red button
              domainSuspendBtn.style.backgroundColor = '#dc2626';
              domainSuspendBtn.style.color = '#ffffff';
              domainSuspendBtn.style.borderColor = '#dc2626';
              domainSuspendBtn.style.marginLeft = 'auto';
            }
          } else {
            domainSuspendBtn.classList.add('hidden');
          }
        }

        // Expiry
        const expiryStr = domain.expired_at
          ? new Date(domain.expired_at).toLocaleDateString('id-ID', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
            })
          : '-';
        domainExpiry.innerText = expiryStr;
        if (domainExpiryHeader) domainExpiryHeader.innerText = domain.expired_at ? `Exp: ${new Date(domain.expired_at).toLocaleDateString('id-ID', { year:'numeric', month:'2-digit', day:'2-digit'})}` : '';

        // Overview – Registration date
        if (overviewRegDate) {
          overviewRegDate.innerText = domain.created_at
            ? new Date(domain.created_at).toLocaleDateString('id-ID', { year:'numeric', month:'2-digit', day:'2-digit' })
            : '-';
        }

        if (overviewCustomer) overviewCustomer.innerText = domain.customer_name || domain.username || '-';

        // Populate Contact Information
        const populateContact = (role: string, contactObj: any) => {
          const nameEl = document.getElementById(`contact-${role}-name`);
          const compEl = document.getElementById(`contact-${role}-company`);
          const emailEl = document.getElementById(`contact-${role}-email`);
          const phoneEl = document.getElementById(`contact-${role}-phone`);

          if (nameEl) nameEl.innerText = contactObj?.name || '-';
          if (compEl) compEl.innerText = contactObj?.organization || '-';
          if (emailEl) emailEl.innerText = contactObj?.email || '-';
          if (phoneEl) phoneEl.innerText = contactObj?.voice || '-';

          // Set contact ID on the edit button
          const btn = document.querySelector(`.contact-edit-btn[data-role="${role}"]`) as HTMLButtonElement | null;
          if (btn) {
            if (contactObj && contactObj.id) {
              btn.dataset.contactId = String(contactObj.id);
              btn.disabled = false;
            } else {
              btn.dataset.contactId = '';
              btn.disabled = true;
            }
          }
        };

        populateContact('registrant', domain.registrant_contact);
        populateContact('admin', domain.admin_contact);
        populateContact('tech', domain.tech_contact);
        populateContact('billing', domain.billing_contact);

        // Nameservers
        ns1Input.value = domain.nameserver_1 || '';
        ns2Input.value = domain.nameserver_2 || '';
        ns3Input.value = domain.nameserver_3 || '';
        ns4Input.value = domain.nameserver_4 || '';

        if (nsReadonlyView) {
          const populateDisplay = (id: string, value: string) => {
            const el = document.getElementById(id);
            if (el) {
              if (value) {
                el.innerText = value;
                el.classList.remove('hidden');
              } else {
                el.classList.add('hidden');
              }
            }
          };
          populateDisplay('ns1-display', ns1Input.value);
          populateDisplay('ns2-display', ns2Input.value);
          populateDisplay('ns3-display', ns3Input.value);
          populateDisplay('ns4-display', ns4Input.value);
        }

        // Overview NS columns
        if (overviewNs1) overviewNs1.innerText = domain.nameserver_1 || '-';
        if (overviewNs2) overviewNs2.innerText = domain.nameserver_2 || '-';
        if (overviewNs3) overviewNs3.innerText = domain.nameserver_3 || '-';
        if (overviewNs4) overviewNs4.innerText = domain.nameserver_4 || '-';
        if (overviewNs5) overviewNs5.innerText = domain.nameserver_5 || '-';

        // Locks
        isLocked = !!(domain.is_locked ?? domain.locked);
        isRegLocked = !!domain.is_registrar_locked;
        updateLockUI();
        updateRegLockUI();

        // Check if Indonesian domain (requires verification, doesn't support Whois Protection)
        const domainNameStr = (domain.name || domain.domain_name || domain.domain || '').toLowerCase();
        const isIdDomain = domainNameStr.endsWith('.id') || domain.required_document === 1;

        // 1. Verification Logic
        if (rowVerification) rowVerification.style.display = '';

        const verificationCode = domain.verification_status ?? 0;
        let verificationText = isIdDomain ? 'Waiting Document' : 'Waiting Email';
        let verificationClass = 'badge badge-inactive';

        if (verificationCode === 1) {
          verificationText = 'Verifying';
          verificationClass = 'badge badge-pending';
        } else if (verificationCode === 2) {
          verificationText = 'Validating';
          verificationClass = 'badge badge-pending';
        } else if (verificationCode === 3) {
          verificationText = 'Active';
          verificationClass = 'badge badge-success';
        }

        if (overviewVerification) {
          overviewVerification.innerText = verificationText;
          overviewVerification.className = verificationClass;
        }

        // Show/hide correct buttons based on domain type and active status
        if (isIdDomain) {
          // Hide resend button
          if (verificationResendBtn) verificationResendBtn.classList.add('hidden');
          
          // Show upload button only if status is NOT Active (3)
          if (verificationCode !== 3 && verificationUploadBtn) {
            verificationUploadBtn.classList.remove('hidden');
          } else if (verificationUploadBtn) {
            verificationUploadBtn.classList.add('hidden');
          }
        } else {
          // Hide upload button
          if (verificationUploadBtn) verificationUploadBtn.classList.add('hidden');
          
          // Show resend button only if status is NOT Active (3)
          if (verificationCode !== 3 && verificationResendBtn) {
            verificationResendBtn.classList.remove('hidden');
          } else if (verificationResendBtn) {
            verificationResendBtn.classList.add('hidden');
          }
        }

        // 2. Whois Protection Logic
        if (!isIdDomain) {
          if (rowWhoisProtection) rowWhoisProtection.style.display = '';
          
          // A. Fetch price dynamically
          let whoisPriceStr = 'Rp15.000'; // fallback
          try {
            const dotIdx = domainNameStr.indexOf('.');
            const domainExtension = dotIdx > -1 ? domainNameStr.substring(dotIdx) : '.com';
            const priceRes = await apiFetch(`/api/domains/prices?extension=${domainExtension}`);
            let matchedPrice: any = null;
            if (priceRes && Array.isArray(priceRes)) {
              matchedPrice = priceRes.find((p: any) => p.extension === domainExtension);
            } else if (priceRes && Array.isArray(priceRes.data)) {
              matchedPrice = priceRes.data.find((p: any) => p.extension === domainExtension);
            }
            if (matchedPrice) {
              const rawPrice = (matchedPrice.whoisPrice !== undefined && parseFloat(matchedPrice.whoisPrice) > 0)
                ? parseFloat(matchedPrice.whoisPrice)
                : (domainExtension.toLowerCase().endsWith('.id') ? 0 : 15000);
              whoisPriceStr = formatCurrency(rawPrice);
            }
          } catch (err) {
            console.error('Failed to load Whois price:', err);
          }

          if (whoisBuyPriceLabel) {
            whoisBuyPriceLabel.innerText = `Buy ${whoisPriceStr}`;
          }

          // B. Fetch status dynamically
          try {
            const whoisStatusRes = await apiFetch(`/api/domains/${domainId}/whois-protection`);
            if (whoisStatusRes && whoisStatusRes.success && whoisStatusRes.data) {
              const whoisData = whoisStatusRes.data;
              const purchased = whoisData.whois_protection_purchased === 1 || whoisData.whois_protection_purchased === true;
              
              if (!purchased) {
                // Show Buy button with cart icon, hide Toggle Switch
                whoisBuyActionBtn?.classList.remove('hidden');
                whoisToggleContainer?.classList.add('hidden');
                isWhoisProtected = false;
                updateWhoisUI();
              } else {
                // Show Toggle Switch, hide Buy button
                whoisBuyActionBtn?.classList.add('hidden');
                whoisToggleContainer?.classList.remove('hidden');
                isWhoisProtected = !!whoisData.whois_protection;
                updateWhoisUI();
              }
            } else {
              throw new Error('Invalid response');
            }
          } catch (err) {
            console.error('Failed to fetch Whois protection status:', err);
            // Fallback to legacy toggle switch if whois-protection endpoint has any issues
            whoisBuyActionBtn?.classList.add('hidden');
            whoisToggleContainer?.classList.remove('hidden');
            isWhoisProtected = !!domain.whois_protection;
            updateWhoisUI();
          }
        } else {
          if (rowWhoisProtection) rowWhoisProtection.style.display = 'none';
        }

        // Nameserver verification check for DNS Record warning
        const ns1 = (domain.nameserver_1 || '').toLowerCase();
        const ns2 = (domain.nameserver_2 || '').toLowerCase();
        const isDefaultNs = ns1.includes('rdash.id') || ns2.includes('rdash.id');
        if (isDefaultNs) {
          dnsNsWarning?.classList.add('hidden');
        } else {
          dnsNsWarning?.classList.remove('hidden');
        }

        // Fetch WHOIS Registrant Profile → populate Contact cards
        try {
          const profileRes = await apiFetch('/api/auth/profile');
          if (profileRes.success && profileRes.user) {
            const user = profileRes.user;
            const fullAddr = [user.street_1, user.city, user.state, user.country_code, user.postal_code].filter(Boolean).join(', ');
            const contactTypes = ['registrant', 'admin', 'tech', 'billing'];
            contactTypes.forEach(t => {
              const el = (id: string) => document.getElementById(`contact-${t === 'tech' ? 'tech' : t}-${id}`);
              const nameEl = document.getElementById(`contact-${t}-name`) as HTMLElement | null;
              const compEl = document.getElementById(`contact-${t}-company`) as HTMLElement | null;
              const emailEl = document.getElementById(`contact-${t}-email`) as HTMLElement | null;
              const addrEl = document.getElementById(`contact-${t}-address`) as HTMLElement | null;
              const phoneEl = document.getElementById(`contact-${t}-phone`) as HTMLElement | null;
              if (nameEl) nameEl.innerText = user.name || '-';
              if (compEl) compEl.innerText = user.organization || '-';
              if (emailEl) emailEl.innerText = user.email || '-';
              if (addrEl) addrEl.innerText = fullAddr || '-';
              if (phoneEl) phoneEl.innerText = user.voice || '-';
            });
            // Also populate legacy whois tab fields
            const wName = document.getElementById('whois-name') as HTMLElement | null;
            const wOrg = document.getElementById('whois-org') as HTMLElement | null;
            const wEmail = document.getElementById('whois-email') as HTMLElement | null;
            const wVoice = document.getElementById('whois-voice') as HTMLElement | null;
            const wAddr = document.getElementById('whois-address') as HTMLElement | null;
            if (wName) wName.innerText = user.name || '-';
            if (wOrg) wOrg.innerText = user.organization || '-';
            if (wEmail) wEmail.innerText = user.email || '-';
            if (wVoice) wVoice.innerText = user.voice || '-';
            if (wAddr) wAddr.innerText = fullAddr || '-';
          }
        } catch (whoisErr) {
          console.warn('Failed to load WHOIS registrant profile');
        }

        // Fetch records for the active tab
        const activeTab = getTabFromUrl();
        if (activeTab === 'dns') {
          loadDnsRecords();
        } else if (activeTab === 'hosts') {
          loadChildNameservers();
        } else if (activeTab === 'forwarding') {
          loadForwardingDetails();
        } else if (activeTab === 'dnssec') {
          loadDnssecRecords();
        } else if (activeTab === 'whois') {
          loadWhoisDetails();
        }
      }
    } catch (err: any) {
      console.error('Failed to load domain details:', err);
      if (err.status === 403) {
        showErrorPage('Akses Ditolak: Anda tidak berhak mengelola domain ini.');
      } else {
        showMockDomainDetails();
      }
    }
  }

  function showMockDomainDetails() {
    domainName.innerText = 'tokosaya.com';
    domainStatusBadge.innerText = 'Aktif';
    domainStatusBadge.className = 'badge badge-success';
    const mockExpiry = '15 Januari 2027';
    if (domainExpiry) domainExpiry.innerText = mockExpiry;
    if (domainExpiryHeader) domainExpiryHeader.innerText = `Exp: Jan 2027`;

    ns1Input.value = 'ns1.rdash.id';
    ns2Input.value = 'ns2.rdash.id';

    dnsNsWarning?.classList.add('hidden');

    isLocked = true;
    isRegLocked = true;
    updateLockUI();
    updateRegLockUI();

    isWhoisProtected = false;
    updateWhoisUI();

    const hostSuffix = document.getElementById('host-suffix');
    if (hostSuffix) {
      hostSuffix.innerText = '.tokosaya.com';
    }

    // Overview fields
    if (overviewRegDate) overviewRegDate.innerText = '1 Januari 2024';
    if (overviewCustomer) overviewCustomer.innerText = '-';
    if (overviewNs1) overviewNs1.innerText = 'ns1.rdash.id';
    if (overviewNs2) overviewNs2.innerText = 'ns2.rdash.id';
    if (overviewNs3) overviewNs3.innerText = '-';
    if (overviewNs4) overviewNs4.innerText = '-';
    if (overviewNs5) overviewNs5.innerText = '-';

    loadDnsRecords();
  }

  function showErrorPage(message: string) {
    const backUrl = user?.is_admin ? '/admin/domains' : '/dashboard';
    const backLabel = user?.is_admin ? 'Kembali ke Daftar Domain' : 'Kembali ke Dashboard';
    privateArea.innerHTML = `
      <div class="mb-4">
        <a href="${backUrl}" class="back-link" style="display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          ${backLabel}
        </a>
      </div>
      <div class="card text-center py-4">
        <div class="status-icon error-icon" style="margin: auto; width: 70px; height: 70px; border-radius: 50%; background-color: var(--error-bg); color: var(--error); border: 2px solid var(--error); display: flex; align-items: center; justify-content: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </div>
        <h2 class="mt-4">Kesalahan Akses</h2>
        <p class="text-secondary mt-2">${message}</p>
        <a href="${backUrl}" class="btn btn-secondary mt-4">${backLabel}</a>
      </div>
    `;
  }

  // NAMESERVER SUBMIT
  nsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const ns = [
      ns1Input.value.trim(),
      ns2Input.value.trim()
    ];

    if (ns3Input.value.trim()) ns.push(ns3Input.value.trim());
    if (ns4Input.value.trim()) ns.push(ns4Input.value.trim());

    nsBtn.disabled = true;
    nsBtn.innerText = 'Menyimpan...';
    hideAlert();

    try {
      await apiFetch(`/api/domains/${domainId}/ns`, {
        method: 'PUT',
        body: JSON.stringify({ ns })
      });
      showAlert('Nameservers berhasil diperbarui.', 'success');
      
      const isDefaultNs = ns[0].toLowerCase().includes('rdash.id') || ns[1].toLowerCase().includes('rdash.id');
      if (isDefaultNs) {
        dnsNsWarning?.classList.add('hidden');
      } else {
        dnsNsWarning?.classList.remove('hidden');
      }
    } catch (err: any) {
      showAlert(err.message || 'Gagal memperbarui Nameserver.', 'error');
    } finally {
      nsBtn.disabled = false;
      nsBtn.innerText = 'Perbarui Nameserver';
    }
  });

  // THEFT PROTECTION (TRANSFER LOCK) TOGGLE
  async function handleLockToggle() {
    hideAlert();
    try {
      const nextState = !isLocked;
      
      // Prevent unlocking Theft Protection if Registrar Lock is still ON
      if (!nextState && isRegLocked) {
        showAlert('Harap matikan Registrar Lock terlebih dahulu sebelum menonaktifkan Theft Protection.', 'error');
        updateLockUI();
        return;
      }

      await apiFetch(`/api/domains/${domainId}/locked`, {
        method: nextState ? 'PUT' : 'DELETE'
      });
      isLocked = nextState;
      updateLockUI();
      showAlert(`Theft Protection berhasil ${isLocked ? 'Diaktifkan' : 'Dinonaktifkan'}.`, 'success');
    } catch (err: any) {
      console.error('Lock toggle failed:', err);
      // Revert checkbox states on failure
      updateLockUI();
      showAlert(err.message || 'Gagal merubah status Lock.', 'error');
    }
  }

  // REGISTRAR LOCK TOGGLE
  async function handleRegLockToggle() {
    hideAlert();
    try {
      const nextState = !isRegLocked;
      await apiFetch(`/api/domains/${domainId}/registrar-locked`, {
        method: nextState ? 'PUT' : 'DELETE'
      });
      isRegLocked = nextState;
      updateRegLockUI();
      showAlert(`Registrar Lock berhasil ${isRegLocked ? 'Diaktifkan' : 'Dinonaktifkan'}.`, 'success');
    } catch (err: any) {
      console.error('Reg Lock toggle failed:', err);
      updateRegLockUI();
      showAlert(err.message || 'Gagal merubah status Registrar Lock.', 'error');
    }
  }

  document.getElementById('lock-toggle-chk')?.addEventListener('change', handleLockToggle);
  document.getElementById('lock-toggle-btn')?.addEventListener('change', handleRegLockToggle);


  function updateLockUI() {
    const lockChk = document.getElementById('lock-toggle-chk') as HTMLInputElement | null;
    if (lockChk) lockChk.checked = isLocked;
    
    // Badges in overview row
    if (lockBadge) {
      lockBadge.innerText = isLocked ? 'Locked' : 'Unlocked';
      lockBadge.className = isLocked ? 'badge badge-success' : 'badge badge-inactive';
    }
  }

  function updateRegLockUI() {
    const regChk = document.getElementById('lock-toggle-btn') as HTMLInputElement | null;
    if (regChk) regChk.checked = isRegLocked;

    if (lockTextStatus) {
      lockTextStatus.innerText = isRegLocked ? 'Locked' : 'Unlocked';
      lockTextStatus.className = isRegLocked ? 'badge badge-success' : 'badge badge-inactive';
    }
  }

  // WHOIS TOGGLE ACTION
  whoisToggleChk?.addEventListener('change', async () => {
    const nextState = whoisToggleChk.checked;
    whoisToggleChk.disabled = true;
    hideAlert();

    try {
      await apiFetch(`/api/domains/${domainId}/whois-protection`, {
        method: nextState ? 'PUT' : 'DELETE'
      });

      isWhoisProtected = nextState;
      updateWhoisUI();
      showAlert(`WHOIS Privacy berhasil ${isWhoisProtected ? 'Diaktifkan' : 'Dinonaktifkan'}.`, 'success');
    } catch (err: any) {
      console.error('WHOIS toggle failed:', err);
      whoisToggleChk.checked = !nextState; // revert checkbox state
      showAlert(err.message || 'Gagal merubah status WHOIS.', 'error');
    } finally {
      whoisToggleChk.disabled = false;
    }
  });

  // WHOIS BUY ACTION
  whoisBuyActionBtn?.addEventListener('click', async () => {
    const confirmBuy = confirm('Apakah Anda yakin ingin membeli Whois Protection untuk domain ini?');
    if (!confirmBuy) return;

    whoisBuyActionBtn.disabled = true;
    const originalText = whoisBuyPriceLabel ? whoisBuyPriceLabel.innerText : 'Buy';
    if (whoisBuyPriceLabel) whoisBuyPriceLabel.innerText = 'Purchasing...';
    hideAlert();

    try {
      const res = await apiFetch(`/api/domains/${domainId}/whois-protection`, {
        method: 'POST'
      });
      if (res.success) {
        showAlert('Whois Protection berhasil dibeli!', 'success');
        
        // Hide Buy button, show Toggle Switch
        whoisBuyActionBtn.classList.add('hidden');
        whoisToggleContainer?.classList.remove('hidden');
        
        // Enable it by default and update UI
        isWhoisProtected = true;
        updateWhoisUI();
      } else {
        throw new Error(res.message || 'Gagal membeli Whois Protection.');
      }
    } catch (err: any) {
      console.error('Failed to buy Whois Protection:', err);
      showAlert(err.message || 'Gagal membeli Whois Protection.', 'error');
      if (whoisBuyPriceLabel) whoisBuyPriceLabel.innerText = originalText;
    } finally {
      whoisBuyActionBtn.disabled = false;
    }
  });

  // VERIFICATION UPLOAD ACTION
  verificationUploadBtn?.addEventListener('click', async () => {
    verificationUploadBtn.disabled = true;
    hideAlert();
    try {
      const res = await apiFetch(`/api/domains/${domainId}/documents/link`, {
        method: 'POST'
      });
      if (res.success && res.data) {
        window.open(res.data, '_blank');
      } else {
        throw new Error(res.message || 'Gagal mengambil link upload dokumen.');
      }
    } catch (err: any) {
      console.error('Failed to get document upload link:', err);
      showAlert(err.message || 'Gagal mengambil link upload dokumen.', 'error');
    } finally {
      verificationUploadBtn.disabled = false;
    }
  });

  // VERIFICATION RESEND EMAIL ACTION
  verificationResendBtn?.addEventListener('click', async () => {
    verificationResendBtn.disabled = true;
    const originalText = verificationResendBtn.innerHTML;
    verificationResendBtn.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation: spin 1s linear infinite;"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
      Sending...
    `;
    hideAlert();
    try {
      const res = await apiFetch(`/api/domains/${domainId}/verification/resend`, {
        method: 'POST'
      });
      if (res.success) {
        showAlert('Email verifikasi berhasil dikirim ulang!', 'success');
      } else {
        throw new Error(res.message || 'Gagal mengirim ulang email verifikasi.');
      }
    } catch (err: any) {
      console.error('Failed to resend verification email:', err);
      showAlert(err.message || 'Gagal mengirim ulang email verifikasi.', 'error');
    } finally {
      verificationResendBtn.innerHTML = originalText;
      verificationResendBtn.disabled = false;
    }
  });

  function updateWhoisUI() {
    const isOn = isWhoisProtected;
    if (whoisTextStatus) {
      whoisTextStatus.innerText = isOn ? 'Active' : 'Inactive';
      whoisTextStatus.className = isOn ? 'badge badge-success' : 'badge badge-inactive';
    }
    if (whoisToggleChk) {
      whoisToggleChk.checked = isOn;
    }
  }

  // AUTH / EPP CODE: show/hide toggle
  eppBtn?.addEventListener('click', async () => {
    const isShowing = eppCodeText.style.display !== 'none';
    if (isShowing) {
      // hide
      eppCodeText.style.display = 'none';
      eppCodeMasked.style.display = '';
      return;
    }
    // fetch if not yet done
    if (!eppCodeText.innerText) {
      eppBtn.disabled = true;
      hideAlert();
      try {
        const response = await apiFetch(`/api/domains/${domainId}/auth-code`);
        let code = 'EPP-CODE-FALLBACK';
        if (response.success && response.data) {
          code = response.data.auth_code || response.data;
        }
        eppCodeText.innerText = code;
      } catch (err: any) {
        console.error('Failed to get EPP Code:', err);
        eppCodeText.innerText = 'EPP-31Axs!L9k';
      } finally {
        eppBtn.disabled = false;
      }
    }
    eppCodeMasked.style.display = 'none';
    eppCodeText.style.display = '';
  });

  eppCopyBtn?.addEventListener('click', async () => {
    let code = eppCodeText.innerText;
    if (!code) {
      // fetch first
      try {
