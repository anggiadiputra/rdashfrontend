  // Friendly error message mapper
  function getFriendlyErrorMessage(rawMessage: string): string {
    const msg = rawMessage.toLowerCase();
    
    if (msg.includes('the domain name cannot be updated') || msg.includes('locked')) {
      return 'Domain tidak dapat dimodifikasi karena status domain sedang terkunci (Registrar Lock / Theft Protection aktif). Harap matikan Theft Protection / Registrar Lock terlebih dahulu di halaman overview.';
    }
    
    if (msg.includes('not active') || msg.includes('expired')) {
      return 'Domain tidak aktif atau sudah kedaluwarsa. Perubahan status tidak diizinkan.';
    }

    if (msg.includes('parameter filter query not found')) {
      return 'Gagal memuat data: Filter tidak ditemukan di server.';
    }

    if (msg.includes('not suspended')) {
      return 'Domain saat ini tidak dalam status suspended.';
    }

    return rawMessage.replace('Suspend domain failed:', '').replace('Unsuspend domain failed:', '').trim();
  }

  // Modern notification dialog helper
  function showModernNotification(title: string, message: string, type: 'success' | 'error') {
    const notifDialog = document.getElementById('notification-dialog') as HTMLDialogElement | null;
    const notifTitle = document.getElementById('notification-title');
    const notifMessage = document.getElementById('notification-message');
    const notifIconContainer = document.getElementById('notification-icon-container');

    if (!notifDialog || !notifTitle || !notifMessage || !notifIconContainer) {
      alert(`${title}: ${message}`);
      return;
    }

    notifTitle.innerText = title;
    notifMessage.innerText = message;

    if (type === 'success') {
      notifIconContainer.style.backgroundColor = '#ecfdf5';
      notifIconContainer.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      `;
    } else {
      notifIconContainer.style.backgroundColor = '#fef2f2';
      notifIconContainer.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      `;
    }

    notifDialog.showModal();
  }

  function transformLayoutForAdmin() {
