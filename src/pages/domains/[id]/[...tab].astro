      try {
        await apiFetch(`/api/domains/${domainId}/forwarding`, {
          method: 'POST',
          body: JSON.stringify({ from: fromVal, to: toVal })
        });
        apiSuccess = true;
      } catch (err) {
        console.warn('API call failed, fall back to mock save in UI.');
