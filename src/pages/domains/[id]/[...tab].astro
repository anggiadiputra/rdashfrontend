  async function loadForwardingDetails() {
    if (!domainId) return;
    showForwardingAlert('', 'hide');
    forwardingListBody.innerHTML = '';
    // Reset inputs
    forwardingNewFrom.value = '';
    forwardingNewTo.value = '';

    // Show loading, hide table
    forwardingLoadingEl?.classList.remove('hidden');
    forwardingTableWrap?.classList.add('hidden');

    // Set suffix to domain name
    const currentDomainName = domainName.innerText || 'domain.com';
    if (forwardingNewSuffix) {
      forwardingNewSuffix.innerText = `.${currentDomainName}`;
    }

    try {
      const response = await apiFetch(`/api/domains/${domainId}/forwarding`);
      let list = [];
      if (response.success && Array.isArray(response.data)) {
        list = response.data;
      } else if (Array.isArray(response)) {
        list = response;
      }
      activeForwards = list;
      
      forwardingLoadingEl?.classList.add('hidden');
      forwardingTableWrap?.classList.remove('hidden');

      if (activeForwards.length === 0) {
        forwardingListBody.innerHTML = `
          <tr>
            <td colspan="3" style="padding: 20px; text-align: center; color: var(--text-secondary);">
              Belum ada domain forwarding terkonfigurasi. Klik &quot;+ ADD&quot; untuk menambahkan.
            </td>
          </tr>
        `;
        forwardingAddRow.classList.remove('hidden');
      } else {
        renderForwardingList();
      }
    } catch (err: any) {
      console.warn('Failed to load forwarding details, using mock fallback.');
      forwardingLoadingEl?.classList.add('hidden');
      forwardingTableWrap?.classList.remove('hidden');
      // Load mock forwarding
      activeForwards = [
        {
          id: 'mock-fwd-1',
          from: '@',
          to: 'https://dash.cloudflare.com'
        }
      ];
      renderForwardingList();
    }
  }

  function renderForwardingList() {
    forwardingListBody.innerHTML = '';
    const currentDomainName = domainName.innerText || 'buruburu.biz.id';
    
    activeForwards.forEach((item) => {
      let displayName = currentDomainName;
      if (item.from && item.from !== '@') {
        displayName = `${item.from}.${currentDomainName}`;
      }
      
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid var(--border-color)';
      tr.innerHTML = `
        <td data-label="Your Domain" style="padding: 12px 16px; font-weight: 500;">${displayName}</td>
        <td data-label="Forward To" style="padding: 12px 16px; color: #555;">${item.to}</td>
        <td data-label="Aksi" style="padding: 12px 16px; text-align: right;">
          <button class="btn btn-outline btn-forwarding-delete" data-id="${item.id}" style="border: 1px solid var(--border-color); padding: 6px 10px; border-radius: 4px; background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; color: var(--text-primary);" title="Hapus">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          </button>
        </td>
      `;
      forwardingListBody.appendChild(tr);
    });

    // Add delete event listeners
    document.querySelectorAll('.btn-forwarding-delete').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const id = button.getAttribute('data-id');
        if (!id) return;
        
        if (confirm('Apakah Anda yakin ingin menghapus domain forwarding ini?')) {
          button.disabled = true;
          showForwardingAlert('', 'hide');
          try {
            if (id.startsWith('mock-')) {
              activeForwards = activeForwards.filter(item => item.id !== id);
              renderForwardingList();
              showForwardingAlert('Domain forwarding berhasil dihapus.', 'success');
              return;
            }
            
            await apiFetch(`/api/domains/${domainId}/forwarding/${id}`, {
              method: 'DELETE'
            });
            showForwardingAlert('Domain forwarding berhasil dihapus.', 'success');
            loadForwardingDetails();
          } catch (err: any) {
            showForwardingAlert(err.message || 'Gagal menghapus domain forwarding.', 'error');
            button.disabled = false;
          }
        }
      });
    });
  }

