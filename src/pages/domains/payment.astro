---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Pembayaran Domain" activeMenu="domains">
  <div class="container" style="max-width: 1000px; padding: 0 0 40px;">
    
    <!-- State 1: Invoice Checkout -->
    <div id="checkout-state">
      <div style="margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px;">
        <h1 class="page-title" style="font-size: 22px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
          <svg class="lucide lucide-credit-card" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
          Invoice Pembayaran Domain
        </h1>
        <p class="page-subtitle" style="font-size: 13px; color: var(--text-secondary); margin-top: 4px;">
          Selesaikan pembayaran Anda untuk mengaktifkan domain secara instan.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: start;">
        
        <!-- LEFT: Payment Methods -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
          
          <!-- Order Summary Card -->
          <div class="card" style="padding: 24px !important; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-color);">
            <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); border-bottom: 1px dashed var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 6px;">
              <svg class="lucide lucide-package" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              Rincian Domain
            </h3>
            
            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-secondary);">Nama Domain:</span>
                <strong id="summary-domain" style="font-family: monospace; font-size: 14px; color: var(--accent-primary);">loading...</strong>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-secondary);">Durasi Pendaftaran:</span>
                <span id="summary-years" style="font-weight: 600;">-</span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-secondary);">Nameserver Bawaan:</span>
                <span id="summary-ns" style="font-size: 11.5px; font-family: monospace; text-align: right;">-</span>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                <span style="color: var(--text-secondary);">Status Tagihan:</span>
                <span class="badge badge-pending" style="font-size: 10px; text-transform: uppercase;">BELUM BAYAR</span>
              </div>
            </div>
          </div>

          <!-- Payment Options Card -->
          <div class="card" style="padding: 24px !important; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-color);">
            <h3 style="font-size: 14px; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
              <svg class="lucide lucide-shield-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 11 2 2 4-4"/></svg>
              Pilih Metode Pembayaran
            </h3>
            
            <!-- Tabs / Options Grid -->
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;">
              
              <!-- QRIS Option -->
              <div class="payment-method-pill active" id="pay-qris" data-method="qris">
                <svg class="lucide lucide-smartphone" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 4px;"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                <span style="font-weight: 700; font-size: 11.5px;">QRIS</span>
                <span style="font-size: 9px; color: var(--text-muted); margin-top: 2px;">Instan & Otomatis</span>
              </div>

              <!-- Bank Transfer Option -->
              <div class="payment-method-pill" id="pay-bank" data-method="bank">
                <svg class="lucide lucide-landmark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 4px;"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><path d="m12 2-9 5h18z"/></svg>
                <span style="font-weight: 700; font-size: 11.5px;">Virtual Account</span>
                <span style="font-size: 9px; color: var(--text-muted); margin-top: 2px;">BCA, Mandiri, BNI</span>
              </div>

              <!-- Credit Card Option -->
              <div class="payment-method-pill" id="pay-cc" data-method="cc">
                <svg class="lucide lucide-credit-card" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 4px;"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                <span style="font-weight: 700; font-size: 11.5px;">Kartu Kredit</span>
                <span style="font-size: 9px; color: var(--text-muted); margin-top: 2px;">Visa, Mastercard</span>
              </div>
            </div>

            <!-- Content Area for payment options -->
            <div id="method-qris-content" class="payment-details-box">
              <div style="display: flex; gap: 20px; align-items: center;">
                <div style="background: #ffffff; padding: 12px; border-radius: 10px; border: 1.5px solid #e5e7eb; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                  <!-- Mock QR Code SVG -->
                  <svg width="120" height="120" viewBox="0 0 100 100" style="color: #000000;">
                    <!-- Border and corners -->
                    <rect x="0" y="0" width="22" height="22" fill="currentColor"/>
                    <rect x="2" y="2" width="18" height="18" fill="#ffffff"/>
                    <rect x="5" y="5" width="12" height="12" fill="currentColor"/>
                    
                    <rect x="78" y="0" width="22" height="22" fill="currentColor"/>
                    <rect x="80" y="2" width="18" height="18" fill="#ffffff"/>
                    <rect x="83" y="5" width="12" height="12" fill="currentColor"/>

                    <rect x="0" y="78" width="22" height="22" fill="currentColor"/>
                    <rect x="2" y="80" width="18" height="18" fill="#ffffff"/>
                    <rect x="5" y="83" width="12" height="12" fill="currentColor"/>

                    <!-- Random QR pixels to look real -->
                    <rect x="30" y="5" width="8" height="8" fill="currentColor"/>
                    <rect x="42" y="12" width="10" height="4" fill="currentColor"/>
                    <rect x="60" y="2" width="6" height="15" fill="currentColor"/>
                    <rect x="35" y="25" width="14" height="6" fill="currentColor"/>
                    <rect x="55" y="28" width="8" height="12" fill="currentColor"/>
                    <rect x="72" y="32" width="12" height="6" fill="currentColor"/>
                    <rect x="15" y="35" width="6" height="18" fill="currentColor"/>
                    <rect x="2" y="60" width="25" height="4" fill="currentColor"/>
                    <rect x="32" y="45" width="16" height="16" fill="currentColor"/>
                    <rect x="52" y="55" width="10" height="10" fill="currentColor"/>
                    <rect x="68" y="48" width="22" height="22" fill="currentColor"/>
                    <rect x="72" y="52" width="14" height="14" fill="#ffffff"/>
                    <rect x="75" y="55" width="8" height="8" fill="currentColor"/>
                    
                    <rect x="35" y="72" width="15" height="6" fill="currentColor"/>
                    <rect x="55" y="75" width="12" height="14" fill="currentColor"/>
                    <rect x="72" y="82" width="18" height="6" fill="currentColor"/>
                    <rect x="30" y="88" width="6" height="8" fill="currentColor"/>
                  </svg>
                </div>
                <div style="flex: 1; font-size: 12px; line-height: 1.5;">
                  <strong style="display: block; font-size: 13.5px; margin-bottom: 6px; color: var(--text-primary);">Pembayaran via QRIS Instan</strong>
                  <p class="text-secondary" style="margin-bottom: 8px;">Scan kode QR di samping menggunakan aplikasi e-Wallet pilihan Anda (GoPay, OVO, Dana, LinkAja) atau m-Banking Anda.</p>
                  <div style="display: flex; align-items: center; gap: 6px; font-weight: 700; color: var(--accent-primary);">
                    <div class="pulse-dot"></div>
                    <span>Menunggu pembayaran otomatis...</span>
                  </div>
                </div>
              </div>
            </div>

            <div id="method-bank-content" class="payment-details-box hidden">
              <div style="font-size: 13px;">
                <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-primary); border: 1px solid var(--border-color); padding: 12px 16px; border-radius: 8px; margin-bottom: 12px;">
                  <div>
                    <span style="font-size: 10px; text-transform: uppercase; color: var(--text-muted); display: block; font-weight: 700;">Mandiri Virtual Account</span>
                    <strong style="font-size: 16px; font-family: monospace; letter-spacing: 0.5px; color: var(--text-primary);" id="va-number">80227 081298457631</strong>
                  </div>
                  <button id="copy-va-btn" class="btn btn-outline" style="height: 32px; font-size: 11px; padding: 0 10px;">Salin VA</button>
                </div>
                
                <p style="font-weight: 700; font-size: 12px; margin-bottom: 8px; color: var(--text-primary);">Cara Pembayaran:</p>
                <ol style="margin-left: 18px; line-height: 1.6; color: var(--text-secondary); font-size: 12px; display: flex; flex-direction: column; gap: 4px;">
                  <li>Masuk ke Mandiri Online / m-Banking Mandiri.</li>
                  <li>Pilih menu <strong>Bayar &rarr; Multipayment</strong>.</li>
                  <li>Masukkan kode perusahaan <strong>80227</strong> (Ruangtunggu Billing).</li>
                  <li>Masukkan Nomor Virtual Account di atas dan klik Lanjut.</li>
                  <li>Detail tagihan Anda akan muncul. Konfirmasi dan masukkan PIN Anda.</li>
                </ol>
              </div>
            </div>

            <div id="method-cc-content" class="payment-details-box hidden">
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 11px; margin-bottom: 4px;">Nama Pemegang Kartu</label>
                  <input type="text" class="form-control" placeholder="John Doe" style="height: 38px; font-size: 12.5px;" />
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label" style="font-size: 11px; margin-bottom: 4px;">Nomor Kartu Kredit</label>
                  <input type="text" class="form-control" placeholder="4111 2222 3333 4444" style="height: 38px; font-size: 12.5px;" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                  <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label" style="font-size: 11px; margin-bottom: 4px;">Masa Berlaku (MM/YY)</label>
                    <input type="text" class="form-control" placeholder="12/29" style="height: 38px; font-size: 12.5px;" />
                  </div>
                  <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label" style="font-size: 11px; margin-bottom: 4px;">CVV / CVC</label>
                    <input type="text" class="form-control" placeholder="123" style="height: 38px; font-size: 12.5px;" />
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- RIGHT: Billing Invoice Summary -->
        <div class="card" style="padding: 28px !important; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-color); box-shadow: var(--shadow-md); position: sticky; top: 70px;">
          <h3 style="font-size: 15px; font-weight: 700; margin-bottom: 18px; color: var(--text-primary); display: flex; align-items: center; gap: 6px; border-bottom: 1px dashed var(--border-color); padding-bottom: 10px;">
            <svg class="lucide lucide-credit-card" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            Ringkasan Pembayaran
          </h3>

          <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-secondary);">Harga Domain (<span id="calc-years-display">1 thn</span>):</span>
              <span id="price-base" style="font-weight: 600; color: var(--text-primary);">Rp 0</span>
            </div>
            
            <div id="promo-saving-row" class="hidden" style="display: flex; justify-content: space-between;">
              <span style="color: #ef4444; font-weight: 600;">Diskon Promo:</span>
              <span id="price-saving" style="font-weight: 600; color: #ef4444;">-Rp 0</span>
            </div>

            <div id="tax-row" style="display: flex; justify-content: space-between;">
              <span id="tax-label" style="color: var(--text-secondary);">PPN / Tax (11%):</span>
              <span id="price-tax" style="font-weight: 600; color: var(--text-primary);">Rp 0</span>
            </div>


            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--text-secondary);">Biaya Gerbang / Admin:</span>
              <span id="price-admin" style="font-weight: 600; color: var(--text-primary);">Rp 2.500</span>
            </div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <span style="font-size: 14px; font-weight: 700; color: var(--text-primary);">Total Bayar:</span>
            <strong id="price-total" style="font-size: 20px; font-weight: 800; color: var(--accent-primary);">Rp 0</strong>
          </div>

          <button id="pay-confirm-btn" class="btn btn-primary" style="width: 100%; height: 46px; font-weight: 700; font-size: 14px; border-radius: 8px; justify-content: center; box-shadow: 0 4px 14px rgba(79, 70, 229, 0.2);">
            Bayar & Aktifkan Domain
          </button>
          
          <a href="/" class="btn btn-outline" style="width: 100%; height: 42px; font-weight: 600; font-size: 12.5px; border-radius: 8px; justify-content: center; margin-top: 10px;">
            Batal & Kembali
          </a>
        </div>

      </div>
    </div>

    <!-- State 2: Processing state -->
    <div id="processing-state" class="state-center hidden" style="padding: 80px 0;">
      <div class="spinner" style="width: 48px; height: 48px; border-width: 3px; border-top-color: var(--accent-primary);"></div>
      <h2 style="font-size: 18px; font-weight: 800; margin-top: 24px; color: var(--text-primary);">Menyinkronkan Pembayaran & Mendaftarkan Domain...</h2>
      <p style="color: var(--text-secondary); max-width: 450px; margin: 8px auto 0; font-size: 13px; line-height: 1.5;">
        Mohon jangan menutup atau memuat ulang halaman ini. Kami sedang memproses transaksi Anda ke registry domain global secara aman.
      </p>
    </div>

    <!-- State 3: Success state -->
    <div id="success-state" class="state-center hidden" style="padding: 60px 0;">
      <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(16, 185, 129, 0.1); color: #10b981; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; border: 2px solid rgba(16, 185, 129, 0.2);">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2 style="font-size: 22px; font-weight: 800; color: var(--text-primary);">Pendaftaran Domain Berhasil!</h2>
      <p style="color: var(--text-secondary); max-width: 500px; margin: 8px auto 24px; font-size: 13.5px; line-height: 1.6;">
        Pembayaran Anda berhasil diverifikasi. Domain <strong id="success-domain" style="font-family: monospace; color: var(--accent-primary);">loading...</strong> telah terdaftar secara resmi dan aktif di sistem registry.
      </p>
      
      <div class="card" style="max-width: 550px; margin: 0 auto 28px; text-align: left; padding: 20px !important; border-radius: 10px; border: 1px solid var(--border-color); background: var(--bg-secondary);">
        <h4 style="font-size: 12.5px; font-weight: 700; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
          <svg class="lucide lucide-lightbulb" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A5 5 0 0 0 8 8c0 1 .3 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
          Langkah Selanjutnya:
        </h4>
        <ul style="margin-left: 18px; font-size: 12.5px; color: var(--text-secondary); display: flex; flex-direction: column; gap: 6px; line-height: 1.5;">
          <li>Masa aktif domain Anda telah dikonfigurasi selama <strong id="success-years">-</strong>.</li>
          <li>Nameservers Anda diatur ke <strong id="success-ns-display" style="font-family: monospace;">Loading...</strong>.</li>
          <li>Anda dapat langsung mengonfigurasi **DNS Records** (A, CNAME, TXT) atau mengubah **Nameserver** secara instan melalui dashboard pengelolaan domain Anda.</li>
        </ul>
      </div>

      <div style="display: flex; gap: 12px; justify-content: center;">
        <a href="/dashboard" class="btn btn-primary" style="padding: 0.65rem 1.75rem; font-weight: 600;">Kembali ke Dashboard</a>
        <a href="/" class="btn btn-outline" style="padding: 0.65rem 1.5rem; font-weight: 600;">Daftar Domain Lain</a>
      </div>
    </div>

    <!-- State 4: Error state -->
    <div id="error-state" class="state-center hidden" style="padding: 60px 0;">
      <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(239, 68, 68, 0.1); color: #ef4444; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24px; border: 2px solid rgba(239, 68, 68, 0.2);">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </div>
      <h2 style="font-size: 20px; font-weight: 800; color: var(--text-primary);">Pendaftaran Domain Gagal</h2>
      <p id="error-message-display" style="color: var(--text-secondary); max-width: 500px; margin: 8px auto 24px; font-size: 13.5px; line-height: 1.6;">
        Pembayaran Anda berhasil dikonfirmasi, tetapi pendaftaran domain ditolak oleh registry global.
      </p>

      <div style="display: flex; gap: 12px; justify-content: center;">
        <button id="error-retry-btn" class="btn btn-primary" style="padding: 0.65rem 1.75rem; font-weight: 600;">Coba Hubungkan Ulang</button>
        <a href="/" class="btn btn-outline" style="padding: 0.65rem 1.5rem; font-weight: 600;">Kembali ke Pendaftaran</a>
      </div>
    </div>

  </div>
</DashboardLayout>

<script>
  import { apiFetch } from '../../utils/api';
  import { requireLogin } from '../../utils/auth';

  requireLogin();

  const checkoutState = document.getElementById('checkout-state') as HTMLDivElement;
  const processingState = document.getElementById('processing-state') as HTMLDivElement;
  const successState = document.getElementById('success-state') as HTMLDivElement;
  const errorState = document.getElementById('error-state') as HTMLDivElement;

  const summaryDomain = document.getElementById('summary-domain') as HTMLSpanElement;
  const summaryYears = document.getElementById('summary-years') as HTMLSpanElement;
  const summaryNS = document.getElementById('summary-ns') as HTMLSpanElement;

  const calcYearsDisplay = document.getElementById('calc-years-display') as HTMLSpanElement;
  const priceBase = document.getElementById('price-base') as HTMLSpanElement;
  const promoSavingRow = document.getElementById('promo-saving-row') as HTMLDivElement;
  const priceSaving = document.getElementById('price-saving') as HTMLSpanElement;
  const priceTax = document.getElementById('price-tax') as HTMLSpanElement;
  const priceTotal = document.getElementById('price-total') as HTMLSpanElement;

  const payConfirmBtn = document.getElementById('pay-confirm-btn') as HTMLButtonElement;
  const errorRetryBtn = document.getElementById('error-retry-btn') as HTMLButtonElement;
  const errorMsgDisplay = document.getElementById('error-message-display') as HTMLParagraphElement;

  const successDomain = document.getElementById('success-domain') as HTMLSpanElement;
  const successYears = document.getElementById('success-years') as HTMLSpanElement;
  const successNsDisplay = document.getElementById('success-ns-display');

  // Retrieve checkout data from sessionStorage
  let checkoutData: any = null;
  
  let systemSettings: any = {
    tax_enabled: true,
    tax_rate: 11,
    payment_gateway_qris: true,
    payment_gateway_bank: true,
    payment_gateway_cc: true
  };

  async function loadSystemSettings() {
    try {
      const res = await apiFetch('/api/settings', { requireAuth: false });
      if (res && res.success && res.data) {
        systemSettings = res.data;
      }
    } catch (e) {
      console.warn('Failed to load settings in payment.astro:', e);
    }
  }

  async function loadCheckoutData() {
    try {
      await loadSystemSettings();
      const dataStr = sessionStorage.getItem('pending_domain_checkout');
      if (!dataStr) {
        window.location.href = '/';
        return;
      }
      checkoutData = JSON.parse(dataStr);
      populateInvoice();
    } catch (e) {
      console.error('Failed to parse checkout item:', e);
      window.location.href = '/';
    }
  }


  function populateInvoice() {
    if (!checkoutData) return;

    const fullDomain = `${checkoutData.domainName}.${checkoutData.domainExtension}`;
    summaryDomain.innerText = fullDomain;
    summaryYears.innerText = `${checkoutData.years} Tahun`;
    summaryNS.innerHTML = checkoutData.ns && checkoutData.ns.length > 0 
      ? checkoutData.ns.join('<br>') 
      : '<em>Default (Bawaan Reseller)</em>';

    calcYearsDisplay.innerText = `${checkoutData.years} thn`;

    // Pricing calculation
    const basePrice = checkoutData.regularPrice || checkoutData.price;
    const finalPrice = checkoutData.price;
    const saving = basePrice - finalPrice;

    priceBase.innerText = 'Rp ' + basePrice.toLocaleString('id-ID');
    if (saving > 0) {
      promoSavingRow.classList.remove('hidden');
      priceSaving.innerText = '-Rp ' + saving.toLocaleString('id-ID');
    } else {
      promoSavingRow.classList.add('hidden');
    }

    const taxRatePercent = systemSettings.tax_enabled ? (systemSettings.tax_rate || 0) : 0;
    const tax = Math.round(finalPrice * (taxRatePercent / 100));
    const admin = 2500;
    const grandTotal = finalPrice + tax + admin;

    const taxRow = document.getElementById('tax-row');
    const taxLabel = document.getElementById('tax-label');

    if (systemSettings.tax_enabled) {
      if (taxRow) taxRow.style.display = 'flex';
      if (taxLabel) taxLabel.textContent = `PPN / Tax (${taxRatePercent}%):`;
      priceTax.innerText = 'Rp ' + tax.toLocaleString('id-ID');
    } else {
      if (taxRow) taxRow.style.display = 'none';
      priceTax.innerText = 'Rp 0';
    }
    priceTotal.innerText = 'Rp ' + grandTotal.toLocaleString('id-ID');

    // Apply payment gateway availability
    const payQrisPill = document.getElementById('pay-qris') as HTMLElement;
    const payBankPill = document.getElementById('pay-bank') as HTMLElement;
    const payCcPill = document.getElementById('pay-cc') as HTMLElement;

    let qrisEnabled = systemSettings.payment_gateway_qris !== false;
    let bankEnabled = systemSettings.payment_gateway_bank !== false;
    let ccEnabled = systemSettings.payment_gateway_cc !== false;

    if (payQrisPill) payQrisPill.style.display = qrisEnabled ? 'flex' : 'none';
    if (payBankPill) payBankPill.style.display = bankEnabled ? 'flex' : 'none';
    if (payCcPill) payCcPill.style.display = ccEnabled ? 'flex' : 'none';

    // Auto-select the first active payment gateway
    const pills = [
      { el: payQrisPill, name: 'qris', enabled: qrisEnabled },
      { el: payBankPill, name: 'bank', enabled: bankEnabled },
      { el: payCcPill, name: 'cc', enabled: ccEnabled }
    ];

    pills.forEach(p => {
      if (p.el) {
        p.el.classList.remove('active');
      }
      const content = document.getElementById(`method-${p.name}-content`);
      if (content) content.classList.add('hidden');
    });

    const firstActive = pills.find(p => p.enabled);
    if (firstActive) {
      if (firstActive.el) firstActive.el.classList.add('active');
      const content = document.getElementById(`method-${firstActive.name}-content`);
      if (content) content.classList.remove('hidden');
    }


    // Success Screen values pre-population
    successDomain.innerText = fullDomain;
    successYears.innerText = `${checkoutData.years} Tahun`;

    if (checkoutData.ns && checkoutData.ns.length >= 2) {
      if (successNsDisplay) {
        successNsDisplay.innerText = `${checkoutData.ns[0]} & ${checkoutData.ns[1]}`;
      }
    } else {
      // Fetch default nameservers dynamically
      try {
        apiFetch('/api/domains/reseller', { requireAuth: false }).then(res => {
          if (res.success && res.data && res.data.nameservers) {
            const ns = res.data.nameservers;
            if (successNsDisplay && ns.length >= 2) {
              successNsDisplay.innerText = `${ns[0]} & ${ns[1]}`;
            }
          } else {
            if (successNsDisplay) successNsDisplay.innerText = 'ns1.ruangtunggu.id & ns2.ruangtunggu.id';
          }
        }).catch(() => {
          if (successNsDisplay) successNsDisplay.innerText = 'ns1.ruangtunggu.id & ns2.ruangtunggu.id';
        });
      } catch (e) {
        console.warn('Failed to load reseller profile:', e);
        if (successNsDisplay) successNsDisplay.innerText = 'ns1.ruangtunggu.id & ns2.ruangtunggu.id';
      }
    }
  }

  // Handle payment method switching
  const methodPills = document.querySelectorAll('.payment-method-pill');
  const detailsBoxes = document.querySelectorAll('.payment-details-box');

  methodPills.forEach(pill => {
    pill.addEventListener('click', (e) => {
      methodPills.forEach(p => p.classList.remove('active'));
      detailsBoxes.forEach(box => box.classList.add('hidden'));

      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');

      const method = target.getAttribute('data-method');
      const contentBox = document.getElementById(`method-${method}-content`);
      if (contentBox) contentBox.classList.remove('hidden');
    });
  });

  // Copy VA function
  const copyVaBtn = document.getElementById('copy-va-btn');
  copyVaBtn?.addEventListener('click', () => {
    const vaNum = document.getElementById('va-number')?.innerText || '';
    navigator.clipboard.writeText(vaNum).then(() => {
      copyVaBtn.innerText = 'Tersalin!';
      setTimeout(() => {
        copyVaBtn.innerText = 'Salin VA';
      }, 2000);
    });
  });

  // Trigger registration API
  async function performRegistration() {
    if (!checkoutData) return;

    checkoutState.classList.add('hidden');
    errorState.classList.add('hidden');
    processingState.classList.remove('hidden');

    const payload = {
      domainName: checkoutData.domainName,
      domainExtension: checkoutData.domainExtension,
      years: checkoutData.years,
      ns: checkoutData.ns
    };

    try {
      const response = await apiFetch('/api/domains/register', {
        method: 'POST',
        body: JSON.stringify(payload)
      });

      // Clear pending item on success
      sessionStorage.removeItem('pending_domain_checkout');
      
      processingState.classList.add('hidden');
      successState.classList.remove('hidden');

    } catch (err: any) {
      console.error('Registration API failed:', err);
      processingState.classList.add('hidden');
      
      errorMsgDisplay.innerHTML = `
        Pembayaran berhasil diproses, namun pendaftaran domain ditolak oleh registry global.<br>
        <span style="display:block; margin-top:12px; padding:10px 14px; background:rgba(239,68,68,0.06); border:1px solid rgba(239,68,68,0.15); border-radius:6px; font-family:monospace; font-size:12px; color:#dc2626;">
          Detail Error: ${err.message || 'Registrar connection timed out.'}
        </span>
      `;
      errorState.classList.remove('hidden');
    }
  }

  payConfirmBtn.addEventListener('click', performRegistration);
  errorRetryBtn.addEventListener('click', performRegistration);

  // Initialize
  loadCheckoutData();
</script>

<style>
  .payment-method-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 14px 10px;
    cursor: pointer;
    background: var(--bg-primary);
    transition: all 0.2s ease;
    text-align: center;
  }
  .payment-method-pill:hover {
    border-color: var(--border-focus);
    background: var(--bg-secondary);
  }
  .payment-method-pill.active {
    border-color: var(--accent-primary);
    background: var(--accent-light);
    box-shadow: 0 0 10px rgba(79, 70, 229, 0.08);
  }
  .payment-method-pill.active span {
    color: var(--accent-primary);
  }

  .payment-details-box {
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 20px;
    background: var(--bg-primary);
    animation: fadeIn 0.25s ease-out;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    animation: pulseGlow 1.5s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0% { transform: scale(0.9); opacity: 0.5; }
    50% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.5; }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
