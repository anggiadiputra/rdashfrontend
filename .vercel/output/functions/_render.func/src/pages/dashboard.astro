---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Dashboard" activeMenu="dashboard">
  <div id="private-area" class="hidden">

    <!-- Welcome Header -->
    <div class="welcome-header">
      <div class="welcome-text">
        <h1 class="page-title">Selamat Datang, <span id="user-firstname">—</span>! 👋</h1>
        <p class="page-subtitle">Kelola domain dan layanan Anda dari satu tempat.</p>
      </div>
    </div>

    <!-- Quick Action Cards -->
    <div class="quick-actions">
      <a href="/dashboard/domains" class="action-card">
        <div class="action-icon icon-blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Domains Saya</div>
          <div class="action-desc">Lihat dan kelola semua domain terdaftar</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/" class="action-card">
        <div class="action-icon icon-green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Daftar Domain Baru</div>
          <div class="action-desc">Temukan dan daftarkan nama domain impian Anda</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/dashboard/whois" class="action-card">
        <div class="action-icon icon-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Cek WHOIS Domain</div>
          <div class="action-desc">Temukan informasi kepemilikan domain secara instan</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/dashboard/prices" class="action-card">
        <div class="action-icon icon-orange">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Daftar Harga</div>
          <div class="action-desc">Cek harga registrasi, perpanjangan, dan transfer domain</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/domains/transfer" class="action-card">
        <div class="action-icon icon-teal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H9a4 4 0 0 0-4 4v9"/><path d="m8 21-4-4 4-4"/><path d="M4 17h11a4 4 0 0 0 4-4V4"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Transfer Domain</div>
          <div class="action-desc">Pindahkan domain Anda ke Ruangtunggu</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>

      <a href="/profile" class="action-card">
        <div class="action-icon icon-gray">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="action-body">
          <div class="action-title">Profil Saya</div>
          <div class="action-desc">Perbarui informasi akun dan data pribadi Anda</div>
        </div>
        <svg class="action-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

  </div>

  <script>
    import { requireLogin, getUser } from '../utils/auth';
    requireLogin();

    const privateArea = document.getElementById('private-area') as HTMLDivElement;
    const firstnameEl = document.getElementById('user-firstname') as HTMLSpanElement;

    const user = getUser();
    if (user && firstnameEl) {
      // Show just first name
      firstnameEl.textContent = user.name.split(' ')[0] || user.name;
    }

    privateArea.classList.remove('hidden');
  </script>

  <style>
    .welcome-header {
      margin-bottom: 28px;
    }

    .welcome-text .page-title {
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
    }

    .welcome-text .page-subtitle {
      font-size: 13px;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    /* Quick Action Grid */
    .quick-actions {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 14px;
    }

    .action-card {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 18px;
      text-decoration: none;
      color: var(--text);
      transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
      cursor: pointer;
    }

    .action-card:hover {
      border-color: var(--accent);
      box-shadow: 0 4px 16px rgba(37, 99, 235, 0.08);
      transform: translateY(-1px);
    }

    .action-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .action-icon svg {
      width: 18px;
      height: 18px;
    }

    .icon-blue { background: rgba(37, 99, 235, 0.1); color: #2563eb; }
    .icon-blue svg { stroke: #2563eb; }

    .icon-green { background: rgba(22, 163, 74, 0.1); color: #16a34a; }
    .icon-green svg { stroke: #16a34a; }

    .icon-purple { background: rgba(147, 51, 234, 0.1); color: #9333ea; }
    .icon-purple svg { stroke: #9333ea; }

    .icon-orange { background: rgba(234, 88, 12, 0.1); color: #ea580c; }
    .icon-orange svg { stroke: #ea580c; }

    .icon-teal { background: rgba(13, 148, 136, 0.1); color: #0d9488; }
    .icon-teal svg { stroke: #0d9488; }

    .icon-gray { background: rgba(107, 114, 128, 0.1); color: #6b7280; }
    .icon-gray svg { stroke: #6b7280; }

    .action-body {
      flex: 1;
      min-width: 0;
    }

    .action-title {
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }

    .action-desc {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 2px;
      line-height: 1.4;
    }

    .action-arrow {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      stroke: var(--text-muted);
      transition: stroke 0.15s, transform 0.15s;
    }

    .action-card:hover .action-arrow {
      stroke: var(--accent);
      transform: translateX(2px);
    }

    .hidden { display: none !important; }
  </style>
</DashboardLayout>
