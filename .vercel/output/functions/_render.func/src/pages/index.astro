---
import Layout from '../layouts/Layout.astro';
import { HeroSplineBackground } from '../components/ui/3d-hero-section-boxes';
---

<Layout title="Cari & Daftarkan Domain Anda">
  <!-- 1. Hero Search Section with 3D Spline Background -->
  <section class="hero-section text-center relative overflow-hidden">
    <!-- 3D Canvas Background Container -->
    <div class="absolute inset-0 z-0 pointer-events-auto w-full h-full">
      <HeroSplineBackground client:only="react" />
    </div>

    <div class="container hero-container relative z-10">
      <span class="hero-badge">Pencari Domain Tercepat</span>
      <h1 class="hero-title">Temukan Nama Domain Impian Anda Sekarang</h1>
      <p class="hero-subtitle">
        Cari ketersediaan ekstensi domain internasional dan lokal dengan integrasi langsung, aman, dan harga transparan.
      </p>

      <!-- Search Input Container -->
      <form id="search-form" class="search-box card">
        <div class="search-input-wrapper">
          <input
            type="text"
            id="domain-input"
            class="form-control search-input"
            placeholder="Ketikkan nama domain pilihan Anda (misal: bisnissaya)..."
            required
            autocomplete="off"
            autofocus
          />
          <button type="submit" id="search-btn" class="btn btn-primary btn-search">
            Cari Ketersediaan
          </button>
        </div>
      </form>

      <!-- Results Showcase Grid (Dynamically updated by JS) -->
      <div id="search-results-section" class="search-results-section hidden mt-4 text-left" style="width: 100%; max-width: 700px; padding: 24px !important; border-radius: 12px; border: 1px solid rgba(55,65,81,0.3); background: rgba(17, 24, 39, 0.95); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 12px;">
          <h3 class="results-heading" style="font-size: 15px; font-weight: 700; margin: 0; color: #ffffff;">Hasil Pencarian: <span id="target-query" class="text-accent" style="font-family: monospace;"></span></h3>
          
          <!-- Live Search Filter for Results -->
          <div style="position: relative; display: flex; align-items: center; width: 200px; max-width: 100%;">
            <svg class="lucide lucide-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 13px; height: 13px; position: absolute; left: 10px; color: #9ca3af; pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="homepage-results-filter" class="form-control-compact" placeholder="Saring ekstensi..." style="padding-left: 28px; height: 30px; font-size: 11.5px; width: 100%; border-radius: 6px; background: rgba(31, 41, 55, 0.8); border: 1px solid rgba(75, 85, 99, 0.5); color: #ffffff;" />
          </div>
        </div>

        <div id="results-container" class="scroll-styled" style="display: flex; flex-direction: column; gap: 6px; max-height: 380px; overflow-y: auto; padding-right: 4px;">
          <!-- Dynamic cards go here -->
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Check Pricing Banner Section -->
  <section class="pricing-banner-section section" style="background-color: var(--bg-secondary); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); padding: 4.5rem 0;">
    <div class="container text-center">
      <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 12px;">🏷️ Cek Daftar Harga Lengkap Realtime</h2>
      <p class="text-secondary" style="max-width: 600px; margin: 0 auto 24px; font-size: 15px; line-height: 1.6;">
        Lihat harga registrasi, renewal, dan transfer lengkap untuk semua ekstensi domain (.id, .com, .net, dll.) yang diperbarui langsung dari registrar.
      </p>
      <a href="/prices" class="btn btn-primary" style="font-weight: 600; padding: 0.65rem 1.75rem;">
        Lihat Daftar Harga
      </a>
    </div>
  </section>

  <!-- 3. Why Choose Us (Solid Cards Showcase) -->
  <section class="features-section section">
    <div class="container">
      <div class="section-header text-center mb-4">
        <h2>Mengapa Memilih Ruangtunggu?</h2>
        <p class="text-secondary mt-2">Fitur terlengkap untuk kontrol penuh atas nama domain Anda.</p>
      </div>

      <div class="features-grid">
        <div class="card feature-card">
          <div class="feature-icon icon-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </div>
          <h3>Portal Mandiri (Self-Service)</h3>
          <p class="text-secondary">Ubah Nameserver, aktifkan Registrar Lock, dan kelola WHOIS secara mandiri kapan saja tanpa perlu bantuan admin.</p>
        </div>
        <div class="card feature-card">
          <div class="feature-icon icon-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 9.7a1 1 0 0 1-.68 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 .76-.97l8-2a1 1 0 0 1 .48 0l8 2A1 1 0 0 1 20 6z"/></svg>
          </div>
          <h3>Keamanan Maksimal (OTP & Turnstile)</h3>
          <p class="text-secondary">Sistem autentikasi berlapis wajib OTP via email dan perlindungan bot Turnstile untuk menangkal segala upaya peretasan.</p>
        </div>
        <div class="card feature-card">
          <div class="feature-icon icon-crimson">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3>Performa Ultra Cepat</h3>
          <p class="text-secondary">Dibangun menggunakan kerangka kerja Astro v5 modern untuk navigasi instan dan performa visual yang premium.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side script to handle API Integration -->
  <script>
    import { apiFetch } from '../utils/api';

    const searchForm = document.getElementById('search-form') as HTMLFormElement;
    const domainInput = document.getElementById('domain-input') as HTMLInputElement;
    const searchBtn = document.getElementById('search-btn') as HTMLButtonElement;
    const resultsSection = document.getElementById('search-results-section') as HTMLDivElement;
    const targetQuery = document.getElementById('target-query') as HTMLSpanElement;
    const resultsContainer = document.getElementById('results-container') as HTMLDivElement;
    const resultsFilterInput = document.getElementById('homepage-results-filter') as HTMLInputElement;

    let pricesCache: any[] = [];
    let extensionsCache: string[] = ['.com', '.net', '.org', '.id', '.co.id', '.web.id', '.my.id', '.xyz'];
    
    async function loadExtensions() {
      try {
        const res = await apiFetch('/api/domains/prices', { requireAuth: false });
        if (res.success && Array.isArray(res.data) && res.data.length > 0) {
          pricesCache = res.data;
          extensionsCache = res.data.map((p: any) => p.extension);
        }
      } catch (err) {
        console.warn('Failed to load extensions for homepage search:', err);
      }
    }
    loadExtensions();


    // 2. Handle domain check submit
    searchForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (resultsFilterInput) {
        resultsFilterInput.value = '';
      }

      const query = domainInput.value.trim().toLowerCase();
      if (!query) return;

      const cleanName = query.split('.')[0];
      if (cleanName.length < 3) {
        alert('Nama domain minimal terdiri dari 3 karakter.');
        return;
      }
      
      // Update UI state to loading
      searchBtn.disabled = true;
      searchBtn.innerText = 'Mengecek...';
      resultsSection.classList.add('hidden');
      
      try {
        // Show loading skeleton rows
        targetQuery.innerText = cleanName;
        resultsContainer.innerHTML = '';
        resultsSection.classList.remove('hidden');

        extensionsCache.forEach(ext => {
          const skeletonDiv = document.createElement('div');
          skeletonDiv.style.cssText = 'display:flex; align-items:center; justify-content:space-between; padding:8px 16px; border:1px solid rgba(75, 85, 99, 0.3); border-radius:8px; background: rgba(31, 41, 55, 0.3); gap: 8px; min-height: 48px;';
          skeletonDiv.innerHTML = `
            <div style="display:flex; align-items:center; gap:12px; width:70%;">
              <div style="height:12px; border-radius:4px; background:rgba(75, 85, 99, 0.5); width:120px; animation: pulse 1.5s ease-in-out infinite;"></div>
              <div style="height:10px; border-radius:4px; background:rgba(75, 85, 99, 0.3); width:80px; animation: pulse 1.5s ease-in-out infinite;"></div>
            </div>
            <div style="height:28px; width:80px; border-radius:4px; background:rgba(75, 85, 99, 0.5); animation: pulse 1.5s ease-in-out infinite;"></div>
          `;
          resultsContainer.appendChild(skeletonDiv);
        });

        // Query all extensions
        const tlds = extensionsCache.join(',');
        const response = await apiFetch(`/api/domains/availability?domainName=${encodeURIComponent(cleanName)}&extensions=${encodeURIComponent(tlds)}`, { requireAuth: false });
        
        resultsContainer.innerHTML = '';

        if (response.success && response.data && response.data.length > 0) {
          // Sort results: if item.domain equals query (e.g. potongqurban.com), put it first
          const sortedData = [...response.data].sort((a, b) => {
            const aIsExact = a.domain.toLowerCase() === query.toLowerCase();
            const bIsExact = b.domain.toLowerCase() === query.toLowerCase();
            if (aIsExact && !bIsExact) return -1;
            if (!aIsExact && bIsExact) return 1;
            return 0;
          });

          sortedData.forEach((item: any) => {
            const isExactMatch = item.domain.toLowerCase() === query.toLowerCase();
            renderHomepageResultRow(item, isExactMatch);
          });
        } else {
          showMockResults(cleanName, query);
        }
      } catch (error) {
        console.error('Failed to perform real domain search, using mock fallback:', error);
        showMockResults(cleanName, query);
      } finally {
        searchBtn.disabled = false;
        searchBtn.innerText = 'Cari Ketersediaan';
      }
    });

    function renderHomepageResultRow(item: any, isExactMatch: boolean = false) {
      const domain = item.domain;
      const isAvailable = item.status === 'available';
      const isPremium = !!item.is_premium;

      const card = document.createElement('div');
      card.setAttribute('data-domain-row', domain.toLowerCase());
      card.className = 'flex items-center justify-between flex-wrap gap-2';
      if (isExactMatch) {
        card.style.cssText = 'padding: 8px 16px; background-color: rgba(37, 99, 235, 0.12); border: 1.5px solid var(--accent-primary, #2563eb); border-radius: 8px; color: #ffffff; min-height: 48px; transition: all 0.15s ease; gap: 8px; box-shadow: 0 0 15px rgba(37, 99, 235, 0.2); width: 100%;';
      } else {
        card.style.cssText = 'padding: 8px 16px; background-color: rgba(31, 41, 55, 0.5); border: 1px solid rgba(75, 85, 99, 0.3); border-radius: 8px; color: #ffffff; min-height: 48px; transition: all 0.15s ease; gap: 8px; width: 100%;';
      }

      const textCol = document.createElement('div');
      textCol.style.cssText = 'display: flex; align-items: center; justify-content: space-between; flex: 1; flex-wrap: wrap; gap: 8px; min-width: 240px;';
      
      const firstDot = domain.indexOf('.');
      const ext = firstDot !== -1 ? domain.substring(firstDot) : '';
      
      const pricingObj = pricesCache.find(p => p.extension === ext);
      const registerPrice1yr = pricingObj?.registerPrice || 0;
      const regularPrice1yr = pricingObj?.regularRegisterPrice || 0;
      const isPromo = !!(pricingObj?.promo);

      let priceHtml = '';
      if (isPremium && item.premium_price > 0) {
        priceHtml = `<span style="font-size: 11.5px; font-weight: 700; color: #facc15;">Rp ${item.premium_price.toLocaleString('id-ID')}/thn</span>`;
      } else if (registerPrice1yr > 0) {
        if (isPromo && regularPrice1yr > 0 && registerPrice1yr < regularPrice1yr) {
          priceHtml = `<span style="text-decoration:line-through; color:#9ca3af; font-size:10.5px; margin-right:4px;">Rp ${regularPrice1yr.toLocaleString('id-ID')}</span><span style="color:#f87171; font-weight:700; font-size:11.5px;">Rp ${registerPrice1yr.toLocaleString('id-ID')}/thn</span>`;
        } else {
          priceHtml = `<span style="font-size: 11.5px; font-weight: 600; color: #9ca3af;">Rp ${registerPrice1yr.toLocaleString('id-ID')}/thn</span>`;
        }
      }

      let promoBadge = '';
      if (isPremium) {
        promoBadge = `<span style="background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.4); font-size: 9px; font-weight: 800; padding: 1.5px 6px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px;">PREMIUM</span>`;
      } else if (isPromo && regularPrice1yr > 0 && registerPrice1yr < regularPrice1yr) {
        promoBadge = `<span style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 9px; font-weight: 700; padding: 1px 5px; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.5px;">PROMO</span>`;
      }

      let exactBadge = isExactMatch 
        ? `<span style="background: var(--accent-primary, #2563eb); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.25); font-size: 8.5px; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; margin-right: 4px;">Pilihan Anda</span>`
        : ``;

      textCol.innerHTML = `
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="result-name" style="font-family: monospace; font-weight: 700; font-size: 13.5px; color: #ffffff;">${domain}</span>
          ${exactBadge}
          ${promoBadge}
        </div>
        <div style="display: flex; align-items: center; font-size: 12px; font-weight: 600; color: ${isAvailable ? '#10b981' : '#9ca3af'}; flex-wrap: wrap;">
          ${isAvailable 
            ? `<svg class="lucide lucide-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px; flex-shrink:0; color: #10b981;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
               <span style="color:#10b981; font-weight: 700; margin-right: 4px;">Tersedia</span>` 
            : `<svg class="lucide lucide-x-circle" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px; flex-shrink:0; color: #9ca3af;"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
               <span style="color:#9ca3af; margin-right: 4px;">Terdaftar</span>`
          }
          ${priceHtml ? `<span style="font-weight:500; padding-left:8px; border-left:1px solid rgba(255,255,255,0.15); display:inline-flex; align-items:center; gap:4px; margin-left:4px;">${priceHtml}</span>` : ''}
        </div>
      `;

      const actionCol = document.createElement('div');
      actionCol.style.cssText = 'flex-shrink: 0;';
      
      if (isAvailable) {
        const targetUrl = `/checkout?domain=${encodeURIComponent(domain)}${isPremium ? '&is_premium=true' : ''}`;
        actionCol.innerHTML = `<a href="${targetUrl}" class="btn btn-primary btn-sm-custom" style="height: 28px; padding: 0 12px; font-size: 11.5px; border-radius: 4px; font-weight: 600; line-height: 1; display: inline-flex; align-items: center; background: var(--accent-primary); border: none; color: #ffffff;">Daftarkan</a>`;
      } else {
        actionCol.innerHTML = `<a href="/whois?domain=${encodeURIComponent(domain)}" class="btn btn-secondary btn-sm-custom" target="_blank" style="height: 28px; padding: 0 12px; font-size: 11.5px; border-radius: 4px; font-weight: 600; line-height: 1; display: inline-flex; align-items: center; background: rgba(55, 65, 81, 0.5); border-color: rgba(75, 85, 99, 0.4); color: #9ca3af;">WHOIS</a>`;
      }

      card.appendChild(textCol);
      card.appendChild(actionCol);

      // Hover effect
      card.addEventListener('mouseenter', () => {
        card.style.borderColor = 'var(--accent-primary)';
        card.style.transform = 'translateY(-1px)';
      });
      card.addEventListener('mouseleave', () => {
        card.style.borderColor = isExactMatch ? 'var(--accent-primary, #2563eb)' : 'rgba(75, 85, 99, 0.3)';
        card.style.transform = 'translateY(0)';
      });

      resultsContainer.appendChild(card);
    }

    function showMockResults(name: string, query: string) {
      resultsContainer.innerHTML = '';
      const mockTLDs = [
        { tld: '.com', available: true },
        { tld: '.net', available: false },
        { tld: '.id', available: true },
        { tld: '.co.id', available: true },
      ];

      const sortedMock = [...mockTLDs].sort((a, b) => {
        const aIsExact = (name + a.tld).toLowerCase() === query.toLowerCase();
        const bIsExact = (name + b.tld).toLowerCase() === query.toLowerCase();
        if (aIsExact && !bIsExact) return -1;
        if (!aIsExact && bIsExact) return 1;
        return 0;
      });

      sortedMock.forEach((item) => {
        const domain = name + item.tld;
        const isExactMatch = domain.toLowerCase() === query.toLowerCase();
        renderHomepageResultRow(domain, item.available, isExactMatch);
      });
    }

    // Results live filtering handler
    resultsFilterInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim().toLowerCase();
      const rows = resultsContainer.querySelectorAll('[data-domain-row]');
      rows.forEach(row => {
        const dom = (row as HTMLElement).dataset.domainRow || '';
        if (dom.includes(val)) {
          (row as HTMLElement).style.display = 'flex';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });


  </script>

  <style>
    /* Hero Section Styling */
    .hero-section {
      position: relative;
      height: 100vh;
      min-height: 650px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background-color: #070913;
      border-bottom: 1px solid var(--border-color);
      padding: 0;
    }

    .hero-container {
      max-width: 800px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      z-index: 10;
      pointer-events: none;
    }

    .hero-badge, .search-box, .search-results-section {
      pointer-events: auto;
    }

    .hero-badge {
      display: inline-block;
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-primary);
      background-color: rgba(37, 99, 235, 0.15);
      padding: 0.35rem 1rem;
      border-radius: 50px;
      border: 1px solid rgba(37, 99, 235, 0.3);
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-size: 3rem;
      line-height: 1.15;
      letter-spacing: -1px;
      margin-bottom: 1.25rem;
      color: #ffffff;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    }

    @media (max-width: 768px) {
      .hero-title {
        font-size: 2.25rem;
      }
    }

    .hero-subtitle {
      font-size: 1.15rem;
      max-width: 600px;
      margin-bottom: 3rem;
      color: #9ca3af;
      text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
    }

    /* Search Box */
    .search-box {
      width: 100%;
      max-width: 700px;
      padding: 1.25rem;
      background-color: rgba(17, 24, 39, 0.85);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(55, 65, 81, 0.8);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .search-input-wrapper {
      display: flex;
      gap: 0.75rem;
    }

    @media (max-width: 640px) {
      .search-input-wrapper {
        flex-direction: column;
      }
    }

    .search-input {
      flex: 1;
      height: 3.25rem;
      font-size: 1.05rem;
    }

    .btn-search {
      height: 3.25rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }

    /* Results showcase grid */
    .search-results-section {
      width: 100%;
      max-width: 700px;
      text-align: left;
      background-color: rgba(17, 24, 39, 0.95);
      border: 1px solid rgba(55, 65, 81, 0.8);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      margin-top: 1.5rem;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
    }

    .results-heading {
      font-size: 1.25rem;
      font-weight: 600;
      color: #ffffff;
    }

    .text-accent {
      color: var(--accent-primary);
      font-weight: 700;
    }

    .results-grid {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .result-card {
      padding: 1.25rem 1.75rem !important;
      background-color: rgba(31, 41, 55, 0.75) !important;
      border-color: rgba(75, 85, 99, 0.6) !important;
      color: #ffffff !important;
    }

    .result-details {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .result-name {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 1.1rem;
    }

    .btn-sm-custom {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      border-radius: var(--radius-sm);
    }

    /* Table custom classes */
    .placeholder-row {
      height: 100px;
    }

    /* Features Grid */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-top: 3rem;
    }

    @media (max-width: 900px) {
      .features-grid {
        grid-template-columns: 1fr;
      }
    }

    .feature-card {
      text-align: left;
      padding: 2.5rem 2rem !important;
    }

    .feature-icon {
      margin-bottom: 1.25rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      width: 48px;
      height: 48px;
      border-radius: 8px;
    }

    .feature-icon svg {
      width: 28px;
      height: 28px;
      stroke-width: 1.75;
    }

    /* Color variations matching the branding */
    .icon-blue {
      background-color: var(--accent-light);
      color: var(--accent-primary);
    }
    .icon-emerald {
      background-color: var(--success-bg);
      color: var(--success);
    }
    .icon-crimson {
      background-color: var(--error-bg);
