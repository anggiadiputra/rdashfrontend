{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/billing/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/customers/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/domains/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/pricing/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/transactions/?$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/domains/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/prices/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/whois/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/domains/payment/?$",
			"dest": "_render"
		},
		{
			"src": "^/domains/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/domains/transfer/?$",
			"dest": "_render"
		},
		{
			"src": "^/domains/([^/]+?)(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/domains/?$",
			"dest": "_render"
		},
		{
			"src": "^/forgot-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/prices/?$",
			"dest": "_render"
		},
		{
			"src": "^/profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/verify-email/?$",
			"dest": "_render"
		},
		{
			"src": "^/whois/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}